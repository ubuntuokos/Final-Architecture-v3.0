{
  "manifest_version": 3,
  "name": "FA3 Browser Session Bridge",
  "version": "1.0.0",
  "description": "FA3-native existing-profile browser session bridge. No model, policy, secret, or resource authority.",
  "key": "",
  "permissions": ["nativeMessaging","tabs","windows","scripting"],
  "host_permissions": ["http://127.0.0.1/*","http://localhost/*"],
  "optional_host_permissions": ["https://*/*","http://*/*"],
  "background": {"service_worker": "service_worker.js"}
}
