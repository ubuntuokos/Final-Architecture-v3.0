[Unit]
Description=FA3 PR Watch (opt-in, scoped Secret Broker credential projection)
Requires=fa3-secrets.target
After=fa3-secrets.target
PartOf=fa3-secrets.target

[Service]
Type=simple
User=fa3-pr-watch
Group=fa3-secret-clients
ExecStart=/usr/local/libexec/fa3-pr-watch-secret-runtime --secret-ref integration/relay/001 --bind 127.0.0.1 --port 0
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# Runtime/service identity, policy, proxy and certificate must be explicitly admitted.
# Never install/start this template automatically or expose its loopback port.

[Install]
WantedBy=fa3-secrets.target
