[Unit]
Description=FA3 PageIndex Local Model Router Projection

[Service]
Type=simple
ExecStart=@SYSTEM_PYTHON@ @ROUTER_SCRIPT@ --host 127.0.0.1 --port 18791 --upstream http://127.0.0.1:11434
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
