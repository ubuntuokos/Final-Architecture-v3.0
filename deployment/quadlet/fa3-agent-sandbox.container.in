# FA3 reference template for the installed untrusted-agent sandbox Quadlet.
# Non-runnable until @FA3_IMAGE_DIGEST@ is replaced by an admitted immutable image
# reference pinned as registry/repository@sha256:<64 hex>.

[Unit]
Description=FA3 untrusted agent gVisor sandbox

[Container]
Image=@FA3_IMAGE_DIGEST@
ContainerName=fa3-agent-sandbox
Network=none
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
Pull=never
GlobalArgs=--runtime=runsc
UserNS=keep-id

[Service]
Restart=no

[Install]
WantedBy=default.target
