# Copy to /etc/fa3/triton.env only after canonical admission.
# Production image MUST include a real sha256 digest; a tag alone is denied.
FA3_TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.08-py3@sha256:REPLACE_WITH_ADMITTED_DIGEST

# PASS receipt from the existing FA3 supply-chain admission authority.
# It must bind exactly to FA3_TRITON_IMAGE.
FA3_TRITON_IMAGE_ADMISSION_RECEIPT=/var/lib/fa3/security/receipts/triton-image-admission.json

# PASS compatibility receipt binding Triton + selected backend + exact HRB device scope.
FA3_TRITON_BACKEND_COMPAT_RECEIPT=/var/lib/fa3/inference/receipts/triton-backend-compatibility.json

# Comma-separated GPU UUIDs from an active Host Resource Broker lease.
FA3_TRITON_GPU_UUIDS=GPU-REPLACE_WITH_HRB_GRANTED_UUID
FA3_TRITON_HRB_RECEIPT=/var/lib/fa3/hrb/leases/triton.json
FA3_TRITON_PLACEMENT_RECEIPT=/var/lib/fa3/model-manager/receipts/triton-placement.json

# Read-only runtime projection produced from admitted canonical model state.
FA3_TRITON_MODEL_REPOSITORY=/var/lib/fa3/model-projections/triton

# Hardened default. Use explicit only with Model Manager authorization.
FA3_TRITON_MODEL_CONTROL_MODE=none
FA3_TRITON_EXPLICIT_MODEL_CONTROL_AUTHORIZED=0
FA3_TRITON_SHM_SIZE=2g
