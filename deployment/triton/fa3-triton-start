#!/usr/bin/env bash
set -euo pipefail

: "${FA3_TRITON_IMAGE:?digest-pinned FA3_TRITON_IMAGE is required}"
: "${FA3_TRITON_GPU_UUIDS:?HRB-granted GPU UUID list is required}"
: "${FA3_TRITON_MODEL_REPOSITORY:?admitted model projection is required}"
: "${FA3_TRITON_HRB_RECEIPT:?HRB receipt path is required}"
: "${FA3_TRITON_PLACEMENT_RECEIPT:?placement receipt path is required}"

MODE="${FA3_TRITON_MODEL_CONTROL_MODE:-none}"
SHM_SIZE="${FA3_TRITON_SHM_SIZE:-2g}"

[[ "$FA3_TRITON_IMAGE" =~ ^nvcr\.io/nvidia/tritonserver:26\.08-py3@sha256:[0-9a-f]{64}$ ]] || {
  echo "DENY: Triton image must be 26.08-py3 pinned by sha256 digest" >&2; exit 41;
}
[[ "$FA3_TRITON_IMAGE" != *":latest"* ]] || { echo "DENY: latest is forbidden" >&2; exit 42; }
[[ "$MODE" == "none" || "$MODE" == "explicit" ]] || { echo "DENY: only none or explicit model control is allowed" >&2; exit 43; }
if [[ "$MODE" == "explicit" && "${FA3_TRITON_EXPLICIT_MODEL_CONTROL_AUTHORIZED:-0}" != "1" ]]; then
  echo "DENY: explicit model control requires Model Manager authorization" >&2; exit 44
fi
[[ -d "$FA3_TRITON_MODEL_REPOSITORY" ]] || { echo "DENY: model projection missing" >&2; exit 45; }
[[ -r "$FA3_TRITON_HRB_RECEIPT" ]] || { echo "DENY: HRB receipt missing" >&2; exit 46; }
[[ -r "$FA3_TRITON_PLACEMENT_RECEIPT" ]] || { echo "DENY: placement receipt missing" >&2; exit 47; }

jq -e '.result == "PASS"' "$FA3_TRITON_HRB_RECEIPT" >/dev/null || { echo "DENY: HRB receipt is not PASS" >&2; exit 48; }
jq -e '.result == "PASS" and .provider_id == "FA3-PROVIDER-TRITON-001"' "$FA3_TRITON_PLACEMENT_RECEIPT" >/dev/null || {
  echo "DENY: Triton placement receipt is not PASS" >&2; exit 49
}

IFS=',' read -r -a GPU_UUIDS <<< "$FA3_TRITON_GPU_UUIDS"
AVAILABLE="$(nvidia-smi --query-gpu=uuid --format=csv,noheader)"
for uuid in "${GPU_UUIDS[@]}"; do
  [[ "$uuid" =~ ^GPU-[A-Za-z0-9-]+$ ]] || { echo "DENY: invalid GPU UUID: $uuid" >&2; exit 50; }
  grep -Fxq "$uuid" <<< "$AVAILABLE" || { echo "DENY: HRB-granted GPU not present: $uuid" >&2; exit 51; }
done

exec /usr/bin/docker run --rm \
  --name fa3-triton \
  --gpus "device=${FA3_TRITON_GPU_UUIDS}" \
  --read-only \
  --cap-drop=ALL \
  --security-opt no-new-privileges:true \
  --pids-limit=1024 \
  --shm-size="$SHM_SIZE" \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=1g \
  -p 127.0.0.1:8000:8000 \
  -p 127.0.0.1:8001:8001 \
  -p 127.0.0.1:8002:8002 \
  -v "${FA3_TRITON_MODEL_REPOSITORY}:/models:ro" \
  "$FA3_TRITON_IMAGE" \
  tritonserver \
    --model-repository=/models \
    --model-control-mode="$MODE" \
    --disable-auto-complete-config \
    --strict-readiness=true \
    --exit-on-error=true \
    --allow-metrics=true \
    --allow-gpu-metrics=true \
    --allow-cpu-metrics=true
