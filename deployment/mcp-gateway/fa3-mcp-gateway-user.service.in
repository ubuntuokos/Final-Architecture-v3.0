[Unit]
Description=FA3 Central MCP Gateway - FA3 OS Agent Exposure
After=default.target

[Service]
Type=simple
WorkingDirectory=@RUNTIME_ROOT@
Environment="FA3_MCP_GATEWAY_UNIX_SOCKET=%t/fa3/mcp-gateway.sock"
Environment="FA3_MCP_CAPABILITY_REGISTRY=@RUNTIME_ROOT@/canonical/mcp-capability-registry.json"
Environment="FA3_MCP_ADAPTER_FACTORIES=fa3_os_mcp_adapter:create_adapters"
Environment="FA3_MCP_POLICY_RESOLVER=fa3_security_policy_plane:resolve_policy"
ExecStart=/usr/bin/env bash @RUNTIME_ROOT@/bin/fa3-mcp-gateway
Restart=on-failure
RestartSec=2
RuntimeDirectory=fa3
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@RUNTIME_ROOT@
ReadWritePaths=@JOURNAL_DIR@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
