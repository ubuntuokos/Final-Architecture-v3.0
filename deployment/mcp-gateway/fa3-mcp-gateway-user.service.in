[Unit]
Description=FA3 Central MCP Gateway - FA3 OS Agent Exposure
After=default.target

[Service]
Type=simple
WorkingDirectory=@RUNTIME_ROOT@
Environment=@ENV_SOCKET@
Environment=@ENV_REGISTRY@
Environment=@ENV_FACTORIES@
Environment=@ENV_POLICY@
ExecStart=/usr/bin/env bash @BIN_PATH@
Restart=on-failure
RestartSec=2
RuntimeDirectory=fa3
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@RUNTIME_ROOT@
ReadWritePaths=@JOURNAL_DIR@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
