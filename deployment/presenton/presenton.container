[Unit]
Description=FA3 Presenton optional presentation worker
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/presenton/presenton@sha256:e6866086f2dbdf9f6c50c8f217123cada2a84f4dd03131ad78f397d6fb11b3d1
ContainerName=fa3-presenton
PublishPort=127.0.0.1:5001:80
AddHost=host.containers.internal:host-gateway
Volume=%h/Dokumentumok/Presenton/app_data:/app_data:Z,rw
Volume=/ai-cache/presenton/tmp:/var/tmp/presenton:Z,rw
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--cpus=8 --memory=16g --memory-reservation=12g --pids-limit=2048

Environment=LLM=litellm
Environment=LITELLM_BASE_URL=http://host.containers.internal:4000/v1
Environment=LITELLM_MODEL=presentation-primary
Environment=IMAGE_PROVIDER=comfyui
Environment=COMFYUI_URL=http://host.containers.internal:9876
Environment=MIGRATE_DATABASE_ON_STARTUP=true
Environment=AUTH_USERNAME=horvathi
Environment=CAN_CHANGE_KEYS=false
Environment=DISABLE_ANONYMOUS_TRACKING=true
Environment=WEB_GROUNDING=false
Environment=START_OLLAMA=false
Environment=ENABLE_PARALLEL_IMAGE_GENERATION=false
Environment=LITEPARSE_NUM_WORKERS=4
Environment=MEM0_ENABLED=true
Environment=MEM0_DIR=/app_data/mem0
Environment=MEM0_LLM_BASE_URL=http://host.containers.internal:4000/v1
Environment=MEM0_LLM_MODEL=presentation-memory
Environment=MEM0_EMBEDDER_PROVIDER=fastembed
Environment=MEM0_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
Environment=MEM0_EMBEDDING_DIMS=384
Secret=presenton-database-url,type=env,target=DATABASE_URL
Secret=presenton-auth-password,type=env,target=AUTH_PASSWORD
Secret=presenton-litellm-api-key,type=env,target=LITELLM_API_KEY
Secret=presenton-mem0-litellm-api-key,type=env,target=MEM0_LLM_API_KEY
Secret=presenton-comfyui-workflow,type=env,target=COMFYUI_WORKFLOW

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=ai-creative.target
