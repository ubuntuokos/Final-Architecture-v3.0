presenton.localhost {
    bind 127.0.0.1

    request_body {
        max_size 64MB
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    reverse_proxy 127.0.0.1:5001 {
        transport http {
            dial_timeout 10s
            response_header_timeout 10m
        }
    }
}
