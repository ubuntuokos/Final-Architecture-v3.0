#!/usr/bin/env bash
set -euo pipefail

readonly lynxhub_binary=/opt/LynxHub/lynxhub

if [[ ! -x "$lynxhub_binary" ]]; then
  printf 'FA3 LynxHub: executable not found: %s\n' "$lynxhub_binary" >&2
  exit 66
fi

session_type=${XDG_SESSION_TYPE:-}
if [[ "$session_type" != "wayland" && "$session_type" != "x11" ]]; then
  printf 'FA3 LynxHub: an admitted Wayland or X11 desktop session is required.\n' >&2
  exit 77
fi

# The vendor desktop file disables Chromium sandboxing. The FA3 launcher
# deliberately omits that switch and relies on the package/user-namespace path.
exec "$lynxhub_binary" \
  --ozone-platform-hint=auto \
  --enable-features=WaylandWindowDecorations
