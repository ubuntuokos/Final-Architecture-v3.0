#!/usr/bin/env bash
set -euo pipefail

readonly expected_commit="51ad27fb86d39a3daca3adaa970375c9670c12df"
readonly expected_entry_blob="6126ef45ca881e30e7fceb134270dfb52d883b4b"
readonly expected_electron_lock_blob="de71cacfc097733f36d79f103bfd9fb2686778a6"
readonly expected_root_lock_blob="95b4dbc33c62829e2aff383f286889ebdcc15ffd"
readonly expected_root_npmrc_blob="2143f3df2fc935fce293d1ee5b3c073fd187e135"
readonly config_file="${FA3_SILLYTAVERN_KDE_CONFIG:-${HOME}/.config/fa3/sillytavern-kde.env}"

if [[ ! -r "$config_file" ]]; then
  printf 'FA3 SillyTavern KDE: missing config %s\n' "$config_file" >&2
  exit 64
fi
# shellcheck disable=SC1090
source "$config_file"
: "${SILLYTAVERN_ROOT:?Set SILLYTAVERN_ROOT in the FA3 config file}"

root=$(readlink -f -- "$SILLYTAVERN_ROOT")
[[ -d "$root/.git" ]] || { printf 'FA3 SillyTavern KDE: root is not a git checkout: %s\n' "$root" >&2; exit 65; }

actual_commit=$(git -C "$root" rev-parse HEAD)
[[ "$actual_commit" == "$expected_commit" ]] || {
  printf 'FA3 SillyTavern KDE: source pin mismatch; expected %s, got %s\n' "$expected_commit" "$actual_commit" >&2
  exit 65
}

entry_blob=$(git -C "$root" hash-object "$root/src/electron/index.js")
electron_lock_blob=$(git -C "$root" hash-object "$root/src/electron/package-lock.json")
root_lock_blob=$(git -C "$root" hash-object "$root/package-lock.json")
root_npmrc_blob=$(git -C "$root" hash-object "$root/.npmrc")
[[ "$entry_blob" == "$expected_entry_blob" \
   && "$electron_lock_blob" == "$expected_electron_lock_blob" \
   && "$root_lock_blob" == "$expected_root_lock_blob" \
   && "$root_npmrc_blob" == "$expected_root_npmrc_blob" ]] || {
  printf 'FA3 SillyTavern KDE: source or dependency policy drift detected.\n' >&2
  exit 65
}

[[ -r "$root/node_modules/express/package.json" ]] || {
  printf 'FA3 SillyTavern KDE: admitted server runtime dependencies are absent. Run the installer with --prepare-deps explicitly.\n' >&2
  exit 69
}

electron="$root/src/electron/node_modules/.bin/electron"
[[ -x "$electron" ]] || {
  printf 'FA3 SillyTavern KDE: admitted Electron dependencies are absent. Run the installer with --prepare-deps explicitly.\n' >&2
  exit 69
}

width="${FA3_SILLYTAVERN_WIDTH:-1440}"
height="${FA3_SILLYTAVERN_HEIGHT:-900}"
[[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || { printf 'FA3 SillyTavern KDE: invalid width/height.\n' >&2; exit 64; }

ozone_args=()
if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
  ozone_args=(--ozone-platform=wayland)
elif [[ "${FA3_SILLYTAVERN_ALLOW_XWAYLAND:-0}" != "1" ]]; then
  printf 'FA3 SillyTavern KDE: Wayland session required; set an explicit FA3_SILLYTAVERN_ALLOW_XWAYLAND=1 exception only when admitted.\n' >&2
  exit 69
else
  printf 'FA3 SillyTavern KDE: using explicitly admitted non-Wayland/XWayland compatibility exception.\n' >&2
fi

unset ELECTRON_RUN_AS_NODE
cd "$root/src/electron"
exec "$electron" . \
  "${ozone_args[@]}" \
  --width "$width" \
  --height "$height"
