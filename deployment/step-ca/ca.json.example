{
  "root": "/var/lib/fa3-step-ca/certs/root_ca.crt",
  "crt": "/var/lib/fa3-step-ca/certs/intermediate_ca.crt",
  "key": "/var/lib/fa3-step-ca/secrets/intermediate_ca_key",
  "address": "127.0.0.1:9443",
  "dnsNames": [
    "localhost",
    "127.0.0.1",
    "ca.fa3.internal"
  ],
  "logger": {
    "format": "json"
  },
  "db": {
    "type": "badgerv2",
    "dataSource": "/var/lib/fa3-step-ca/db"
  },
  "authority": {
    "claims": {
      "minTLSCertDuration": "5m",
      "defaultTLSCertDuration": "12h",
      "maxTLSCertDuration": "24h"
    },
    "provisioners": [
      {
        "type": "ACME",
        "name": "fa3-acme",
        "claims": {
          "minTLSCertDuration": "5m",
          "defaultTLSCertDuration": "12h",
          "maxTLSCertDuration": "24h"
        }
      }
    ]
  },
  "tls": {
    "minVersion": 1.2,
    "maxVersion": 1.3,
    "renegotiation": false
  },
  "ssh": {
    "hostKey": "/var/lib/fa3-step-ca/secrets/ssh_host_ca_key",
    "userKey": "/var/lib/fa3-step-ca/secrets/ssh_user_ca_key"
  }
}
