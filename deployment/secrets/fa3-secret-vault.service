[Unit]
Description=FA3 encrypted machine-state mapper
Before=run-fa3-machine\x2dstate.mount
PartOf=fa3-secrets.target
ConditionPathExists=/var/lib/fa3/state/fa3-machine-state.img

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
LoadCredentialEncrypted=fa3-machine-state-key:/etc/credstore.encrypted/fa3-machine-state-key.cred
ExecStart=/usr/local/libexec/fa3-secret-vault-mount open-mapper
ExecStop=/usr/local/libexec/fa3-secret-vault-mount close-mapper
ExecStopPost=/usr/local/libexec/fa3-secret-vault-mount assert-closed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
ReadWritePaths=/run
RestrictAddressFamilies=AF_UNIX
