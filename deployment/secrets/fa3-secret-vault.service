[Unit]
Description=FA3 encrypted machine-state vault
Before=fa3-secret-broker.service
PartOf=fa3-secrets.target
ConditionPathExists=/var/lib/fa3/state/fa3-machine-state.img

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
RuntimeDirectory=fa3
RuntimeDirectoryMode=0755
LoadCredentialEncrypted=fa3-machine-state-key:/etc/credstore.encrypted/fa3-machine-state-key.cred
ExecStart=/usr/local/libexec/fa3-secret-vault-mount open
ExecStop=/usr/local/libexec/fa3-secret-vault-mount close
ExecStopPost=/usr/local/libexec/fa3-secret-vault-mount assert-closed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER
AmbientCapabilities=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER
ReadWritePaths=/var/lib/fa3/state /run/fa3
RestrictAddressFamilies=AF_UNIX
