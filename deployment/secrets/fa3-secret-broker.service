[Unit]
Description=FA3 least-privilege secret delivery broker
Requires=run-fa3-machine\x2dstate.mount
After=run-fa3-machine\x2dstate.mount
PartOf=fa3-secrets.target

[Service]
Type=simple
User=fa3-secret-broker
Group=fa3-secret-broker
SupplementaryGroups=fa3-secret-clients
UMask=0077
RuntimeDirectory=fa3-secret-broker
RuntimeDirectoryMode=0750
ExecStartPre=/usr/local/libexec/fa3-secret-vault-mount assert-open
ExecStartPre=/bin/chgrp fa3-secret-clients /run/fa3-secret-broker
ExecStartPre=/bin/chmod 0750 /run/fa3-secret-broker
ExecStart=/usr/bin/python3 /usr/local/lib/fa3/fa3_secret_broker.py serve --vault-root /run/fa3/machine-state --policy-dir /etc/fa3/secret-policy.d --socket /run/fa3-secret-broker/broker.sock --audit-log /run/fa3-secret-broker/audit.jsonl
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/fa3/machine-state /run/fa3-secret-broker
ReadOnlyPaths=/etc/fa3/secret-policy.d
