[Unit]
Description=FA3 encrypted machine-state host mount
Requires=fa3-secret-vault.service
After=fa3-secret-vault.service
Before=fa3-secret-broker.service
PartOf=fa3-secrets.target

[Mount]
What=/dev/mapper/fa3-machine-state
Where=/run/fa3/machine-state
Type=ext4
Options=rw,nodev,nosuid,noexec
DirectoryMode=0750
TimeoutSec=30s
