{
  "schema": "fa3.secret-projection-policy.v1",
  "secret_id": "example/provider-api-token",
  "classification": "MACHINE_SERVICE_SECRET",
  "allowed_consumers": [
    {
      "consumer_id": "FA3-PROVIDER-EXAMPLE-001",
      "allowed_unix_users": [
        "fa3-example"
      ],
      "allowed_executables": [
        "/usr/local/bin/fa3-example-provider"
      ],
      "allowed_systemd_units": [
        "fa3-example-provider.service"
      ]
    }
  ],
  "allowed_projections": [
    "UDS_SINGLE_SECRET",
    "SYSTEMD_CREDENTIAL",
    "PODMAN_SECRET_MOUNT"
  ],
  "exportable": false,
  "secret_kind": "API_TOKEN"
}
