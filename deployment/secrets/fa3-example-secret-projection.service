# Example provider-specific projection pattern.
# The dedicated provider Unix user MUST also be a member of fa3-secret-clients so it can reach the broker UDS.
# The projection unit MUST run as the same dedicated Unix identity admitted in the SecretRef policy.
[Unit]
Description=Example FA3 provider credential projection
Requires=fa3-secret-broker.service
After=fa3-secret-broker.service
Before=fa3-example-provider.service
PartOf=fa3-secrets.target

[Service]
Type=oneshot
User=fa3-example
Group=fa3-example
RuntimeDirectory=fa3-example-credentials
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/fa3-secretctl get example/provider-api-token --consumer FA3-PROVIDER-EXAMPLE-001 --projection SYSTEMD_CREDENTIAL --output /run/fa3-example-credentials/api-token
RemainAfterExit=yes
ExecStop=/bin/rm -f /run/fa3-example-credentials/api-token
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX

# The consuming provider unit should use:
# Requires=fa3-example-secret-projection.service
# After=fa3-example-secret-projection.service
# PartOf=fa3-secrets.target
# LoadCredential=api-token:/run/fa3-example-credentials/api-token
# ExecStartPre=/bin/rm -f /run/fa3-example-credentials/api-token
# and read only $CREDENTIALS_DIRECTORY/api-token.
