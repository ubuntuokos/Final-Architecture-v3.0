# FA3 Secret Broker machine vaults are internal security resources.
# They must never be exposed through desktop/UDisks automount or file-manager discovery.
SUBSYSTEM=="block", KERNEL=="dm-*", ENV{DM_NAME}=="fa3-machine-state", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_SYSTEM_INTERNAL}="1"
SUBSYSTEM=="block", KERNEL=="dm-*", ENV{DM_NAME}=="fa3-machine-state-e2e-*", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_SYSTEM_INTERNAL}="1"
SUBSYSTEM=="block", KERNEL=="dm-*", ENV{DM_NAME}=="fa3-sb-e2e-*", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_SYSTEM_INTERNAL}="1"
SUBSYSTEM=="block", KERNEL=="dm-*", ENV{DM_NAME}=="fa3-sb-restore-*", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_SYSTEM_INTERNAL}="1"
