ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl ffmpeg imagemagick jq libatomic1 libpq-dev \
      nodejs npm ripgrep tree bubblewrap \
 && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir "poetry==2.2.1"

COPY autogpt_platform/autogpt_libs /app/autogpt_platform/autogpt_libs
COPY autogpt_platform/backend/poetry.lock autogpt_platform/backend/pyproject.toml /app/autogpt_platform/backend/

WORKDIR /app/autogpt_platform/backend
RUN poetry install --no-ansi --no-root --only main

COPY autogpt_platform/backend/schema.prisma ./
COPY autogpt_platform/backend/migrations ./migrations
COPY autogpt_platform/backend/scripts ./scripts
COPY autogpt_platform/backend/backend ./backend
COPY docs /app/docs

RUN prisma generate \
 && python scripts/gen_prisma_types_stub.py \
 && poetry install --no-ansi --only-root

ENV AGENT_API_HOST=0.0.0.0 \
    AGENT_API_PORT=8006

EXPOSE 8006
CMD ["rest"]
