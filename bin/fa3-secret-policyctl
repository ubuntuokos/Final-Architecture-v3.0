#!/usr/bin/env python3
from __future__ import annotations
import argparse,grp,hashlib,json,os,pwd,re,tempfile
from pathlib import Path

POLICY_DIR=Path(os.environ.get("FA3_SECRET_POLICY_DIR","/etc/fa3/secret-policy.d"))
ALLOWED_KINDS={
    "API_KEY","API_TOKEN","SERVICE_TOKEN","OAUTH_CLIENT_SECRET","OAUTH_REFRESH_TOKEN",
    "PROVIDER_CREDENTIAL","PROVIDER_LOGIN_PASSWORD","SERVICE_PASSWORD","DATABASE_PASSWORD",
    "SMTP_PASSWORD","MCP_PROVIDER_CREDENTIAL","PRIVATE_CREDENTIAL_MATERIAL","GENERIC_FA3_CREDENTIAL",
}
ALLOWED_PROJECTIONS={"UDS_SINGLE_SECRET","SYSTEMD_CREDENTIAL","PODMAN_SECRET_MOUNT","MEMFD"}
SID=re.compile(r"^[A-Za-z0-9._:/-]{1,256}$")

def validate(x:dict)->None:
    if set(x)!={"schema","secret_id","classification","secret_kind","allowed_consumers","allowed_projections","exportable"}:
        raise ValueError("policy fields do not match canonical schema")
    if x["schema"]!="fa3.secret-projection-policy.v1": raise ValueError("invalid policy schema")
    sid=x["secret_id"]
    if not isinstance(sid,str) or not SID.fullmatch(sid) or any(p in {"",".",".."} for p in sid.split("/")):
        raise ValueError("invalid secret_id")
    if x["classification"] not in {"MACHINE_SERVICE_SECRET","USER_SESSION_SECRET"}: raise ValueError("invalid classification")
    if x["secret_kind"] not in ALLOWED_KINDS: raise ValueError("invalid secret_kind")
    if x["exportable"] is not False: raise ValueError("exportable must be false")
    projections=x["allowed_projections"]
    if not isinstance(projections,list) or not projections or any(p not in ALLOWED_PROJECTIONS for p in projections):
        raise ValueError("invalid allowed_projections")
    consumers=x["allowed_consumers"]
    if not isinstance(consumers,list) or not consumers: raise ValueError("allowed_consumers required")
    for c in consumers:
        if set(c)-{"consumer_id","allowed_unix_users","allowed_executables","allowed_systemd_units"}: raise ValueError("unexpected consumer field")
        if not isinstance(c.get("consumer_id"),str) or not c["consumer_id"]: raise ValueError("consumer_id required")
        users=c.get("allowed_unix_users")
        if not isinstance(users,list) or not users or any(not isinstance(u,str) or not u for u in users): raise ValueError("allowed_unix_users required")
        for u in users:
            try: pwd.getpwnam(u)
            except KeyError: raise ValueError(f"unknown unix user: {u}")
        if x["classification"]=="MACHINE_SERVICE_SECRET":
            if len(users)!=1 or users[0] in {"root","fa3-secret-broker"}:
                raise ValueError("machine/service secret requires exactly one dedicated non-root consumer user")
            try:
                pg=grp.getgrnam("fa3-secret-clients"); up=pwd.getpwnam(users[0])
            except KeyError:
                raise ValueError("fa3-secret-clients transport group or consumer user missing")
            if up.pw_gid!=pg.gr_gid and users[0] not in pg.gr_mem:
                raise ValueError("machine/service consumer must be a member of fa3-secret-clients")
        exes=c.get("allowed_executables",[])
        if not isinstance(exes,list) or any(not isinstance(v,str) or not v.startswith("/") for v in exes): raise ValueError("allowed_executables must be absolute paths")
        units=c.get("allowed_systemd_units",[])
        if not isinstance(units,list) or any(not isinstance(v,str) or not v for v in units): raise ValueError("invalid allowed_systemd_units")

def safe_name(sid:str)->str:
    return "p-"+hashlib.sha256(sid.encode()).hexdigest()+".json"

def require_root()->None:
    if os.geteuid()!=0: raise SystemExit("root required")

def main()->int:
    ap=argparse.ArgumentParser()
    sub=ap.add_subparsers(dest="cmd",required=True)
    i=sub.add_parser("install");i.add_argument("file")
    ck=sub.add_parser("check");ck.add_argument("file")
    r=sub.add_parser("remove");r.add_argument("secret_id")
    s=sub.add_parser("show");s.add_argument("secret_id")
    sub.add_parser("list")
    a=ap.parse_args()
    if a.cmd in {"install","remove"}: require_root()
    if a.cmd=="check":
        x=json.loads(Path(a.file).read_text());validate(x);print("PASS");return 0
    POLICY_DIR.mkdir(parents=True,exist_ok=True)
    if a.cmd=="install":
        src=Path(a.file)
        x=json.loads(src.read_text());validate(x)
        dst=POLICY_DIR/safe_name(x["secret_id"])
        fd,tmp=tempfile.mkstemp(prefix=".fa3-policy-",dir=str(POLICY_DIR))
        try:
            os.fchmod(fd,0o640)
            with os.fdopen(fd,"w",encoding="utf-8",closefd=True) as fh:
                json.dump(x,fh,indent=2,sort_keys=True);fh.write("\n");fh.flush();os.fsync(fh.fileno())
            os.chown(tmp,0,grp.getgrnam("fa3-secret-broker").gr_gid)
            os.replace(tmp,dst)
            dfd=os.open(POLICY_DIR,os.O_DIRECTORY)
            try:os.fsync(dfd)
            finally:os.close(dfd)
        finally:
            if os.path.exists(tmp): os.unlink(tmp)
        print(dst)
        return 0
    target=POLICY_DIR/safe_name(a.secret_id) if hasattr(a,"secret_id") else None
    if a.cmd=="remove":
        if not target.is_file(): raise SystemExit("policy not found")
        target.unlink()
        dfd=os.open(POLICY_DIR,os.O_DIRECTORY)
        try:os.fsync(dfd)
        finally:os.close(dfd)
        return 0
    if a.cmd=="show":
        if not target.is_file(): raise SystemExit("policy not found")
        x=json.loads(target.read_text());validate(x);print(json.dumps(x,indent=2,sort_keys=True));return 0
    for p in sorted(POLICY_DIR.glob("*.json")):
        try:
            x=json.loads(p.read_text());validate(x)
            print(f'{x["secret_id"]}\t{x["classification"]}\t{x["secret_kind"]}')
        except Exception:
            print(f'INVALID\t{p}',file=__import__("sys").stderr)
    return 0
if __name__=="__main__": raise SystemExit(main())
