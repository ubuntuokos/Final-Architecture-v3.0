#!/usr/bin/env bash
set -euo pipefail
[[ "$(id -u)" -eq 0 ]] || { echo "Run with sudo/root." >&2; exit 2; }

MANIFEST="/var/lib/fa3/install/secret-broker-manifest.json"
[[ -f "$MANIFEST" ]] || { echo "DENY: ownership manifest missing: $MANIFEST" >&2; exit 2; }

python3 - "$MANIFEST" <<'PY'
import hashlib,json,sys
from pathlib import Path
manifest=Path(sys.argv[1])
doc=json.loads(manifest.read_text(encoding="utf-8"))
if doc.get("schema")!="fa3.secret-broker-install-manifest.v1" or doc.get("component_id")!="FA3-SECRET-BROKER-001":
    raise SystemExit("DENY: invalid Secret Broker ownership manifest")
def digest(p):
    h=hashlib.sha256()
    with p.open("rb") as f:
        for b in iter(lambda:f.read(1024*1024),b""): h.update(b)
    return h.hexdigest()
for row in doc.get("owned_files",[]):
    p=Path(row["path"])
    if p.exists() and digest(p)!=row["sha256"]:
        raise SystemExit(f"DENY: owned file changed after install; refusing ambiguous removal: {p}")
PY

systemctl stop fa3-secrets.target 2>/dev/null || true
systemctl disable fa3-secret-broker.service fa3-secret-vault.service 2>/dev/null || true

python3 - "$MANIFEST" <<'PY'
import json,os,sys
from pathlib import Path
doc=json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
for row in doc.get("owned_files",[]):
    p=Path(row["path"])
    if p.exists():
        p.unlink()
PY

systemctl daemon-reload
udevadm control --reload-rules 2>/dev/null || true
rm -f -- "$MANIFEST"

# Deliberately preserve credential data and policy directories.
# They may contain operator-owned state and require explicit separate data-destruction action.
echo "FA3 Secret Broker runtime files removed. Preserved: /var/lib/fa3/state and /etc/fa3/secret-policy.d"
