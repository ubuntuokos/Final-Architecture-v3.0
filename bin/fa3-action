#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src"
if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

from fa3_uaf import (
    ActionRequest,
    ExecutionContext,
    UafError,
    build_reference_runtime,
)

POLICY_AUTHORITY = "SECURITY_GOVERNANCE_POLICY_PLANE"


def _read_json(path: str | None, default: Any) -> Any:
    if path is None:
        return default
    return json.loads(Path(path).read_text(encoding="utf-8"))


def _authorizer(decision: dict[str, Any], principal: str):
    def authorize(request, contract) -> bool:
        return (
            decision.get("authority") == POLICY_AUTHORITY
            and decision.get("status") == "ALLOW"
            and decision.get("action_id") == contract.action_id
            and decision.get("principal_ref") == principal
            and bool(str(decision.get("decision_id", "")).strip())
        )
    return authorize


def main() -> int:
    parser = argparse.ArgumentParser(
        description="FA3 Unified Action Fabric CLI projection"
    )
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    show = sub.add_parser("show")
    show.add_argument("action_id")
    run = sub.add_parser("run")
    run.add_argument("action_id")
    run.add_argument("--arguments", default="{}", help="JSON object")
    run.add_argument("--principal", required=True)
    run.add_argument(
        "--policy-decision",
        required=True,
        help="Path to policy decision JSON",
    )
    run.add_argument("--context-id", default="cli")
    args = parser.parse_args()

    action_dir = ROOT / "canonical/actions"
    receipts: list[dict[str, Any]] = []
    if args.command in {"list", "show"}:
        from fa3_uaf import ActionRegistry
        registry = ActionRegistry.from_directory(action_dir)
        if args.command == "list":
            print(json.dumps([
                {
                    "id": contract.action_id,
                    "version": contract.version,
                    "description": contract.description,
                }
                for contract in registry.list()
            ], indent=2, ensure_ascii=False))
            return 0
        contract = registry.get(args.action_id)
        print(json.dumps({
            "id": contract.action_id,
            "version": contract.version,
            "description": contract.description,
            "exposure": contract.exposure,
            "security": contract.security,
            "resources": contract.resources,
        }, indent=2, ensure_ascii=False))
        return 0

    decision = _read_json(args.policy_decision, {})
    if not isinstance(decision, dict):
        print("invalid policy decision", file=sys.stderr)
        return 2
    dispatcher = build_reference_runtime(
        action_dir,
        authorize=_authorizer(decision, args.principal),
        evidence_sink=receipts.append,
    )
    try:
        arguments = json.loads(args.arguments)
        if not isinstance(arguments, dict):
            raise ValueError("arguments must be object")
        result = dispatcher.execute(ActionRequest(
            action_id=args.action_id,
            arguments=arguments,
            principal={"id": args.principal},
            context=ExecutionContext(args.context_id),
        ))
    except (UafError, ValueError, json.JSONDecodeError) as exc:
        code = getattr(exc, "code", "UAF-CLI-INVALID")
        print(json.dumps({
            "status": "BLOCKED",
            "reason_code": code,
            "message": str(exc),
        }, ensure_ascii=False), file=sys.stderr)
        return 2
    out = ROOT / "reports/uaf-cli-receipt.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(
        json.dumps(receipts[-1], indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    print(json.dumps(result.as_dict(), indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
