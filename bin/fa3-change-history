#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from fa3_change_history import DerivedChangeIndex
from fa3_change_rollback import rollback_impact


def main() -> int:
    parser = argparse.ArgumentParser(description="FA3 Change-History Intelligence read-only CLI")
    parser.add_argument("--index")
    sub = parser.add_subparsers(dest="command", required=True)

    history = sub.add_parser("history")
    history.add_argument("object_type")
    history.add_argument("object_id")

    rollback = sub.add_parser("rollback-impact")
    rollback.add_argument("changeset_id")
    rollback.add_argument("record_ids", nargs="+")
    rollback.add_argument("--edges-json", required=True)

    args = parser.parse_args()
    index = DerivedChangeIndex(args.index) if args.index else DerivedChangeIndex()

    if args.command == "history":
        result = index.history(args.object_type, args.object_id)
    else:
        edges = json.loads(Path(args.edges_json).read_text(encoding="utf-8"))
        result = rollback_impact(args.changeset_id, args.record_ids, edges)
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
