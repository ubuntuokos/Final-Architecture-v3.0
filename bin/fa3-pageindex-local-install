#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIN="9a8dd6658278fec90347e8ac3388a205305667a3"
PROVIDER_BASE="${FA3_PAGEINDEX_LOCAL_PROVIDER_ROOT:-$HOME/.local/share/fa3/providers/pageindex-local}"
PROVIDER_ROOT="$PROVIDER_BASE/$PIN"; VENV="$PROVIDER_ROOT/venv"
RUNTIME_ROOT="${FA3_PAGEINDEX_LOCAL_RUNTIME_ROOT:-$HOME/.local/share/fa3/pageindex-local-runtime}"
GATEWAY_RUNTIME="${FA3_MCP_RUNTIME_ROOT:-$HOME/.local/share/fa3/mcp-gateway-runtime}"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"; DROPIN_DIR="$UNIT_DIR/fa3-mcp-gateway.service.d"
ALLOWED_ROOT=""; MODEL="${FA3_PAGEINDEX_MODEL:-}"; START=0; STOP=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --allowed-root) ALLOWED_ROOT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --start) START=1; shift ;;
    --stop) STOP=1; shift ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done
if [[ "$STOP" -eq 1 ]]; then
  systemctl --user disable --now fa3-pageindex-local.service fa3-pageindex-model-router.service 2>/dev/null || true
  rm -f "$DROPIN_DIR/pageindex-local.conf"; systemctl --user daemon-reload
  systemctl --user try-restart fa3-mcp-gateway.service 2>/dev/null || true; exit 0
fi
test -x "$VENV/bin/python" || { echo "Run bin/fa3-pageindex-local-bootstrap.sh first" >&2; exit 3; }
test -n "$ALLOWED_ROOT" || { echo "--allowed-root required" >&2; exit 3; }
ALLOWED_ROOT="$(realpath "$ALLOWED_ROOT")"; test -d "$ALLOWED_ROOT"
if [[ -z "$MODEL" ]]; then
  MODEL="$(python3 - <<'PY'
import json,urllib.request
with urllib.request.urlopen("http://127.0.0.1:11434/api/tags",timeout=5) as r: rows=json.load(r).get("models",[])
names=[x.get("name") for x in rows if isinstance(x,dict) and x.get("name")]
for needle in ("qwen","llama","gemma"):
    for name in names:
        if needle in name.lower(): print(name); raise SystemExit
if names: print(names[0])
PY
)"
fi
test -n "$MODEL" || { echo "No local Ollama model available; set FA3_PAGEINDEX_MODEL" >&2; exit 4; }
mkdir -p "$RUNTIME_ROOT/src" "$RUNTIME_ROOT/storage" "$UNIT_DIR" "$DROPIN_DIR"
for f in fa3_mcp_gateway.py fa3_pageindex_local_provider.py fa3_pageindex_local_service.py fa3_pageindex_model_router.py; do install -m 0644 "$REPO_ROOT/src/$f" "$RUNTIME_ROOT/src/$f"; done
test -d "$GATEWAY_RUNTIME/src" || { echo "Central MCP Gateway runtime missing" >&2; exit 5; }
install -m 0644 "$REPO_ROOT/src/fa3_pageindex_local_gateway_adapter.py" "$GATEWAY_RUNTIME/src/fa3_pageindex_local_gateway_adapter.py"
python3 - "$REPO_ROOT" "$UNIT_DIR" "$RUNTIME_ROOT" "$VENV" "$ALLOWED_ROOT" "$MODEL" <<'PY'
from pathlib import Path
import sys
repo,unit_dir,runtime,venv,allowed,model=sys.argv[1:]
def q(v): return '"' + v.replace("\\","\\\\").replace('"','\\"') + '"'
def render(src,dst,repls):
    text=Path(src).read_text()
    for k,v in repls.items(): text=text.replace(k,v)
    Path(dst).write_text(text)
render(Path(repo)/"deployment/pageindex-local/fa3-pageindex-model-router.service.in",Path(unit_dir)/"fa3-pageindex-model-router.service",{"@SYSTEM_PYTHON@":q(sys.executable),"@ROUTER_SCRIPT@":q(str(Path(runtime)/"src/fa3_pageindex_model_router.py"))})
render(Path(repo)/"deployment/pageindex-local/fa3-pageindex-local.service.in",Path(unit_dir)/"fa3-pageindex-local.service",{
 "@RUNTIME_ROOT@":runtime,"@VENV_PYTHON@":q(str(Path(venv)/"bin/python")),"@SERVICE_SCRIPT@":q(str(Path(runtime)/"src/fa3_pageindex_local_service.py")),
 "@ENV_SOCKET@":q("FA3_PAGEINDEX_LOCAL_SOCKET=%t/fa3-pageindex-local/pageindex-local.sock"),"@ENV_STORAGE@":q("FA3_PAGEINDEX_LOCAL_STORAGE="+str(Path(runtime)/"storage")),
 "@ENV_ROOTS@":q("FA3_PAGEINDEX_LOCAL_ALLOWED_ROOTS="+allowed),"@ENV_ROUTER@":q("FA3_PAGEINDEX_MODEL_ROUTER=http://127.0.0.1:18791/v1"),
 "@ENV_INDEX_MODEL@":q("FA3_PAGEINDEX_INDEX_MODEL="+model),"@ENV_CHAT_MODEL@":q("FA3_PAGEINDEX_CHAT_MODEL="+model)})
PY
cat > "$DROPIN_DIR/pageindex-local.conf" <<'EOF'
[Unit]
Requires=fa3-pageindex-local.service
After=fa3-pageindex-local.service

[Service]
Environment="FA3_MCP_ADAPTER_FACTORIES=fa3_os_mcp_adapter:create_adapters,fa3_pageindex_local_gateway_adapter:factory_from_env"
Environment="FA3_PAGEINDEX_LOCAL_SOCKET=%t/fa3-pageindex-local/pageindex-local.sock"
EOF
systemctl --user daemon-reload
systemd-analyze --user verify "$UNIT_DIR/fa3-pageindex-model-router.service" "$UNIT_DIR/fa3-pageindex-local.service" "$UNIT_DIR/fa3-mcp-gateway.service"
if [[ "$START" -eq 1 ]]; then
  systemctl --user enable fa3-pageindex-model-router.service fa3-pageindex-local.service
  systemctl --user restart fa3-pageindex-model-router.service
  systemctl --user restart fa3-pageindex-local.service
  systemctl --user restart fa3-mcp-gateway.service
fi
printf 'PageIndex Local model: %s\n' "$MODEL"
