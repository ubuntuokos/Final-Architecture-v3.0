#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${FA3_COSYVOICE_PYTHON:-$ROOT/.venv-cosyvoice/bin/python}"
if [[ ! -x "$PYTHON" ]]; then
  echo "CosyVoice provider Python not found: $PYTHON" >&2
  echo "Run: bash $ROOT/bin/fa3-cosyvoice-bootstrap.sh" >&2
  exit 69
fi
exec env PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" "$ROOT/src/fa3_cosyvoice_provider.py" --root "$ROOT" "$@"
