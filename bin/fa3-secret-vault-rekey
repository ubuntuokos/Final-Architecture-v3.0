#!/usr/bin/env bash
set -euo pipefail

[[ "$(id -u)" -eq 0 ]] || { echo "Run with sudo/root." >&2; exit 2; }

IMAGE="${FA3_MACHINE_STATE_IMAGE:-/var/lib/fa3/state/fa3-machine-state.img}"
CRED="${FA3_MACHINE_STATE_CREDENTIAL:-/etc/credstore.encrypted/fa3-machine-state-key.cred}"
LIFECYCLE="${FA3_SECRETS_LIFECYCLE:-/usr/local/sbin/fa3-secrets-lifecycle}"
CRED_NAME="fa3-machine-state-key"
MAPPER="${FA3_MACHINE_STATE_MAPPER:-fa3-machine-state}"
MNT="${FA3_MACHINE_STATE_MOUNT:-/run/fa3/machine-state}"
NEW_KEY_INPUT="${FA3_REKEY_NEW_KEY_FILE:-}"

lifecycle(){
  FA3_MACHINE_STATE_MAPPER="$MAPPER" FA3_MACHINE_STATE_MOUNT="$MNT" "$LIFECYCLE" "$@"
}

for c in cryptsetup systemd-creds install mktemp cmp mv rm chmod cp grep stat; do
  command -v "$c" >/dev/null || { echo "missing prerequisite: $c" >&2; exit 2; }
done

lifecycle assert-closed >/dev/null
[[ -f "$IMAGE" && ! -L "$IMAGE" ]] || { echo "regular image required: $IMAGE" >&2; exit 2; }
[[ -f "$CRED" && ! -L "$CRED" ]] || { echo "encrypted credential required: $CRED" >&2; exit 2; }
cryptsetup isLuks "$IMAGE"
cryptsetup luksDump "$IMAGE" | grep -Eq '^Version:[[:space:]]+2$'

TMP="$(mktemp -d /run/fa3-machine-state-rekey.XXXXXX)"
chmod 0700 "$TMP"
OLD="$TMP/old.key"
NEW="$TMP/new.key"
VERIFY="$TMP/verify.key"
NEWCRED="$TMP/$CRED_NAME.cred"
OLDCRED="$TMP/original.cred"
NEW_KEY_ADDED=false
CRED_REPLACED=false
SUCCESS=false

cleanup(){
  local rc="$1"
  set +e
  lifecycle exit >/dev/null 2>&1 || true

  if [[ "$SUCCESS" != true ]]; then
    if [[ "$CRED_REPLACED" == true ]]; then
      if cryptsetup open --test-passphrase --type luks2 --key-file "$OLD" "$IMAGE" >/dev/null 2>&1; then
        cp -f "$OLDCRED" "$CRED"
        chmod 0600 "$CRED"
        CRED_REPLACED=false
        if [[ "$NEW_KEY_ADDED" == true ]]; then
          cryptsetup luksRemoveKey "$IMAGE" "$NEW" >/dev/null 2>&1 || true
          NEW_KEY_ADDED=false
        fi
      else
        echo "WARNING: rekey did not complete cleanly, but the new encrypted credential remains active because the old key no longer unlocks the image." >&2
      fi
    elif [[ "$NEW_KEY_ADDED" == true ]]; then
      cryptsetup luksRemoveKey "$IMAGE" "$NEW" >/dev/null 2>&1 || true
      NEW_KEY_ADDED=false
    fi
  fi

  rm -f "$OLD" "$NEW" "$VERIFY" "$NEWCRED" "$OLDCRED"
  rmdir "$TMP" >/dev/null 2>&1 || true
  unset PASS PASS2 || true
  return "$rc"
}

on_exit(){
  local rc=$?
  trap - EXIT
  cleanup "$rc"
  exit "$rc"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

systemd-creds decrypt --name="$CRED_NAME" "$CRED" "$OLD" >/dev/null
chmod 0600 "$OLD"
cryptsetup open --test-passphrase --type luks2 --key-file "$OLD" "$IMAGE"

umask 077
if [[ -n "$NEW_KEY_INPUT" ]]; then
  [[ "$NEW_KEY_INPUT" == /run/* && -f "$NEW_KEY_INPUT" && ! -L "$NEW_KEY_INPUT" ]] || {
    echo "FA3_REKEY_NEW_KEY_FILE must be a regular non-symlink file below /run" >&2
    exit 2
  }
  mode="$(stat -c '%a' "$NEW_KEY_INPUT")"
  (( (8#$mode & 077) == 0 )) || { echo "FA3_REKEY_NEW_KEY_FILE permissions are too broad" >&2; exit 2; }
  cp --reflink=never "$NEW_KEY_INPUT" "$NEW"
  chmod 0600 "$NEW"
else
  read -r -s -p "New FA3 machine-state passphrase: " PASS; echo
  read -r -s -p "Repeat new passphrase: " PASS2; echo
  [[ -n "$PASS" && "$PASS" == "$PASS2" ]] || { echo "Passphrases do not match" >&2; exit 2; }
  unset PASS2
  printf '%s' "$PASS" > "$NEW"
  unset PASS
fi
[[ -s "$NEW" ]] || { echo "new passphrase is empty" >&2; exit 2; }
if cmp -s "$OLD" "$NEW"; then
  echo "new passphrase must differ from the current passphrase" >&2
  exit 2
fi

systemd-creds encrypt --with-key=host --name="$CRED_NAME" "$NEW" "$NEWCRED" >/dev/null
chmod 0600 "$NEWCRED"
systemd-creds decrypt --name="$CRED_NAME" "$NEWCRED" "$VERIFY" >/dev/null
chmod 0600 "$VERIFY"
cmp -s "$NEW" "$VERIFY" || { echo "encrypted credential verification failed" >&2; exit 2; }
rm -f "$VERIFY"

cryptsetup luksAddKey --type luks2 --key-file "$OLD" "$IMAGE" "$NEW"
NEW_KEY_ADDED=true
cryptsetup open --test-passphrase --type luks2 --key-file "$NEW" "$IMAGE"

cp --preserve=mode "$CRED" "$OLDCRED"
chmod 0600 "$OLDCRED"
install -m0600 "$NEWCRED" "${CRED}.new"
mv -f "${CRED}.new" "$CRED"
CRED_REPLACED=true

lifecycle start >/dev/null
/usr/local/bin/fa3-secretctl health >/dev/null
lifecycle exit >/dev/null
lifecycle assert-closed >/dev/null

cryptsetup luksRemoveKey "$IMAGE" "$OLD"
if cryptsetup open --test-passphrase --type luks2 --key-file "$OLD" "$IMAGE" >/dev/null 2>&1; then
  echo "old passphrase still unlocks the image after keyslot removal" >&2
  exit 2
fi
cryptsetup open --test-passphrase --type luks2 --key-file "$NEW" "$IMAGE"
NEW_KEY_ADDED=false
SUCCESS=true

trap - EXIT INT TERM
cleanup 0
echo "FA3 machine-state unlock key rotation PASS; vault final state: CLOSED"
