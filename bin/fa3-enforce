#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${1:-}" == "language-gateway" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_language_gateway_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "static" ]]; then
  shift
  # Language/Gateway P0 is part of the global static admission surface. Keep
  # its report separate while preventing the legacy static gate from passing
  # if multilingual/gateway invariants fail.
  python3 "$ROOT/src/fa3_language_gateway_gate.py" --root "$ROOT" >/dev/null
  exec python3 "$ROOT/src/fa3_enforce.py" --root "$ROOT" static "$@"
fi
if [[ "${1:-}" == "mmg-context-ir" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_mmg_context_ir_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "page-cache-prefetch" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_page_cache_prefetch_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "human-motion-current-host" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_human_motion_current_host_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "soma-x" || "${1:-}" == "gem-x" || "${1:-}" == "human-motion" ]]; then
  command="$1"
  shift
  exec python3 "$ROOT/src/fa3_human_motion_gate.py" "$command" --root "$ROOT" "$@"
fi
exec python3 "$ROOT/src/fa3_enforce.py" --root "$ROOT" "$@"
