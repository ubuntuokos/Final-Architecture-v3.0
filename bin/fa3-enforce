#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${1:-}" == "model-router-current-host" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_model_router_current_host_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "model-router" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_model_router_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "language-gateway-current-host" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_language_gateway_current_host_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "language-gateway" ]]; then
  shift
  python3 "$ROOT/src/fa3_model_router_gate.py" --root "$ROOT" >/dev/null
  python3 "$ROOT/src/fa3_canonical_language_gate.py" --root "$ROOT" >/dev/null
  exec python3 "$ROOT/src/fa3_language_gateway_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "static" ]]; then
  shift
  # Canonical English machine-language and Language/Gateway P0 are part of the
  # global static admission surface. Their reports remain separate while the
  # static entrypoint fails closed if either multilingual invariant layer drifts.
  python3 "$ROOT/src/fa3_canonical_language_gate.py" --root "$ROOT" >/dev/null
  python3 "$ROOT/src/fa3_language_gateway_gate.py" --root "$ROOT" >/dev/null
  exec python3 "$ROOT/src/fa3_enforce.py" --root "$ROOT" static "$@"
fi
if [[ "${1:-}" == "mmg-context-ir" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_mmg_context_ir_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "page-cache-prefetch" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_page_cache_prefetch_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "human-motion-current-host" ]]; then
  shift
  exec python3 "$ROOT/src/fa3_human_motion_current_host_gate.py" --root "$ROOT" "$@"
fi
if [[ "${1:-}" == "soma-x" || "${1:-}" == "gem-x" || "${1:-}" == "human-motion" ]]; then
  command="$1"
  shift
  exec python3 "$ROOT/src/fa3_human_motion_gate.py" "$command" --root "$ROOT" "$@"
fi
exec python3 "$ROOT/src/fa3_enforce.py" --root "$ROOT" "$@"
