#!/usr/bin/env bash
set -euo pipefail

LIFECYCLE="${FA3_SECRETS_LIFECYCLE:-/usr/local/sbin/fa3-secrets-lifecycle}"
SECRETCTL="${FA3_SECRETCTL:-/usr/local/bin/fa3-secretctl}"
POLICYCTL="${FA3_SECRET_POLICYCTL:-/usr/local/sbin/fa3-secret-policyctl}"
RECOVERY="${FA3_SECRET_RECOVERY:-/usr/local/sbin/fa3-secret-vault-recovery}"
INIT="${FA3_SECRET_INIT:-/usr/local/sbin/fa3-secret-vault-init}"

usage(){
  cat <<'EOF'
usage: fa3-secrets-admin <command> [args]

Lifecycle:
  init
  start
  status
  exit
  assert-closed
  health

Credential store:
  put <secret_id> --kind <KIND> [--classification <CLASS>]
  rotate <secret_id> --kind <KIND> [--classification <CLASS>]
  revoke <secret_id>
  metadata <secret_id>
  list

Projection policy:
  policy-install <policy.json>
  policy-remove <secret_id>
  policy-show <secret_id>
  policy-list

Recovery:
  backup [destination.img]
  restore <backup.img>
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  init) exec sudo "$INIT" "$@";;
  start) exec sudo "$LIFECYCLE" start;;
  status) exec sudo "$LIFECYCLE" status;;
  exit|stop) exec sudo "$LIFECYCLE" exit;;
  assert-closed) exec sudo "$LIFECYCLE" assert-closed;;
  health) exec sudo "$SECRETCTL" health;;
  put) exec sudo "$SECRETCTL" put "$@";;
  rotate) exec sudo "$SECRETCTL" rotate "$@";;
  revoke) exec sudo "$SECRETCTL" revoke "$@";;
  metadata) exec sudo "$SECRETCTL" admin-metadata "$@";;
  list) exec sudo "$SECRETCTL" list-metadata;;
  policy-install) exec sudo "$POLICYCTL" install "$@";;
  policy-remove) exec sudo "$POLICYCTL" remove "$@";;
  policy-show) exec sudo "$POLICYCTL" show "$@";;
  policy-list) exec sudo "$POLICYCTL" list;;
  backup) exec sudo "$RECOVERY" backup "$@";;
  restore) exec sudo "$RECOVERY" restore "$@";;
  ""|-h|--help|help) usage;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 2;;
esac
