#!/usr/bin/env bash
set -euo pipefail

LIFECYCLE="${FA3_SECRETS_LIFECYCLE:-/usr/local/sbin/fa3-secrets-lifecycle}"
SECRETCTL="${FA3_SECRETCTL:-/usr/local/bin/fa3-secretctl}"
POLICYCTL="${FA3_SECRET_POLICYCTL:-/usr/local/sbin/fa3-secret-policyctl}"
RECOVERY="${FA3_SECRET_RECOVERY:-/usr/local/sbin/fa3-secret-vault-recovery}"
INIT="${FA3_SECRET_INIT:-/usr/local/sbin/fa3-secret-vault-init}"
REKEY="${FA3_SECRET_REKEY:-/usr/local/sbin/fa3-secret-vault-rekey}"

run_privileged(){
  if [[ "$(id -u)" -eq 0 ]]; then
    exec "$@"
  fi
  command -v sudo >/dev/null || { echo "root privileges required and sudo is unavailable" >&2; exit 2; }
  exec sudo "$@"
}

usage(){
  cat <<'EOF'
usage: fa3-secrets-admin <command> [args]

Lifecycle:
  init
  start
  status
  exit
  assert-closed
  health

Credential store:
  put <secret_id> --kind <KIND> [--classification <CLASS>]
  rotate <secret_id> --kind <KIND> [--classification <CLASS>]
  revoke <secret_id>
  metadata <secret_id>
  list

Projection policy:
  policy-check <policy.json>
  policy-install <policy.json>
  policy-remove <secret_id>
  policy-show <secret_id>
  policy-list

Recovery:
  backup [destination.img]
  restore <backup.img>
  rekey
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  init) run_privileged "$INIT" "$@";;
  start) run_privileged "$LIFECYCLE" start;;
  status) run_privileged "$LIFECYCLE" status;;
  exit|stop) run_privileged "$LIFECYCLE" exit;;
  assert-closed) run_privileged "$LIFECYCLE" assert-closed;;
  health) run_privileged "$SECRETCTL" health;;
  put) run_privileged "$SECRETCTL" put "$@";;
  rotate) run_privileged "$SECRETCTL" rotate "$@";;
  revoke) run_privileged "$SECRETCTL" revoke "$@";;
  metadata) run_privileged "$SECRETCTL" admin-metadata "$@";;
  list) run_privileged "$SECRETCTL" list-metadata;;
  policy-check) exec "$POLICYCTL" check "$@";;
  policy-install) run_privileged "$POLICYCTL" install "$@";;
  policy-remove) run_privileged "$POLICYCTL" remove "$@";;
  policy-show) run_privileged "$POLICYCTL" show "$@";;
  policy-list) run_privileged "$POLICYCTL" list;;
  backup) run_privileged "$RECOVERY" backup "$@";;
  restore) run_privileged "$RECOVERY" restore "$@";;
  rekey) run_privileged "$REKEY";;
  ""|-h|--help|help) usage;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 2;;
esac
