#!/usr/bin/env bash
# User opt-in installer: watch a private directory for explicitly supplied exports.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PRIVATE_HOME="$HOME/.local/share/fa3/donor-import"
UNIT_HOME="$HOME/.config/systemd/user"
SERVICE="$UNIT_HOME/fa3-donor-chat-import.service"
PATH_UNIT="$UNIT_HOME/fa3-donor-chat-import.path"

mkdir -p -m 700 "$PRIVATE_HOME/inbox" "$UNIT_HOME"
chmod 700 "$PRIVATE_HOME" "$PRIVATE_HOME/inbox"
if [[ -e "$SERVICE" || -e "$PATH_UNIT" ]]; then
  echo "BLOCKED: donor watcher unit already exists; inspect before overwriting" >&2
  exit 2
fi
if [[ "$ROOT" == *%* || "$ROOT" == *'"'* || "$ROOT" == *\\* || "$ROOT" =~ [[:space:]] ]]; then
  echo "BLOCKED: repository path cannot be represented safely in this unit" >&2
  exit 2
fi
cat >"$SERVICE" <<EOF
[Unit]
Description=FA3 private local ChatGPT donor import inbox

[Service]
Type=oneshot
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
WorkingDirectory=$ROOT
ExecStart=/usr/bin/env bash $ROOT/bin/fa3-donor-chat-inbox
EOF
cat >"$PATH_UNIT" <<'EOF'
[Unit]
Description=Watch private user-supplied ChatGPT donor export inbox

[Path]
PathModified=%h/.local/share/fa3/donor-import/inbox
Unit=fa3-donor-chat-import.service

[Install]
WantedBy=default.target
EOF
chmod 600 "$SERVICE" "$PATH_UNIT"
systemctl --user daemon-reload
systemctl --user enable --now fa3-donor-chat-import.path
echo "Enabled private donor export inbox: $PRIVATE_HOME/inbox"
echo "Only exports deliberately placed here are imported. ChatGPT account access is NOT enabled."
echo "To stop: systemctl --user disable --now fa3-donor-chat-import.path"
