#!/usr/bin/env python3
from __future__ import annotations
import argparse,base64,getpass,json,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
repo_module=ROOT/"src"/"fa3_secret_broker.py"
installed_module=Path("/usr/local/lib/fa3/fa3_secret_broker.py")
module_path=repo_module if repo_module.is_file() else installed_module
if not module_path.is_file(): raise SystemExit("fa3_secret_broker module not installed")
import importlib.util
spec=importlib.util.spec_from_file_location("fa3_secret_broker",module_path)
mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)
request=mod.request;DEFAULT_SOCKET=mod.DEFAULT_SOCKET
def main()->int:
    ap=argparse.ArgumentParser();ap.add_argument("--socket",default=DEFAULT_SOCKET);sub=ap.add_subparsers(dest="cmd",required=True)
    sub.add_parser("health")
    p=sub.add_parser("put");p.add_argument("secret_id");p.add_argument("--classification",choices=["MACHINE_SERVICE_SECRET","USER_SESSION_SECRET"],default="MACHINE_SERVICE_SECRET");p.add_argument("--kind",choices=sorted(mod.ALLOWED_SECRET_KINDS),required=True)
    for name in ("get","metadata"):
        q=sub.add_parser(name);q.add_argument("secret_id");q.add_argument("--consumer",required=True);q.add_argument("--projection",default="UDS_SINGLE_SECRET")
    d=sub.add_parser("delete");d.add_argument("secret_id")
    a=ap.parse_args();payload={"op":a.cmd}
    if a.cmd=="put":
        value=getpass.getpass("Secret value: ").encode() if sys.stdin.isatty() else sys.stdin.buffer.read(512*1024+1)
        if not value or len(value)>512*1024:raise SystemExit("secret size outside 1..524288 bytes")
        payload.update(secret_id=a.secret_id,classification=a.classification,secret_kind=a.kind,secret_b64=base64.b64encode(value).decode())
    elif a.cmd in {"get","metadata"}:payload.update(secret_id=a.secret_id,consumer_id=a.consumer,projection=a.projection)
    elif a.cmd=="delete":payload.update(secret_id=a.secret_id)
    r=request(Path(a.socket),payload)
    if not r.get("ok"):print(r.get("error","broker request denied"),file=sys.stderr);return 2
    if a.cmd=="get":sys.stdout.buffer.write(base64.b64decode(r["secret_b64"]));sys.stdout.buffer.flush()
    else:print(json.dumps(r,indent=2,sort_keys=True))
    return 0
if __name__=="__main__":raise SystemExit(main())
