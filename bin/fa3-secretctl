#!/usr/bin/env python3
from __future__ import annotations
import argparse,base64,getpass,json,os,sys,tempfile
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
repo_module=ROOT/"src"/"fa3_secret_broker.py"
installed_module=Path("/usr/local/lib/fa3/fa3_secret_broker.py")
module_path=repo_module if repo_module.is_file() else installed_module
if not module_path.is_file(): raise SystemExit("fa3_secret_broker module not installed")
import importlib.util
spec=importlib.util.spec_from_file_location("fa3_secret_broker",module_path)
mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)
request=mod.request;DEFAULT_SOCKET=mod.DEFAULT_SOCKET
def main()->int:
    ap=argparse.ArgumentParser();ap.add_argument("--socket",default=DEFAULT_SOCKET);sub=ap.add_subparsers(dest="cmd",required=True)
    sub.add_parser("health")
    p=sub.add_parser("put");p.add_argument("secret_id");p.add_argument("--classification",choices=["MACHINE_SERVICE_SECRET","USER_SESSION_SECRET"],default="MACHINE_SERVICE_SECRET");p.add_argument("--kind",choices=sorted(mod.ALLOWED_SECRET_KINDS),required=True)
    rt=sub.add_parser("rotate");rt.add_argument("secret_id");rt.add_argument("--classification",choices=["MACHINE_SERVICE_SECRET","USER_SESSION_SECRET"]);rt.add_argument("--kind",choices=sorted(mod.ALLOWED_SECRET_KINDS))
    for name in ("get","metadata"):
        q=sub.add_parser(name);q.add_argument("secret_id");q.add_argument("--consumer",required=True);q.add_argument("--projection",default="UDS_SINGLE_SECRET");q.add_argument("--output")
    d=sub.add_parser("delete");d.add_argument("secret_id")
    rv=sub.add_parser("revoke");rv.add_argument("secret_id")
    am=sub.add_parser("admin-metadata");am.add_argument("secret_id")
    sub.add_parser("list-metadata")
    a=ap.parse_args();payload={"op":a.cmd}
    if a.cmd in {"put","rotate"}:
        classification=a.classification
        kind=a.kind
        if a.cmd=="rotate":
            meta=request(Path(a.socket),{"op":"admin_metadata","secret_id":a.secret_id})
            if not meta.get("ok"):print(meta.get("error","cannot read existing metadata"),file=sys.stderr);return 2
            current=meta["metadata"]
            classification=classification or current["classification"]
            kind=kind or current["secret_kind"]
        value=getpass.getpass("Secret value: ").encode() if sys.stdin.isatty() else sys.stdin.buffer.read(512*1024+1)
        if not value or len(value)>512*1024:raise SystemExit("secret size outside 1..524288 bytes")
        payload.update(secret_id=a.secret_id,classification=classification,secret_kind=kind,secret_b64=base64.b64encode(value).decode())
    elif a.cmd in {"get","metadata"}:payload.update(secret_id=a.secret_id,consumer_id=a.consumer,projection=a.projection)
    elif a.cmd in {"delete","revoke"}:payload.update(secret_id=a.secret_id)
    elif a.cmd=="admin-metadata":payload.update(op="admin_metadata",secret_id=a.secret_id)
    elif a.cmd=="list-metadata":payload.update(op="list_metadata")
    r=request(Path(a.socket),payload)
    if not r.get("ok"):print(r.get("error","broker request denied"),file=sys.stderr);return 2
    if a.cmd=="get":
        value=bytearray(base64.b64decode(r["secret_b64"]))
        if a.output:
            out=Path(a.output)
            if not out.is_absolute(): raise SystemExit("--output must be an absolute /run path")
            out.parent.mkdir(parents=True,exist_ok=True)
            parent=Path(os.path.realpath(out.parent))
            if parent != Path("/run") and Path("/run") not in parent.parents: raise SystemExit("--output parent must resolve below /run")
            out=parent/out.name
            fd,tmp=tempfile.mkstemp(prefix=".fa3-secret-",dir=str(parent))
            try:
                os.fchmod(fd,0o600)
                with os.fdopen(fd,"wb",closefd=True) as fh:
                    fh.write(value);fh.flush();os.fsync(fh.fileno())
                os.replace(tmp,out)
            finally:
                for i in range(len(value)): value[i]=0
                if os.path.exists(tmp): os.unlink(tmp)
        else:
            sys.stdout.buffer.write(value);sys.stdout.buffer.flush()
            for i in range(len(value)): value[i]=0
    else:print(json.dumps(r,indent=2,sort_keys=True))
    return 0
if __name__=="__main__":raise SystemExit(main())
