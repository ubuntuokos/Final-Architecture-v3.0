#!/usr/bin/env bash
set -euo pipefail
[[ "$(id -u)" -eq 0 ]] || { echo "Run with sudo/root." >&2; exit 2; }
ROOT="${FA3_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
getent group fa3-secret-broker >/dev/null || groupadd --system fa3-secret-broker
getent group fa3-secret-clients >/dev/null || groupadd --system fa3-secret-clients
getent group fa3-secret-admin >/dev/null || groupadd --system fa3-secret-admin
if ! getent passwd fa3-secret-broker >/dev/null; then
  useradd --system --gid fa3-secret-broker --groups fa3-secret-clients --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin fa3-secret-broker
fi
install -d -m0700 /var/lib/fa3/state
install -d -o root -g fa3-secret-broker -m0750 /etc/fa3/secret-policy.d
install -d -m0755 /usr/local/lib/fa3
install -m0755 "$ROOT/src/fa3_secret_broker.py" /usr/local/lib/fa3/fa3_secret_broker.py
install -Dm0755 "$ROOT/bin/fa3-secretctl" /usr/local/bin/fa3-secretctl
install -Dm0755 "$ROOT/libexec/fa3-secret-vault-mount.sh" /usr/local/libexec/fa3-secret-vault-mount
install -Dm0644 "$ROOT/deployment/secrets/fa3-secret-vault.service" /etc/systemd/system/fa3-secret-vault.service
install -Dm0644 "$ROOT/deployment/secrets/fa3-secret-broker.service" /etc/systemd/system/fa3-secret-broker.service
install -Dm0644 "$ROOT/deployment/secrets/fa3-secrets.target" /etc/systemd/system/fa3-secrets.target
systemctl daemon-reload
echo "FA3 secret broker runtime installed. Initialize the encrypted image once with: sudo $ROOT/bin/fa3-secret-vault-init"
