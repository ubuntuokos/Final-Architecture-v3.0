#!/usr/bin/env bash
set -euo pipefail
[[ "$(id -u)" -eq 0 ]] || { echo "Run with sudo/root." >&2; exit 2; }

ROOT="${FA3_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
MANIFEST_DIR="/var/lib/fa3/install"
MANIFEST="$MANIFEST_DIR/secret-broker-manifest.json"

declare -a SOURCES=(
  "$ROOT/src/fa3_secret_broker.py"
  "$ROOT/bin/fa3-secretctl"
  "$ROOT/bin/fa3-secret-vault-init"
  "$ROOT/bin/fa3-secret-policyctl"
  "$ROOT/bin/fa3-secret-vault-recovery"
  "$ROOT/bin/fa3-secret-vault-rekey"
  "$ROOT/bin/fa3-secrets-admin"
  "$ROOT/libexec/fa3-secret-vault-mount.sh"
  "$ROOT/libexec/fa3-secrets-lifecycle.sh"
  "$ROOT/deployment/secrets/fa3-secret-vault.service"
  "$ROOT/deployment/secrets/run-fa3-machine\\x2dstate.mount"
  "$ROOT/deployment/secrets/fa3-secret-broker.service"
  "$ROOT/deployment/secrets/fa3-secrets.target"
  "$ROOT/deployment/secrets/90-fa3-secret-broker-udisks.rules"
)
declare -a DESTS=(
  "/usr/local/lib/fa3/fa3_secret_broker.py"
  "/usr/local/bin/fa3-secretctl"
  "/usr/local/sbin/fa3-secret-vault-init"
  "/usr/local/sbin/fa3-secret-policyctl"
  "/usr/local/sbin/fa3-secret-vault-recovery"
  "/usr/local/sbin/fa3-secret-vault-rekey"
  "/usr/local/bin/fa3-secrets-admin"
  "/usr/local/libexec/fa3-secret-vault-mount"
  "/usr/local/sbin/fa3-secrets-lifecycle"
  "/etc/systemd/system/fa3-secret-vault.service"
  "/etc/systemd/system/run-fa3-machine\\x2dstate.mount"
  "/etc/systemd/system/fa3-secret-broker.service"
  "/etc/systemd/system/fa3-secrets.target"
  "/etc/udev/rules.d/90-fa3-secret-broker-udisks.rules"
)

verify_existing_ownership() {
  python3 - "$MANIFEST" "${SOURCES[@]}" -- "${DESTS[@]}" <<'PY'
import hashlib,json,sys
from pathlib import Path
args=sys.argv[1:]
manifest_path=Path(args[0])
sep=args.index("--")
sources=[Path(x) for x in args[1:sep]]
dests=[Path(x) for x in args[sep+1:]]
if len(sources)!=len(dests):
    raise SystemExit("source/destination cardinality mismatch")
record={}
if manifest_path.is_file():
    doc=json.loads(manifest_path.read_text(encoding="utf-8"))
    record={x["path"]:x["sha256"] for x in doc.get("owned_files",[])}
def digest(p):
    h=hashlib.sha256()
    with p.open("rb") as f:
        for b in iter(lambda:f.read(1024*1024),b""): h.update(b)
    return h.hexdigest()
for src,dst in zip(sources,dests):
    if not src.is_file():
        raise SystemExit(f"missing install source: {src}")
    if not dst.exists():
        continue
    current=digest(dst)
    if str(dst) in record:
        if current != record[str(dst)]:
            raise SystemExit(f"DENY: installed FA3 file drifted outside installer ownership: {dst}")
    elif current != digest(src):
        raise SystemExit(f"DENY: destination exists without FA3 ownership proof and differs from source: {dst}")
PY
}

write_manifest() {
  install -d -m0700 "$MANIFEST_DIR"
  python3 - "$MANIFEST" "${DESTS[@]}" <<'PY'
import datetime,hashlib,json,sys
from pathlib import Path
out=Path(sys.argv[1]); rows=[]
for raw in sys.argv[2:]:
    p=Path(raw)
    if not p.is_file():
        raise SystemExit(f"installed file missing while manifesting: {p}")
    h=hashlib.sha256()
    with p.open("rb") as f:
        for b in iter(lambda:f.read(1024*1024),b""): h.update(b)
    rows.append({"path":str(p),"sha256":h.hexdigest()})
doc={
 "schema":"fa3.secret-broker-install-manifest.v1",
 "component_id":"FA3-SECRET-BROKER-001",
 "owned_files":rows,
 "preserved_data":[
   "/var/lib/fa3/state/fa3-machine-state.img",
   "/etc/fa3/secret-policy.d"
 ],
 "created_at":datetime.datetime.now(datetime.timezone.utc).isoformat()
}
out.write_text(json.dumps(doc,indent=2)+"\n",encoding="utf-8")
PY
  chmod 0600 "$MANIFEST"
}

verify_existing_ownership

getent group fa3-secret-broker >/dev/null || groupadd --system fa3-secret-broker
getent group fa3-secret-clients >/dev/null || groupadd --system fa3-secret-clients
getent group fa3-secret-admin >/dev/null || groupadd --system fa3-secret-admin
if ! getent passwd fa3-secret-broker >/dev/null; then
  useradd --system --gid fa3-secret-broker --groups fa3-secret-clients --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin fa3-secret-broker
fi

install -d -m0700 /var/lib/fa3/state
install -d -o root -g fa3-secret-broker -m0750 /etc/fa3/secret-policy.d
install -d -m0755 /usr/local/lib/fa3
install -m0755 "$ROOT/src/fa3_secret_broker.py" /usr/local/lib/fa3/fa3_secret_broker.py
install -Dm0755 "$ROOT/bin/fa3-secretctl" /usr/local/bin/fa3-secretctl
install -Dm0755 "$ROOT/bin/fa3-secret-vault-init" /usr/local/sbin/fa3-secret-vault-init
install -Dm0755 "$ROOT/bin/fa3-secret-policyctl" /usr/local/sbin/fa3-secret-policyctl
install -Dm0755 "$ROOT/bin/fa3-secret-vault-recovery" /usr/local/sbin/fa3-secret-vault-recovery
install -Dm0755 "$ROOT/bin/fa3-secret-vault-rekey" /usr/local/sbin/fa3-secret-vault-rekey
install -Dm0755 "$ROOT/bin/fa3-secrets-admin" /usr/local/bin/fa3-secrets-admin
install -Dm0755 "$ROOT/libexec/fa3-secret-vault-mount.sh" /usr/local/libexec/fa3-secret-vault-mount
install -Dm0755 "$ROOT/libexec/fa3-secrets-lifecycle.sh" /usr/local/sbin/fa3-secrets-lifecycle
install -Dm0644 "$ROOT/deployment/secrets/fa3-secret-vault.service" /etc/systemd/system/fa3-secret-vault.service
install -Dm0644 "$ROOT/deployment/secrets/run-fa3-machine\\x2dstate.mount" '/etc/systemd/system/run-fa3-machine\x2dstate.mount'
install -Dm0644 "$ROOT/deployment/secrets/fa3-secret-broker.service" /etc/systemd/system/fa3-secret-broker.service
install -Dm0644 "$ROOT/deployment/secrets/fa3-secrets.target" /etc/systemd/system/fa3-secrets.target
install -Dm0644 "$ROOT/deployment/secrets/90-fa3-secret-broker-udisks.rules" /etc/udev/rules.d/90-fa3-secret-broker-udisks.rules
write_manifest

udevadm control --reload-rules
for sysdev in /sys/class/block/dm-*; do
  [[ -r "$sysdev/dm/name" ]] || continue
  dm_name="$(cat "$sysdev/dm/name")"
  case "$dm_name" in
    fa3-machine-state|fa3-machine-state-e2e-*|fa3-sb-e2e-*|fa3-sb-restore-*)
      udevadm trigger --action=change "$sysdev"
      ;;
  esac
done
udevadm settle
systemctl daemon-reload
echo "FA3 credential-vault runtime installed with ownership manifest: $MANIFEST"
