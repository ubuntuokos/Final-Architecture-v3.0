#!/usr/bin/env bash
set -euo pipefail
[[ "$(id -u)" -eq 0 ]] || { echo "Run with sudo/root." >&2; exit 2; }
for c in cryptsetup mkfs.ext4 truncate systemd-creds getent install; do command -v "$c" >/dev/null || { echo "Missing prerequisite: $c" >&2; exit 2; }; done
getent passwd fa3-secret-broker >/dev/null || { echo "fa3-secret-broker service user must exist before initialization" >&2; exit 2; }
IMAGE="${FA3_MACHINE_STATE_IMAGE:-/var/lib/fa3/state/fa3-machine-state.img}"
SIZE_MIB="${FA3_MACHINE_STATE_SIZE_MIB:-256}"
CRED="${FA3_MACHINE_STATE_CREDENTIAL:-/etc/credstore.encrypted/fa3-machine-state-key.cred}"
[[ "$SIZE_MIB" =~ ^[0-9]+$ ]] && ((SIZE_MIB>=128)) || { echo "size must be >=128 MiB" >&2; exit 2; }
[[ ! -e "$IMAGE" ]] || { echo "Image already exists: $IMAGE" >&2; exit 2; }
install -d -m0700 "$(dirname "$IMAGE")" "$(dirname "$CRED")"
read -r -s -p "FA3 machine-state passphrase: " PASS; echo
read -r -s -p "Repeat passphrase: " PASS2; echo
[[ -n "$PASS" && "$PASS" == "$PASS2" ]] || { unset PASS PASS2; echo "Passphrases do not match" >&2; exit 2; }
unset PASS2
truncate -s "$((SIZE_MIB*1024*1024))" "$IMAGE"; chmod 0600 "$IMAGE"
MAPPER="fa3-mstate-init-$$"; MNT="$(mktemp -d)"
cleanup(){ umount "$MNT" >/dev/null 2>&1 || true; cryptsetup close "$MAPPER" >/dev/null 2>&1 || true; rmdir "$MNT" >/dev/null 2>&1 || true; unset PASS || true; }
trap cleanup EXIT INT TERM
printf '%s' "$PASS" | cryptsetup luksFormat --batch-mode --type luks2 --pbkdf argon2id --label FA3_MSTATE --key-file - "$IMAGE"
printf '%s' "$PASS" | cryptsetup open --type luks2 --key-file - "$IMAGE" "$MAPPER"
mkfs.ext4 -q -m 0 -L FA3_MSTATE "/dev/mapper/$MAPPER"
mount -o nodev,nosuid,noexec "/dev/mapper/$MAPPER" "$MNT"
chown fa3-secret-broker:fa3-secret-broker "$MNT"
chmod 0750 "$MNT"
install -d -o fa3-secret-broker -g fa3-secret-broker -m0700 "$MNT/objects"
printf '%s\n' '{"schema":"fa3.secret-index.v1","secrets":{}}' > "$MNT/index.json"
chown fa3-secret-broker:fa3-secret-broker "$MNT/index.json"; chmod 0600 "$MNT/index.json"
sync
printf '%s' "$PASS" | systemd-creds encrypt --with-key=host --name=fa3-machine-state-key - "$CRED" >/dev/null
chmod 0600 "$CRED"; unset PASS
echo "Initialized encrypted FA3 machine-state image: $IMAGE"
echo "Enrolled encrypted systemd credential: $CRED"
