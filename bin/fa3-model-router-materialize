#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CATALOG="${FA3_MODEL_ROUTER_PROVIDER_CATALOG:-}"
ROUTES="$ROOT/deployment/model-router/routes.json"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/fa3-model-router"
CONFIG_OUT="$RUNTIME_DIR/litellm.generated.yaml"
RESOLUTION_OUT="$RUNTIME_DIR/resolution.json"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --catalog) CATALOG="$2"; shift 2;;
    --routes) ROUTES="$2"; shift 2;;
    --runtime-dir) RUNTIME_DIR="$2"; CONFIG_OUT="$2/litellm.generated.yaml"; RESOLUTION_OUT="$2/resolution.json"; shift 2;;
    --config-out) CONFIG_OUT="$2"; shift 2;;
    --resolution-out) RESOLUTION_OUT="$2"; shift 2;;
    *) echo "unknown argument: $1" >&2; exit 3;;
  esac
done
if [[ -z "$CATALOG" ]]; then
  echo "FA3_MODEL_ROUTER_PROVIDER_CATALOG or --catalog is required" >&2
  exit 2
fi
mkdir -p "$(dirname "$CONFIG_OUT")" "$(dirname "$RESOLUTION_OUT")"
chmod 700 "$(dirname "$CONFIG_OUT")" || true
exec env PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
  python3 "$ROOT/src/fa3_model_router_runtime.py" materialize \
  --catalog "$CATALOG" --routes "$ROUTES" --config-out "$CONFIG_OUT" --resolution-out "$RESOLUTION_OUT"
