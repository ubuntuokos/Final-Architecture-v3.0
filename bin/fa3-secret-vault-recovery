#!/usr/bin/env bash
set -euo pipefail
[[ "$(id -u)" -eq 0 ]] || { echo "Run with sudo/root." >&2; exit 2; }

ACTION="${1:-}"
ARG="${2:-}"
IMAGE="${FA3_MACHINE_STATE_IMAGE:-/var/lib/fa3/state/fa3-machine-state.img}"
LIFECYCLE="${FA3_SECRETS_LIFECYCLE:-/usr/local/sbin/fa3-secrets-lifecycle}"
SECRETCTL="${FA3_SECRETCTL:-/usr/local/bin/fa3-secretctl}"

for c in cryptsetup sha256sum cp cmp stat install date python3 grep awk tr mv chmod rm dirname; do
  command -v "$c" >/dev/null || { echo "missing prerequisite: $c" >&2; exit 2; }
done

assert_image(){
  local p="$1"
  [[ -f "$p" && ! -L "$p" ]] || { echo "regular image required: $p" >&2; return 2; }
  cryptsetup isLuks "$p"
  cryptsetup luksDump "$p" | grep -Eq '^Version:[[:space:]]+2$'
}

assert_closed(){
  "$LIFECYCLE" assert-closed
}

assert_non_disclosing_name(){
  local lower_name
  lower_name="$(printf '%s' "${1##*/}" | tr '[:upper:]' '[:lower:]')"
  [[ "$lower_name" != *secret* && "$lower_name" != *credential* && "$lower_name" != *token* && "$lower_name" != *password* && "$lower_name" != *passwd* && "$lower_name" != *auth* && "$lower_name" != *key* ]] || {
    echo "image name must remain generic and non-disclosing" >&2
    return 2
  }
}

backup(){
  assert_closed
  assert_image "$IMAGE"
  local ts dest tmp src_hash dst_hash receipt
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  dest="${ARG:-/var/backups/fa3/fa3-machine-state-${ts}.img}"
  assert_non_disclosing_name "$dest"
  install -d -m0700 "$(dirname "$dest")"
  [[ ! -e "$dest" ]] || { echo "backup destination exists: $dest" >&2; return 2; }
  tmp="${dest}.tmp.$$"
  trap 'rm -f "$tmp"' RETURN
  cp --reflink=never --sparse=always "$IMAGE" "$tmp"
  chmod 0600 "$tmp"
  cmp -s "$IMAGE" "$tmp"
  assert_image "$tmp"
  src_hash="$(sha256sum "$IMAGE" | awk '{print $1}')"
  dst_hash="$(sha256sum "$tmp" | awk '{print $1}')"
  [[ "$src_hash" == "$dst_hash" ]] || { echo "backup hash mismatch" >&2; return 2; }
  mv "$tmp" "$dest"
  receipt="${dest}.receipt.json"
  python3 - "$receipt" "$dest" "$dst_hash" <<'PY'
import json,sys
from datetime import datetime,timezone
from pathlib import Path
Path(sys.argv[1]).write_text(json.dumps({
  "schema":"fa3.machine-state-backup-receipt.v1",
  "created_at":datetime.now(timezone.utc).isoformat(),
  "backup_path":sys.argv[2],
  "encrypted_image_sha256":sys.argv[3],
  "luks2":True,
  "secret_values_collected":False,
  "vault_closed_during_backup":True
},indent=2)+"\n")
PY
  chmod 0600 "$receipt"
  echo "$dest"
}

restore(){
  [[ -n "$ARG" ]] || { echo "restore requires backup image path" >&2; return 2; }
  assert_closed
  assert_non_disclosing_name "$ARG"
  assert_image "$ARG"
  local state_dir rollback tmp old_hash new_hash receipt ts
  state_dir="$(dirname "$IMAGE")"
  install -d -m0700 "$state_dir"
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  rollback="${state_dir}/.fa3-machine-state-pre-restore-${ts}.img"
  tmp="${state_dir}/.fa3-machine-state-restore.$$"
  old_hash=""
  cleanup_restore(){
    local rc=$?
    "$LIFECYCLE" exit >/dev/null 2>&1 || true
    rm -f "$tmp"
    if (( rc != 0 )) && [[ -f "$rollback" ]]; then
      mv -f "$rollback" "$IMAGE"
      chmod 0600 "$IMAGE"
      "$LIFECYCLE" assert-closed >/dev/null 2>&1 || true
    fi
    exit "$rc"
  }
  trap cleanup_restore ERR INT TERM
  if [[ -f "$IMAGE" ]]; then
    assert_image "$IMAGE"
    old_hash="$(sha256sum "$IMAGE" | awk '{print $1}')"
    mv "$IMAGE" "$rollback"
  fi
  cp --reflink=never --sparse=always "$ARG" "$tmp"
  chmod 0600 "$tmp"
  assert_image "$tmp"
  mv "$tmp" "$IMAGE"
  "$LIFECYCLE" start
  "$SECRETCTL" health >/dev/null
  "$LIFECYCLE" exit
  "$LIFECYCLE" assert-closed
  new_hash="$(sha256sum "$IMAGE" | awk '{print $1}')"
  receipt="/var/lib/fa3/state/fa3-machine-state-restore-${ts}.receipt.json"
  python3 - "$receipt" "$ARG" "$old_hash" "$new_hash" <<'PY'
import json,sys
from datetime import datetime,timezone
from pathlib import Path
Path(sys.argv[1]).write_text(json.dumps({
  "schema":"fa3.machine-state-restore-receipt.v1",
  "tested_at":datetime.now(timezone.utc).isoformat(),
  "backup_path":sys.argv[2],
  "previous_encrypted_image_sha256":sys.argv[3] or None,
  "restored_encrypted_image_sha256":sys.argv[4],
  "luks2":True,
  "broker_health_result":"PASS",
  "final_vault_state":"CLOSED",
  "secret_values_collected":False
},indent=2)+"\n")
PY
  chmod 0600 "$receipt"
  rm -f "$rollback"
  trap - ERR INT TERM
  echo "$receipt"
}

case "$ACTION" in
  backup) backup;;
  restore) restore;;
  *) echo "usage: $0 backup [destination.img] | restore <backup.img>" >&2; exit 2;;
esac
