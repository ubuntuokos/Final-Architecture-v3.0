        "VOICE_STYLE_OPTIONAL"
      ]
    },
    "STANDARD": {
      "hosts": [
        "fa3.video-editor",
        "fa3.story-screenplay",
        "fa3.unified-messenger"
      ],
      "actions": [
        "voice.generate.submit",
        "voice.generate.dispatch",
        "voice.fit-to-clip.plan",
        "voice.quick-dub.plan",
        "voice.timeline.insert",
        "voice.capture",
        "voice.transcribe",
        "voice.status"
      ],
      "ai_features": [
        "TTS",
        "STT",
        "TRANSLATION_OPTIONAL",
        "VOICE_STYLE_OPTIONAL"
      ]
    },
    "ADVANCED": {
