{
  "schema": "fa3.convertx-conversion-allowlist.v1",
  "id": "FA3-CONVERTX-CONVERSION-ALLOWLIST-001",
  "provider_id": "FA3-PROVIDER-CONVERTX-001",
  "profile_id": "FA3-FILE-CONVERSION-001",
  "status": "CANONICAL",
  "default_policy": "DENY",
  "activation_policy": "PAIR_REQUIRES_PROVIDER_PROMOTION_AND_CURRENT_HOST_EVIDENCE",
  "candidate_pairs": [
