    {"from": "image/jpeg", "to": "image/png", "converter_family": "ImageMagick_or_Vips", "state": "CANDIDATE"},
    {"from": "video/mp4", "to": "video/webm", "converter_family": "FFmpeg", "state": "CANDIDATE"},
    {"from": "audio/wav", "to": "audio/flac", "converter_family": "FFmpeg", "state": "CANDIDATE"},
    {"from": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "to": "application/pdf", "converter_family": "LibreOffice", "state": "CANDIDATE"},
    {"from": "text/markdown", "to": "text/html", "converter_family": "Pandoc", "state": "CANDIDATE"},
    {"from": "model/obj", "to": "model/gltf+json", "converter_family": "Assimp", "state": "CANDIDATE"}
  ],
  "explicit_denials": [
    {
      "converter_family": "XeLaTeX",
      "input_extensions": ["tex", "ltx", "latex"],
      "reason": "Arbitrary local file read risk through TeX input primitives remains unacceptable for the FA3 trust boundary."
    },
    {
      "converter_family": "ANY",
      "pair": "UNKNOWN",
      "reason": "Unknown conversion pairs fail closed."
    }
  ],
  "arbitrary_converter_name_allowed": false,
  "arbitrary_converter_arguments_allowed": false,
  "fail_closed": true
