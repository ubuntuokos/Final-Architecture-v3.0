{
  "schema": "fa3.openhands-current-host-enforcement.v1",
  "id": "FA3-OPENHANDS-CURRENT-HOST-GATESET-001",
  "gate_id": "FA3-GATE-OPENHANDS-CURRENT-HOST-001",
  "provider_id": "FA3-PROVIDER-OPENHANDS-001",
  "runtime_conformance_id": "FA3-OPENHANDS-RUNTIME-CONFORMANCE-001",
  "fail_closed": true,
  "current_host_only": true,
  "production_pass_requires_real_model_route": true,
  "fixture_runtime_smoke_cannot_promote_production": true,
  "current_host_receipts_must_not_be_fabricated_by_ci": true,
  "rules": [
    "OPENHANDS_HOST_SOURCE_PIN_MATCH",
    "OPENHANDS_HOST_COMPONENT_VERSION_TUPLE_MATCH",
    "OPENHANDS_HOST_PYTHON_VENV_NO_CONDA",
    "OPENHANDS_HOST_BWRAP_ISOLATION",
    "OPENHANDS_HOST_READ_ONLY_ROOT_AND_BOUNDED_RW_WORKSPACE",
    "OPENHANDS_HOST_NO_GENERAL_NETWORK_EGRESS",
    "OPENHANDS_HOST_MODEL_ROUTE_VIA_UNIX_BRIDGE",
    "OPENHANDS_HOST_SECRET_REDACTION_AND_NON_PERSISTENCE",
    "OPENHANDS_HOST_EXTERNAL_TOOL_AUTH_RECEIPT_REQUIRED_FOR_PRODUCTION",
    "OPENHANDS_HOST_DIRECT_EXECUTE_TOOL_NOT_USED",
    "OPENHANDS_HOST_PROVIDER_MCP_DISABLED",
    "OPENHANDS_HOST_EXACT_MUTATION_SCOPE",
    "OPENHANDS_HOST_NO_WORKER_COMMIT",
    "OPENHANDS_HOST_EVENT_LINEAGE_PRESENT",
    "OPENHANDS_HOST_CRASH_RESUME_EVIDENCE",
    "OPENHANDS_HOST_NEGATIVE_SCOPE_REFUSAL",
    "OPENHANDS_HOST_NEGATIVE_AUTH_REFUSAL",
    "OPENHANDS_HOST_CLEANUP_COMPLETE",
    "OPENHANDS_HOST_PRODUCTION_MODEL_RESPONSE_PRESENT",
    "OPENHANDS_HOST_REFERENCE_FIXTURE_CANNOT_CLAIM_PRODUCTION"
  ],
  "executable_gate": "./bin/fa3-enforce openhands-current-host",
  "report_path": "reports/openhands-current-host-gate-report.json"
}
