{
  "id": "FA3-EXTENSION-BOUNDARY-001",
  "schema": "fa3.extension-boundary.v1",
  "status": "CANONICAL",
  "purpose": "Permit provider/extension growth without bypassing capability or architectural-authority accounting.",
  "default_disposition": "DENY_UNCLASSIFIED_EXTENSION",
  "classes": {
    "CAPABILITY_NEUTRAL": {
      "description": "Implements, composes, or exposes only existing canonical capabilities and creates no new architectural authority.",
      "requirements": [
        "existing_capability_ids_required",
        "new_capabilities_must_equal_zero",
        "new_architectural_authorities_must_equal_zero",
        "privileged_actions_must_be_owned_by_existing_canonical_authority",
        "provider_must_not_own_device_selection_or_model_routing_authority",
        "runtime_and_security_evidence_required_before_promotion"
      ],
      "capability_count_effect": 0
    },
    "CAPABILITY_CHANGING": {
      "description": "Introduces a new user-visible capability, new autonomous decision right, new privileged action ownership, or new architectural authority.",
      "requirements": [
        "release_baseline_update_required",
        "capability_registry_reconciliation_required",
        "authority_graph_reconciliation_required",
        "evidence_registry_reconciliation_required",
        "explicit_canonical_decision_required"
      ],
      "capability_count_effect": "RECONCILE"
    }
  },
  "classification_rules": {
    "new_user_visible_capability": "CAPABILITY_CHANGING",
    "new_autonomous_decision_right": "CAPABILITY_CHANGING",
    "new_privileged_action_owner": "CAPABILITY_CHANGING",
    "new_architectural_authority": "CAPABILITY_CHANGING",
    "alternative_provider_for_existing_capability": "CAPABILITY_NEUTRAL",
    "composition_of_existing_capabilities_without_new_authority": "CAPABILITY_NEUTRAL",
    "ui_projection_of_existing_capability_without_new_authority": "CAPABILITY_NEUTRAL"
  },
  "invariants": [
    "PLUGIN_LABEL_MUST_NOT_BYPASS_CAPABILITY_ACCOUNTING",
    "EXTENSION_LABEL_MUST_NOT_BYPASS_AUTHORITY_ACCOUNTING",
    "UNCLASSIFIED_EXTENSION_FAILS_CLOSED",
    "CAPABILITY_NEUTRAL_REQUIRES_EXPLICIT_EXISTING_CAPABILITY_BINDINGS"
  ]
}
