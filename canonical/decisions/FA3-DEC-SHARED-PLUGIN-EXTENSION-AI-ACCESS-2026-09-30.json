{
  "schema": "fa3.architecture-decision.v1",
  "id": "FA3-DEC-SHARED-PLUGIN-EXTENSION-AI-ACCESS-2026-09-30",
  "date": "2026-09-30",
  "status": "MATERIALIZED_PENDING_CURRENT_HOST",
  "approved_architecture": "SHARED_PLUGIN_EXTENSION_FABRIC_WITH_SCOPED_AI_TOGGLES",
  "rationale": [
    "Plugins and extensions are reusable capability providers rather than application-owned islands.",
    "Any compatible FA3 application must be able to opt into a component that adds capability.",
    "AI access must remain explicitly controllable and must not become a hidden dependency."
  ],
  "decisions": {
    "plugin_and_extension_shared": true,
    "capability_based_binding": true,
    "explicit_activation": true,
    "ai_toggle_levels": [
      "GLOBAL",
      "APPLICATION",
      "MODULE",
      "COMPONENT",
      "CAPABILITY"
    ],
    "global_ai_off_non_overridable": true,
    "external_component_ai_default": "DISABLED",
    "model_router_only": true,
    "direct_provider_access": false,
    "silent_fallback": false,
    "retroactive_reconciliation": true,
    "capability_loss_allowed": false
  },
  "baseline": {
    "capability_count_before": 175,
    "capability_count_after": 175,
    "new_capabilities": 0,
    "new_architectural_authorities": 0
  }
}
