    "GEM_X_AS_EXCLUSIVE_MOCAP_ENGINE",
    "APACHE_SOURCE_LICENSE_AS_SUBSTITUTE_FOR_GEM_X_MODEL_LICENSE",
    "UNPINNED_HUGGINGFACE_MODEL_DOWNLOAD",
    "RUNTIME_NETWORK_FETCH",
    "IMPLICIT_DISPLAY_GPU_SELECTION",
    "AUTOMATIC_CPU_GPU_PROVIDER_OR_CLOUD_FALLBACK",
    "DOCUMENT_ONLY_RUNTIME_PROMOTION"
  ],
