{
  "schema": "fa3.app-lifecycle.v1",
  "id": "FA3-APP-LIFECYCLE-001",
  "name": "Curated Lazy Application Provisioning",
  "status": "CANONICAL",
  "priority": "P0",
  "scope": "FA3 AI Studio and optional application providers",
  "decision": "CURATED_FIRST_USE_PROVISIONING",
  "base_install": {
    "optional_applications_installed_with_fa3": false,
    "catalog_metadata_installed_with_fa3": true,
    "provisioning_runtime_installed_with_fa3": true
  },
  "admission_boundary": {
    "catalog_is_allowlist": true,
    "catalog_entry_requires_approved_admission": true,
    "user_supplied_install_source_allowed": false,
    "install_from_url_allowed": false,
    "github_search_to_install_allowed": false,
    "direct_shell_install_from_gui_allowed": false,
    "unknown_application_fails_closed": true
  },
  "installation": {
    "default_mode": "FIRST_USE",
    "explicit_install_allowed_for_catalog_entries": true,
    "confirmation_required_before_materialization": true,
    "provider_recipe_required": true,
    "provider_recipe_must_be_repository_controlled": true,
    "shell_execution": false,
    "privilege_escalation_must_be_explicit": true
  },
  "first_use_flow": [
    "catalog_admission_check",
    "compatibility_check",
    "user_confirmation",
    "provider_recipe_resolution",
    "dependency_preflight",
    "materialization",
    "security_validation",
    "registration",
    "launch"
  ],
  "states": [
    "AVAILABLE",
    "READY_TO_INSTALL",
    "INSTALLING",
    "INSTALLED",
    "INCOMPATIBLE",
    "RECIPE_REQUIRED",
    "ERROR"
  ],
  "failure_policy": {
    "missing_catalog_entry": "DENY",
    "missing_provider_recipe": "DENY",
    "failed_preflight": "DENY",
    "failed_security_validation": "DENY",
    "unapproved_source": "DENY"
  },
  "supersedes": [
    "eager installation of optional AI Studio applications"
  ],
  "governance_decisions": [
    "FA3-DEC-DONOR-LIFECYCLE-APPLICATION-SYNC-2026-09-30"
  ],
  "development_reconciliation": {
    "applies_to_every_catalog_application": true,
    "formal_dependency_declaration_required_for_scope": false,
    "declared_and_implicit_dependencies_reconciled": true,
    "affected_layers_reconciled": true,
    "donor_change_processing_required": true,
    "donor_usage_reverse_traceability_required": true,
    "capability_non_regression_on_donor_change": true,
    "capability_loss_only_for_verified_fa3_risk": true,
    "current_host_alignment_required_for_structural_or_runtime_change": true,
    "tests_gates_evidence_and_release_projection_reconciled": true,
    "application_gui_design_reconciliation_required": true,
    "retroactive_gui_audit_required": true,
    "gui_functional_revision_sync_required": true,
    "fa3_design_system_compliance_required": true,
    "gui_placement_owner_approval_required": true,
    "exceptions_allowed": false
  },
  "application_gui_governance": {
    "policy_id": "FA3-APPLICATION-GUI-DESIGN-POLICY-001",
    "design_record_schema": "canonical/contracts/FA3-APPLICATION-GUI-DESIGN-RECORD-001.schema.json",
    "retroactive_audit_id": "FA3-APPLICATION-GUI-RETROACTIVE-AUDIT-001",
    "applies_to_every_fa3_application": true,
    "lifecycle_states": ["PLANNED", "IN_PROGRESS", "MATERIALIZED", "UPDATED", "FUTURE"],
    "retroactive": true,
    "grandfathering_allowed": false,
    "gui_classifications": ["GUI_REQUIRED", "GUI_POSSIBLE", "HEADLESS_ONLY"],
    "gui_required_or_possible_design_mandatory": true,
    "headless_only_justification_required": true,
    "fa3_global_gui_placement_required": true,
    "application_local_gui_placement_required": true,
    "exact_application_local_placement_owner_approval_required": true,
    "finalization_without_required_placement_approval_forbidden": true,
    "functional_delta_gui_impact_assessment_required": true,
    "gui_update_or_redesign_required_when_functional_delta_requires_it": true,
    "removed_function_orphan_gui_forbidden": true,
    "fa3_design_system_required": true,
    "independent_application_design_system_forbidden": true,
    "manual_gui_sync_required": true
  },
  "donor_lifecycle": {
    "monthly_capability_refresh_days": 31,
    "security_change_propagation": "IMMEDIATE",
    "unsafe_donor_active_registry": "FORBIDDEN",
    "unsafe_donor_replacement": [
      "FA3_NATIVE_REMATERIALIZATION",
      "VERIFIED_FUNCTIONALLY_EQUIVALENT_DONOR"
    ],
    "stalled_used_donor": "LOCK_LAST_VERIFIED_STABLE_THEN_REPLACE_OR_REMATERIALIZE",
    "rejected_reentry": "VERIFIED_SAFE_EVIDENCE_REQUIRED"
  }
}
