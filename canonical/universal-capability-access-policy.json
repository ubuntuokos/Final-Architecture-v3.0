{
  "schema": "fa3.universal-capability-access-policy.v1",
  "id": "FA3-UNIVERSAL-CAPABILITY-ACCESS-POLICY-001",
  "status": "CANONICAL_FAIL_CLOSED",
  "date": "2026-10-03",
  "capability_count": 175,
  "new_capability": false,
  "new_architectural_authority": false,
  "authority_binding": "FA3-AUTH-SECURITY-GOV-001",
  "license_rights_authority_binding": "FA3-LICENSE-RIGHTS-001",
  "donor_registry_binding": "FA3-DONOR-REFERENCE-REGISTRY-001",
  "principle": "FA3 MUST NOT MAKE A USER-FACING CAPABILITY DEPEND EXCLUSIVELY ON A THIRD-PARTY COMPONENT WHOSE UPSTREAM TERMS, SERVICE ACCESS, PLATFORM OR HARDWARE REQUIREMENTS EXCLUDE A USER GROUP. RESTRICTED DONORS MAY REMAIN REFERENCES OR OPTIONAL IMPLEMENTATIONS, BUT MATERIAL ADOPTION REQUIRES A GLOBALLY USABLE FA3-NATIVE OR INDEPENDENTLY RIGHTS-CLEARED SUBSTITUTE.",
  "scope": {
    "retroactive": true,
    "all_current_donor_records": true,
    "all_future_donor_records": true,
    "all_material_usage_edges": true,
    "all_user_facing_capabilities": true,
    "applies_to": [
      "CODE",
      "MODEL",
      "WEIGHTS",
      "DATASET",
      "ASSET",
      "SDK",
      "BINARY",
      "SERVICE",
      "PROVIDER",
      "RUNTIME",
      "ENGINE",
      "HARDWARE_BACKEND"
    ]
  },
  "access_barrier_classes": [
    "GEOGRAPHIC_OR_TERRITORIAL",
    "NATIONALITY_OR_RESIDENCY",
    "NONCOMMERCIAL_OR_RESEARCH_ONLY",
    "FIELD_OF_USE_OR_SCALE",
    "PROPRIETARY_OR_PAID",
    "MANDATORY_SERVICE_ACCOUNT_OR_ENTITLEMENT",
    "MANDATORY_CLOUD",
    "MANDATORY_VENDOR_OR_HARDWARE",
    "MANDATORY_PLATFORM",
    "UNKNOWN_OR_UNVERIFIED_RIGHTS"
  ],
  "baseline_requirements": {
    "donor_imposed_geographic_exclusion_as_sole_dependency_forbidden": true,
    "donor_imposed_noncommercial_exclusion_as_sole_dependency_forbidden": true,
    "mandatory_paid_cloud_as_sole_dependency_forbidden": true,
    "mandatory_vendor_hardware_as_sole_dependency_forbidden": true,
    "unknown_access_rights_fail_closed_for_material_adoption": true,
    "restricted_reference_registration_allowed": true,
    "restricted_optional_implementation_allowed_only_with_global_equivalent": true,
    "cpu_only_baseline_preserved_where_computationally_meaningful": true,
    "no_silent_provider_model_device_or_cloud_fallback": true,
    "capability_baseline_must_not_decrease": true
  },
  "restricted_donor_rule": {
    "reference_and_functional_analysis": "ALLOWED_ONLY_TO_EXTENT_RIGHTS_PERMIT",
    "material_adoption": "BLOCKED_UNTIL_GLOBAL_SUBSTITUTE_AND_NORMAL_ADMISSION_PASS",
    "may_be_global_baseline": false,
    "may_be_only_implementation": false,
    "capability_disposition": "GLOBAL_SUBSTITUTE_REQUIRED"
  },
  "global_substitute_order": [
    "EXISTING_RIGHTS_CLEARED_GLOBAL_DONOR",
    "COMBINATION_OF_RIGHTS_CLEARED_GLOBAL_DONORS",
    "FA3_NATIVE_IMPLEMENTATION_FROM_RIGHTS_CLEARED_COMPONENTS",
    "CLEAN_FA3_REEXPRESSION_WHEN_LEGALLY_PERMITTED",
    "NEW_OWNER_MARKED_DONOR_INTAKE"
  ],
  "clean_reimplementation_boundary": {
    "license_or_terms_circumvention_forbidden": true,
    "proxy_vpn_foreign_host_or_artifact_relocation_to_EVADE_RESTRICTION_forbidden": true,
    "restricted_source_code_copy_forbidden_without_rights_clearance": true,
    "restricted_model_weight_copy_forbidden_without_rights_clearance": true,
    "restricted_dataset_or_output_training_use_forbidden_when_upstream_terms_prohibit_it": true,
    "independent_functional_specification_required": true,
    "independent_implementation_and_provenance_required": true,
    "patent_and_other_ip_review_remains_separate": true
  },
  "selector_rule": {
    "capability_visibility_must_not_depend_on_restricted_provider": true,
    "provider_visibility_may_reflect_current_legal_entitlement": true,
    "restricted_provider_unavailability_must_not_remove_capability": true,
    "restricted_provider_selection_must_fail_closed": true,
    "global_equivalent_must_remain_user_selectable": true
  },
  "fail_closed": {
    "material_usage_without_universal_access_evidence": true,
    "restricted_material_usage_without_global_substitute": true,
    "unknown_material_access_rights": true,
    "attempted_restriction_circumvention": true,
    "capability_available_only_through_restricted_dependency": true
  }
}
