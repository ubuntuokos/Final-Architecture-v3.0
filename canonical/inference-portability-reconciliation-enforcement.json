  "rules": [
    {
      "invariant": "INFERENCE_ACCELERATOR_CARDINALITY_0_TO_N_AND_CPU_ONLY_CONFORMANT",
      "priority": "P0",
      "mandatory": true,
      "description": "Inference portability must preserve the vendor-neutral 0..N accelerator baseline and valid CPU-only hosts."
    },
    {
      "invariant": "INFERENCE_ACCELERATOR_BACKEND_MUST_BE_DEVICE_BOUND_AND_AVAILABLE",
      "priority": "P0",
      "mandatory": true,
      "description": "Accelerator execution requires a DEVICE-bound, detected, available and compatible backend; HOST_UNBOUND cannot authorize execution."
    },
    {
      "invariant": "INFERENCE_HRB_LEASE_BINDS_EXACT_ACCELERATOR_EXECUTION_PATH",
      "priority": "P0",
      "mandatory": true,
      "description": "The HRB lease must bind the selected accelerator identity and execution path rather than a runtime ordinal or provider guess."
    },
    {
      "invariant": "INFERENCE_BACKEND_DISAPPEARANCE_INVALIDATES_LEASE_AND_DERIVED_ARTIFACTS",
      "priority": "P0",
      "mandatory": true,
      "description": "Backend/topology drift invalidates the affected lease and derived engine/cache reuse until re-admission."
    },
    {
      "invariant": "INFERENCE_NO_SILENT_DEVICE_BACKEND_OR_TRANSLATION_SUBSTITUTION",
      "priority": "P0",
      "mandatory": true,
      "description": "Device, backend and translation-layer substitutions are explicit policy decisions and never silent fallback."
    },
    {
      "invariant": "INFERENCE_PROVIDER_SPECIFIC_HARDWARE_FIELDS_ARE_PROVIDER_SCOPED_ONLY",
      "priority": "P0",
      "mandatory": true,
      "description": "CUDA/SM/GPU SKU/ROCm/Level Zero/NPU fields are provider-scoped compatibility data, not global hardware requirements."
    },
    {
      "invariant": "INFERENCE_MODEL_ROUTER_REMAINS_LOGICAL_MODEL_PROVIDER_ROUTING_AUTHORITY",
      "priority": "P0",
      "mandatory": true,
      "description": "Inference portability cannot create model/provider routing authority; it consumes canonical Model Router resolution."
    },
    {
      "invariant": "INFERENCE_EXECUTION_PROVIDER_DOES_NOT_EXPAND_AI_PARTICIPANT_SET",
      "priority": "P0",
      "mandatory": true,
      "description": "Execution providers and backend changes are not AI participants and cannot expand the app's authorized participant set."
    },
    {
      "invariant": "INFERENCE_AGENT_NATIVE_INVOCATION_REQUIRES_TYPED_UAF_ACTION",
      "priority": "P0",
      "mandatory": true,
      "description": "Agent-initiated inference requires the canonical Unified Action Fabric typed action envelope and attributable receipt."
    },
    {
      "invariant": "INFERENCE_AGENT_NATIVE_CANNOT_BYPASS_ROUTER_HRB_SECURITY_OR_PROVIDER_ADAPTER",
      "priority": "P0",
      "mandatory": true,
      "description": "Agent Native cannot call a provider directly around Model Router, HRB, security policy or provider adapter boundaries."
