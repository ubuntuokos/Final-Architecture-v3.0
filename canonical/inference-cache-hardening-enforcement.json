      "invariant": "TENSORRT_RTX_RUNTIME_CACHE_IDENTITY_REQUIRED",
      "priority": "P0",
      "mandatory": true,
      "description": "TensorRT-RTX runtime-cache identity must include GPU SKU, TensorRT-RTX version, CUDA-context CiG state and cache-origin NVIDIA driver version."
    },
    {
      "invariant": "TENSORRT_RTX_RUNTIME_CACHE_DRIVER_MONOTONIC_COMPATIBILITY",
      "priority": "P0",
      "mandatory": true,
      "description": "Runtime driver must be greater than or equal to the cache-origin driver; GPU SKU, TensorRT-RTX version and CiG state must satisfy upstream cache compatibility before reuse is claimed."
    },
    {
      "invariant": "TENSORRT_RTX_RUNTIME_CACHE_MISS_JIT_REBUILD_OBSERVABLE",
      "priority": "P0",
      "mandatory": true,
      "description": "Transparent cache rejection and JIT recompilation must be observable through logs or profiling and recorded in a runtime-cache use receipt."
    },
    {
      "invariant": "TENSORRT_RTX_STEADY_STATE_BENCHMARK_SEPARATES_JIT_WARMUP",
      "priority": "P0",
      "mandatory": true,
      "description": "First-inference JIT compilation latency must be separated from steady-state cache-hit benchmarking and promotion evidence."
