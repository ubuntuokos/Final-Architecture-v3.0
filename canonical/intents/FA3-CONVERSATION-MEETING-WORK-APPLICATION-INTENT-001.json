    "fa3.decision.classify",
    "fa3.knowledge.link"
  ],
  "problem_classes": [
    "conversation-to-work",
    "meeting-to-work",
    "group-meeting",
    "mind-map-projection",
    "task-extraction",
    "decision-extraction",
    "work-plan",
    "meeting-minutes",
    "speaker-attribution",
    "human-approval"
  ],
  "input_modalities": [
    "TEXT",
    "AUDIO_TRANSCRIPT",
    "VIDEO_TRANSCRIPT",
    "STRUCTURED_EVENT",
    "ARTIFACT_REFERENCE"
