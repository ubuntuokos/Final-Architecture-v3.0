  ],
  "task_classes": [
    "MEETING_REVIEW",
    "WORK_EXTRACTION",
    "ACTION_ITEM_REVIEW",
    "FOLLOW_UP_PLANNING"
  ],
  "skill_triggers": [],
  "hardware_audit": {
    "vendor_neutral": true,
    "cpu_only_viable": true,
    "accelerator_cardinality": "0..N",
