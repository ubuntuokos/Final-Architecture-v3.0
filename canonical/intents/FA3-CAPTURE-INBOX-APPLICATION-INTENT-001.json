  "namespace_claims": {
    "package_prefix": "fa3-capture-inbox",
    "config_root": "$XDG_CONFIG_HOME/fa3/capture-inbox",
    "cache_root": "$XDG_CACHE_HOME/fa3/capture-inbox",
    "data_root": "$XDG_DATA_HOME/fa3/capture-inbox",
    "runtime_root": "$XDG_RUNTIME_DIR/fa3/capture-inbox",
    "requires_upstream_uninstall": false,
    "global_environment_mutation": false,
    "claims_default_port": false,
    "systemd_unit_prefix": "fa3-capture-inbox-"
