    "shared-ai-composition",
    "knowledge-retrieval",
    "multimodal-source-normalization",
    "conversation-session-interchange",
    "tool-action-mediation",
    "cross-application-reuse"
  ],
  "input_modalities": [
    "TEXT",
    "DOCUMENT",
    "IMAGE",
    "AUDIO",
    "VIDEO",
    "TYPED_ACTION_INTENT"
  ],
  "output_modalities": [
    "AI_INTERACTION_RESULT",
    "RETRIEVAL_RESULT",
    "MULTIMODAL_CONTEXT",
    "SESSION_EVENT",
    "ACTION_RECEIPT"
  ],
  "execution_classes": [
    "STATIC_CONTRACT_AND_MAPPING"
  ],
  "proposed_authority_roles": [],
  "declared_new_capabilities": [],
  "declared_gaps": [],
