{
  "schema": "fa3.application-intent.v1",
  "id": "FA3-OSINT-ARSENAL-CATALOG-APPLICATION-INTENT-001",
  "project_id": "FA3-OSINT-ARSENAL-CATALOG-001",
  "project_type": "DERIVED_IMPLEMENTATION",
  "goal": "Pin and normalize the existing Awesome OSINT Arsenal donor's machine-readable catalog as a non-executing offline source for the existing Donor & Reference Registry, Reuse Discovery and CAP-053/CAP-054 planning, without admitting downstream tools.",
  "required_capabilities": [
    "CAP-053",
    "CAP-054"
  ],
  "optional_capabilities": [
    "CAP-035",
    "CAP-051",
    "CAP-103"
  ],
  "problem_classes": [
    "osint",
    "source-catalog",
    "reconnaissance-reference",
    "provenance",
    "metadata-only",
    "deduplication"
  ],
  "input_modalities": [
    "JSON"
  ],
  "output_modalities": [
    "JSON"
  ],
  "execution_classes": [
    "CPU_ONLY"
  ],
  "proposed_authority_roles": [],
  "declared_new_capabilities": [],
  "declared_gaps": [
    "PINNED_SOURCE_NORMALIZATION",
    "PER_TOOL_LICENSE_REVIEW",
    "DOWNSTREAM_PROVIDER_ADMISSION",
    "CURRENT_HOST_PROOF_FOR_FUTURE_RUNTIME_ADAPTERS"
  ],
  "security_requirements": [
    "NO_SOURCE_SCRIPT_EXECUTION",
    "NO_NETWORK_DURING_IMPORT",
    "NO_AUTOMATIC_PROVIDER_ADMISSION",
    "NO_INHERITED_DOWNSTREAM_LICENSE",
    "NO_UNSCOPED_PEOPLE_SEARCH",
    "FAIL_CLOSED_SOURCE_PIN_AND_DUPLICATE_CHECK"
  ],
  "integration_requirements": [
    "FA3-REUSE-DISCOVERY-001",
    "FA3-DONOR-REFERENCE-REGISTRY-001",
    "FA3-EVIDENCE-ENVELOPE-001",
    "FA3-HARDWARE-BASELINE-001"
  ],
  "hardware_audit": {
    "vendor_neutral": true,
    "cpu_only_viable": true,
    "accelerator_cardinality": "0..N",
    "global_accelerator_requirement": false,
    "live_discovery_authority": "FA3-AUTH-HOST-RESOURCE-BROKER-001"
  },
  "namespace_claims": {
    "package_prefix": "fa3-osint-arsenal-catalog",
    "service_prefix": "fa3-osint-arsenal-catalog",
    "config_root": "$XDG_CONFIG_HOME/fa3/osint-arsenal-catalog",
    "cache_root": "$XDG_CACHE_HOME/fa3/osint-arsenal-catalog",
    "runtime_root": "$XDG_RUNTIME_DIR/fa3/osint-arsenal-catalog",
    "socket_namespace": "fa3/osint-arsenal-catalog",
    "data_root": "$XDG_DATA_HOME/fa3/osint-arsenal-catalog",
    "desktop_prefix": "org.fa3.osint.arsenal.catalog",
    "requires_upstream_uninstall": false,
    "global_environment_mutation": false,
    "claims_default_port": false
  }
}
