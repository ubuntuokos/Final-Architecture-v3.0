{
  "schema": "fa3.application-intent.v1",
  "id": "FA3-KHRONOS-OPEN-STANDARDS-APPLICATION-INTENT-001",
  "project_id": "FA3-KHRONOS-OPEN-STANDARDS-001",
  "project_type": "PROFILE",
  "goal": "Materialize the Khronos open-standard SDK set required by existing CAP-083 and integrate it into the existing HRB, Shader, Asset, Render, XR, Compute, Vision and Model Artifact fabrics without authority transfer or host interference.",
  "required_capabilities": [
    "CAP-083",
    "CAP-146",
    "CAP-147",
    "CAP-175"
  ],
  "optional_capabilities": [],
  "problem_classes": [
    "open-standard-graphics-compute-xr-3d",
    "shader-ir-validation",
    "3d-asset-interchange",
    "vendor-neutral-runtime-boundaries"
  ],
  "task_classes": [
    "sdk-materialization",
    "capability-discovery",
    "interchange-validation",
    "provider-adapter-integration"
  ],
  "skill_triggers": [],
  "input_modalities": [
    "UPSTREAM_SOURCE",
    "HOST_CAPABILITY_OBSERVATION",
    "ASSET",
    "SHADER_MODULE"
  ],
  "output_modalities": [
    "SDK_MATERIALIZATION_RECEIPT",
    "VALIDATION_RESULT",
    "ADAPTER_DESCRIPTOR"
  ],
  "execution_classes": [
    "CPU_ONLY",
    "OPTIONAL_ACCELERATOR"
  ],
  "proposed_authority_roles": [],
  "declared_new_capabilities": [],
  "declared_gaps": [
    "PHYSICAL_CURRENT_HOST_SOURCE_MATERIALIZATION_PENDING",
    "COMPILED_SDK_RUNTIME_EVIDENCE_PENDING"
  ],
  "hardware_audit": {
    "vendor_neutral": true,
    "cpu_only_viable": true,
    "accelerator_cardinality": "0..N",
    "global_accelerator_requirement": false,
    "live_discovery_authority": "FA3-AUTH-HOST-RESOURCE-BROKER-001",
    "hardware_safety_envelope_required": true
  },
  "namespace_claims": {
    "package_prefix": "fa3-khronos",
    "service_prefix": "fa3-khronos",
    "config_root": "$XDG_CONFIG_HOME/fa3/khronos",
    "cache_root": "$XDG_CACHE_HOME/fa3/khronos",
    "runtime_root": "$XDG_RUNTIME_DIR/fa3/khronos",
    "socket_namespace": "fa3/khronos",
    "data_root": "$XDG_DATA_HOME/fa3/khronos-sdk",
    "desktop_prefix": "org.fa3.khronos",
    "requires_upstream_uninstall": false,
    "global_environment_mutation": false,
    "claims_default_port": false
  },
  "integration_requirements": [
    "FA3-REUSE-DISCOVERY-001",
    "FA3-HARDWARE-BASELINE-001",
    "FA3-AUTH-HOST-RESOURCE-BROKER-001",
    "FA3-AUTH-OBS-EVIDENCE-001",
    "FA3-DISTRIBUTION-COMPLIANCE-001"
  ]
}
