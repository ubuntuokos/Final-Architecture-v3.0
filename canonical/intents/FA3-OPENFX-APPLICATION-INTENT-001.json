    "vfx-plugin-interoperability",
    "host-plugin-capability-negotiation",
    "creative-software-coexistence"
  ],
  "task_classes": [
    "openfx-contract-admission",
    "host-plugin-negotiation",
    "round-trip-interoperability"
  ],
  "skill_triggers": [],
