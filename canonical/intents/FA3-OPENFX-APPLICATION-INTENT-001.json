    "CANONICAL_METADATA",
    "IMAGE_EFFECT_GRAPH"
  ],
  "output_modalities": [
    "INTEROPERABILITY_CONTRACT",
    "MACHINE_READABLE_ASSESSMENT"
  ],
  "execution_classes": [
    "CPU_ONLY",
    "OPTIONAL_ACCELERATOR"
  ],
  "proposed_authority_roles": [],
  "declared_new_capabilities": [],
  "declared_gaps": [],
