    "bounded-action-selection",
    "low-latency-decision",
    "confidence-gating",
    "typed-handoff",
    "mcp-action-compilation",
    "browser-reflex-assistance"
  ],
  "input_modalities": [
    "BOUNDED_STATE",
    "FINITE_ACTION_CATALOGUE"
  ],
  "output_modalities": [
    "AUTHORIZATION_READY_INTENT",
    "SYSTEM_TWO_OR_HUMAN_HANDOFF"
  ],
  "execution_classes": [
    "CPU_LIGHTWEIGHT",
    "MODEL_ROUTER_MEDIATED"
  ],
  "data_classes": [
    "BOUNDED_DECISION_CONTEXT",
