  "optional_capabilities": [],
  "problem_classes": [
    "model-artifact-storage",
    "model-identity",
    "lineage",
    "deduplication",
    "inventory",
    "runtime-native-store-projection",
    "software-coexistence"
  ],
  "input_modalities": [
    "MODEL_METADATA",
    "ARTIFACT_METADATA",
    "CONTENT_DIGESTS",
    "RUNTIME_STORE_PROJECTIONS"
  ],
  "output_modalities": [
    "CANONICAL_MODEL_INVENTORY",
    "PHYSICAL_STORE_PROJECTION",
    "LINEAGE_RECORDS"
  ],
  "execution_classes": [
    "CPU_LIGHTWEIGHT",
