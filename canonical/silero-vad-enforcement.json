    {"id": "SILERO-021", "severity": "P0", "assert": "runtime current-host PASS cannot be document-derived"},
    {"id": "SILERO-022", "severity": "P0", "assert": "8k real-audio E2E required"},
    {"id": "SILERO-023", "severity": "P0", "assert": "16k real-audio E2E required"},
    {"id": "SILERO-024", "severity": "P0", "assert": "quality regression required"},
    {"id": "SILERO-025", "severity": "P0", "assert": "concurrent stream and long-run soak required before promotion"},
    {"id": "SILERO-026", "severity": "P0", "assert": "current-host facts remain evidence only, never canonical hardware requirements"}
