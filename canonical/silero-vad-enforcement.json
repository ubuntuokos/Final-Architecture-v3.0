  "rules": [
    {"id": "SILERO-001", "severity": "P0", "assert": "capability_count == 143"},
    {"id": "SILERO-002", "severity": "P0", "assert": "new_capability == false"},
    {"id": "SILERO-003", "severity": "P0", "assert": "new_architectural_authority == false"},
