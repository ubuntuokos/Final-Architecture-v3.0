    {"id": "SILERO-007", "severity": "P0", "assert": "provider.model_policy.runtime_torch_hub_loading == false"},
    {"id": "SILERO-008", "severity": "P0", "assert": "provider.runtime.portable_cpu_execution_required == true"},
    {"id": "SILERO-009", "severity": "P0", "assert": "provider.runtime.gpu_required == false"},
    {"id": "SILERO-010", "severity": "P0", "assert": "accelerator execution requires Host Resource Broker receipt"},
    {"id": "SILERO-011", "severity": "P0", "assert": "silent execution-provider fallback == false"},
