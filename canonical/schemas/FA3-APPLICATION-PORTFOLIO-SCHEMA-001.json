{
  "schema": "http://json-schema.org/draft-07/schema#",
  "title": "FA3 Application Portfolio",
  "type": "object",
  "required": [
    "schema",
    "id",
    "product_family_registry_ref",
    "portfolio_states",
    "application_classes",
    "applications"
  ],
  "properties": {
    "schema": {
      "const": "fa3.application-portfolio.v1"
    },
    "id": {
      "const": "FA3-APPLICATION-PORTFOLIO-001"
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "application_id",
          "name",
          "application_class",
          "portfolio_state",
          "minimum_operating_level",
          "supported_operating_levels",
          "primary_domain",
          "primary_product_family",
          "individually_entitleable"
        ]
      }
    }
  }
}
