{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FA3 Application Portfolio",
  "type": "object",
  "required": [
    "schema",
    "id",
    "product_family_registry_ref",
    "portfolio_states",
    "application_classes",
    "provisioning_lifecycle_ref",
    "applications"
  ],
  "properties": {
    "schema": {
      "const": "fa3.application-portfolio.v1"
    },
    "id": {
      "const": "FA3-APPLICATION-PORTFOLIO-001"
    },
    "portfolio_states": {
      "type": "array",
      "const": [
        "FUTURE",
        "PLANNED",
        "IN_PROGRESS",
        "EXISTING",
        "RETIRED"
      ]
    },
    "provisioning_lifecycle_ref": {
      "const": "FA3-APP-LIFECYCLE-001"
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "application_id",
          "name",
          "application_class",
          "portfolio_state",
          "minimum_operating_level",
          "supported_operating_levels",
          "primary_domain",
          "primary_product_family",
          "individually_entitleable",
          "required_platform_dependencies",
          "available_in_bundles"
        ],
        "properties": {
          "application_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "application_class": {
            "enum": [
              "INTERNAL_APPLICATION",
              "SYSTEM_APPLICATION",
              "COMPANION_APPLICATION",
              "EXTERNAL_OPTIONAL_APPLICATION"
            ]
          },
          "portfolio_state": {
            "enum": [
              "FUTURE",
              "PLANNED",
              "IN_PROGRESS",
              "EXISTING",
              "RETIRED"
            ]
          },
          "minimum_operating_level": {
            "enum": [
              "MINIMAL",
              "PERSONAL",
              "PROFESSIONAL",
              "STUDIO",
              "BUSINESS",
              "ENTERPRISE"
            ]
          },
          "supported_operating_levels": {
            "type": "array",
            "minItems": 1
          },
          "primary_domain": {
            "type": "string",
            "minLength": 1
          },
          "primary_product_family": {
            "type": "string",
            "minLength": 1
          },
          "individually_entitleable": {
            "const": true
          },
          "required_platform_dependencies": {
            "type": "array"
          },
          "available_in_bundles": {
            "type": "array"
          }
        }
      }
    }
  }
}
