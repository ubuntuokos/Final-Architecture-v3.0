{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fa3.communications-contacts-current-host-receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "evidence_level",
    "profile_id",
    "current_host",
    "physical_execution",
    "production_e2e",
    "synthetic",
    "provider",
    "protocols",
    "roundtrips",
    "security",
    "evidence_refs",
    "secret_values_recorded"
  ],
  "properties": {
    "schema": {
      "const": "fa3.communications-contacts-current-host-receipt.v1"
    },
    "status": {
      "const": "PASS"
    },
    "evidence_level": {
      "const": "CURRENT_HOST_PRODUCTION_E2E_PASS"
    },
    "profile_id": {
      "const": "FA3-COMMUNICATIONS-CONTACTS-SHARED-001"
    },
    "current_host": {
      "const": true
    },
    "physical_execution": {
      "const": true
    },
    "production_e2e": {
      "const": true
    },
    "synthetic": {
      "const": false
    },
    "historical_only": {
      "const": false
    },
    "secret_values_recorded": {
      "const": false
    },
    "provider": {
      "type": "object",
      "required": [
        "provider_id",
        "provider_receipt_path",
        "provider_receipt_sha256"
      ]
    },
    "protocols": {
      "type": "object",
      "required": [
        "smtp",
        "imap_or_jmap",
        "carddav",
        "tls_certificate_validation"
      ]
    },
    "roundtrips": {
      "type": "object",
      "required": [
        "send_receive",
        "contact"
      ]
    },
    "security": {
      "type": "object",
      "required": [
        "secret_broker_used",
        "attachment_security_pass",
        "malware_scanner_pass",
        "dlp_pass",
        "software_coexistence_pass",
        "hardware_safety_pass",
        "authorization_context_pass"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
