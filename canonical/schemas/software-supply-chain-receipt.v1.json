{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fa3.software-supply-chain-receipt.v1",
  "title": "FA3 Software Supply Chain Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "source",
    "artifact",
    "dependency_lock",
    "sbom",
    "license",
    "vulnerabilities",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "fa3.software-supply-chain-receipt.v1"
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "sha256",
        "kind"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "SOURCE_BUILD",
            "OCI_IMAGE_EXPORT",
            "PREBUILT_BINARY"
          ]
        }
      }
    },
    "dependency_lock": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sbom": {
      "type": "object",
      "required": [
        "format",
        "sha256",
        "scanner",
        "scanner_version"
      ],
      "properties": {
        "format": {
          "enum": [
            "SPDX_JSON",
            "CYCLONEDX_JSON"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scanner": {
          "type": "string",
          "minLength": 1
        },
        "scanner_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "scanner",
        "scanner_version",
        "declared_expression",
        "detected_expressions",
        "conflicts",
        "commercial_compatible",
        "redistribution_compatible",
        "declaration_matches_detection",
        "policy_id",
        "policy_result"
      ],
      "properties": {
        "scanner": {
          "type": "string"
        },
        "scanner_version": {
          "type": "string"
        },
        "declared_expression": {
          "type": "string"
        },
        "detected_expressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array"
        },
        "commercial_compatible": {
          "type": "boolean"
        },
        "redistribution_compatible": {
          "type": "boolean"
        },
        "declaration_matches_detection": {
          "const": true
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_result": {
          "const": "PASS"
        },
        "policy_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vulnerabilities": {
      "type": "object",
      "required": [
        "scanner",
        "scanner_version",
        "findings"
      ],
      "properties": {
        "scanner": {
          "type": "string"
        },
        "scanner_version": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "builder",
        "build_recipe_sha256"
      ],
      "properties": {
        "builder": {
          "type": "string"
        },
        "build_recipe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
