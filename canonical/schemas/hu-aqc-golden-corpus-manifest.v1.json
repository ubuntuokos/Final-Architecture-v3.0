{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fa3.hu-aqc-golden-corpus-manifest.v1",
  "title": "FA3 hu-HU AQC Golden Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "locale",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "fa3.hu-aqc-golden-corpus-manifest.v1"
    },
    "locale": {
      "const": "hu-HU"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "category",
          "audio",
          "metrics_json"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "metrics_json": {
            "type": "string",
            "minLength": 1
          },
          "consent_status": {
            "enum": [
              "GRANTED",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    }
  }
}
