{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/schemas/shared-module-pattern-catalogue-v1.json",
  "title": "FA3 Shared Module Pattern Catalogue",
  "type": "object",
  "required": [
    "schema",
    "id",
    "status",
    "authority",
    "capability_baseline",
    "pattern_classes",
    "policy",
    "shared_module_targets",
    "analysis_only_sources",
    "patterns",
    "current_host_impact",
    "materialized_shared_components"
  ],
  "properties": {
    "schema": {
      "const": "fa3.shared-module-pattern-catalogue.v1"
    },
    "id": {
      "const": "FA3-SHARED-MODULE-PATTERN-CATALOGUE-001"
    },
    "authority": {
      "const": false
    },
    "new_capability": {
      "const": false
    },
    "new_architectural_authority": {
      "const": false
    },
    "capability_baseline": {
      "const": 175
    },
    "pattern_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object"
    },
    "shared_module_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "consumer_application_ids",
          "pattern_scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FA3-SHARED-"
          },
          "name": {
            "type": "string"
          },
          "consumer_application_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "pattern_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "analysis_only_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "locator",
          "registration_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ANALYSIS-"
          },
          "name": {
            "type": "string"
          },
          "locator": {
            "type": "string",
            "pattern": "^https://"
          },
          "registration_status": {
            "const": "OWNER_MARKER_REQUIRED"
          }
        },
        "additionalProperties": false
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "name",
          "canonical_donor_ids",
          "analysis_source_ids",
          "shared_module_ids",
          "reuse_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FA3-"
          },
          "class": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "canonical_donor_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FA3-DONOR-"
            }
          },
          "analysis_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ANALYSIS-"
            }
          },
          "shared_module_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FA3-SHARED-"
            }
          },
          "reuse_status": {
            "enum": [
              "REFERENCE_ONLY",
              "PATTERN_CANDIDATE",
              "COMPOSITE_REFERENCE",
              "ADOPTED_PATTERN_WITH_ACTIVE_USAGE_EDGE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "current_host_impact": {
      "type": "object",
      "required": [
        "classification",
        "reason"
      ],
      "properties": {
        "classification": {
          "const": "NO_RUNTIME_IMPACT"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "materialized_shared_components": {
      "type": "array",
      "minItems": 5,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile_id",
          "contract_id",
          "pattern_references",
          "binding_semantics",
          "current_host_impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FA3-SHARED-"
          },
          "profile_id": {
            "type": "string",
            "pattern": "^FA3-SHARED-"
          },
          "contract_id": {
            "type": "string",
            "pattern": "^FA3-SHARED-.*-CONTRACTS-001$"
          },
          "pattern_references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FA3-"
            }
          },
          "binding_semantics": {
            "const": "DERIVED_FROM_CANONICAL_PROFILE_CONTRACT_ONLY"
          },
          "current_host_impact": {
            "enum": [
              "NO_RUNTIME_IMPACT",
              "RUNTIME_REQUALIFICATION_REQUIRED"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
