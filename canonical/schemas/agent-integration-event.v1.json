{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.internal/schemas/agent-integration-event.v1.json",
  "title": "FA3 Append-Only Agent Integration Ledger Event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "broker_id",
    "proposal_id",
    "proposal_digest_sha256",
    "timestamp_utc",
    "status",
    "proposal_mutated"
  ],
  "properties": {
    "schema": {
      "const": "fa3.agent-integration-event.v1"
    },
    "broker_id": {
      "const": "FA3-INTEGRATION-BROKER-001"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^prop-[0-9]{8}-[0-9]{3,6}$"
    },
    "proposal_digest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PR_READY",
        "INTEGRATION_FAILED"
      ]
    },
    "proposal_mutated": {
      "const": false
    }
  }
}
