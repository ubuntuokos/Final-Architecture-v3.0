{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FA3 Application Dependency Registry",
  "type": "object",
  "required": [
    "schema",
    "id",
    "authority",
    "platform_components",
    "application_dependencies",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "fa3.application-dependency-registry.v1"
    },
    "id": {
      "const": "FA3-APPLICATION-DEPENDENCY-REGISTRY-001"
    },
    "authority": {
      "const": false
    },
    "platform_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    },
    "application_dependencies": {
      "type": "object"
    },
    "rules": {
      "type": "object"
    }
  }
}
