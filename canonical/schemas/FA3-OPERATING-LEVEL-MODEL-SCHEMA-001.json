        "PROFESSIONAL",
        "STUDIO",
        "BUSINESS",
        "ENTERPRISE"
      ]
    },
    "operational_requirements": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "MINIMAL",
          "PERSONAL",
          "PROFESSIONAL",
          "STUDIO",
          "BUSINESS",
          "ENTERPRISE"
        ]
      },
      "minProperties": 1
