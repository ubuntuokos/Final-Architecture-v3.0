{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fa3://schemas/current-host-base-state.v1",
  "title": "FA3 Current Host admitted base state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "status",
    "capability_count",
    "obligation_count",
    "base_release_digest",
    "effective_host_digest",
    "admission_source_commit",
    "physical_audit_run_id",
    "physical_audit_head_sha",
    "host_fingerprint_sha256",
    "evidence_registry_sha256",
    "positive_negative_rollback_complete",
    "bundles_receipts_attestations_complete",
    "release_acceptance_status",
    "release_acceptance_criteria_passed",
    "release_acceptance_criteria_total",
    "release_acceptance_gates_current_host_base",
    "delta_authority_id",
    "historical_evidence_relabeling",
    "synthetic_current_host_pass_allowed",
    "hosted_ci_may_admit_base",
    "global_promotion_claim"
  ],
  "properties": {
    "schema": {"const": "fa3.current-host-base-state.v1"},
    "id": {"const": "FA3-CURRENT-HOST-BASE-STATE-001"},
    "status": {"const": "CURRENT_HOST_BASE_ADMITTED"},
    "capability_count": {"const": 175},
    "obligation_count": {"const": 525},
    "base_release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_host_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admission_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "physical_audit_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "physical_audit_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive_negative_rollback_complete": {"const": true},
    "bundles_receipts_attestations_complete": {"const": true},
    "release_acceptance_status": {"type": "string", "minLength": 1},
    "release_acceptance_criteria_passed": {"type": "integer", "minimum": 0, "maximum": 19},
    "release_acceptance_criteria_total": {"const": 19},
    "release_acceptance_gates_current_host_base": {"const": false},
    "delta_authority_id": {"const": "FA3-CURRENT-HOST-CHANGE-DELTA-AUTHORITY-001"},
    "historical_evidence_relabeling": {"const": "FORBIDDEN"},
    "synthetic_current_host_pass_allowed": {"const": false},
    "hosted_ci_may_admit_base": {"const": false},
    "global_promotion_claim": {"const": false}
  }
}
