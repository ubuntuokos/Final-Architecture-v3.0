{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FA3 Domain Pack Registry",
  "type": "object",
  "required": [
    "schema",
    "id",
    "authority",
    "domains",
    "packs",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "fa3.domain-pack-registry.v1"
    },
    "id": {
      "const": "FA3-DOMAIN-PACK-REGISTRY-001"
    },
    "authority": {
      "const": false
    },
    "domains": {
      "type": "array",
      "minItems": 1
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pack_id",
          "bundle_id",
          "name",
          "domain",
          "optional"
        ]
      }
    }
  }
}
