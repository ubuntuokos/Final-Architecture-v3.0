{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.internal/schemas/secret-projection-policy.v1.json",
  "title": "FA3 Secret Projection Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "secret_id",
    "classification",
    "secret_kind",
    "allowed_consumers",
    "allowed_projections",
    "exportable"
  ],
  "properties": {
    "schema": {
      "const": "fa3.secret-projection-policy.v1"
    },
    "secret_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "allOf": [
        {
          "not": {
            "pattern": "(^|/)\\\\.\\\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\\\.(/|$)"
          }
        }
      ]
    },
    "classification": {
      "enum": [
        "MACHINE_SERVICE_SECRET",
        "USER_SESSION_SECRET"
      ]
    },
    "allowed_consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumer_id",
          "allowed_unix_users"
        ],
        "properties": {
          "consumer_id": {
            "type": "string",
            "minLength": 1
          },
          "allowed_unix_users": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_executables": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "allowed_systemd_units": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "allowed_projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "UDS_SINGLE_SECRET",
          "SYSTEMD_CREDENTIAL",
          "PODMAN_SECRET_MOUNT",
          "MEMFD"
        ]
      }
    },
    "exportable": {
      "const": false
    },
    "secret_kind": {
      "enum": [
        "API_KEY",
        "API_TOKEN",
        "SERVICE_TOKEN",
        "OAUTH_CLIENT_SECRET",
        "OAUTH_REFRESH_TOKEN",
        "PROVIDER_CREDENTIAL",
        "PROVIDER_LOGIN_PASSWORD",
        "SERVICE_PASSWORD",
        "DATABASE_PASSWORD",
        "SMTP_PASSWORD",
        "MCP_PROVIDER_CREDENTIAL",
        "PRIVATE_CREDENTIAL_MATERIAL",
        "GENERIC_FA3_CREDENTIAL"
      ]
    }
  }
}
