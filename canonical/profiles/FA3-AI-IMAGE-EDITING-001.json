{
  "id": "FA3-AI-IMAGE-EDITING-001",
  "kind": "specialized_profile",
  "version": "1.1.0",
  "status": "CANONICAL",
  "title": "Local AI-Assisted Image Editing, Generative Fill & Graphic Authoring Profile",
  "relationship": {"type": "SUBPROFILE-OF", "parent": "FA3-IMGGEN-001"},
  "capability_accounting": {
    "adds_capability": false,
    "capability_count_before": 143,
    "capability_count_after": 143,
    "adds_architectural_authority": false
  },
  "scope": {
