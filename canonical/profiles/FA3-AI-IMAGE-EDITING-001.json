    "hardware_admission": "FA3-AI-IMAGE-EDITING-HARDWARE-ADMISSION-001",
    "providers_are_replaceable": true,
    "provider_selection_is_opaque_to_frontend": true,
    "frontend_providers": ["FA3-PROVIDER-GIMP-AI-LOCAL-001", "FA3-PROVIDER-KRITA-001"],
    "krita_extensions": [
      "FA3-PROVIDER-KRITA-AI-DIFFUSION-001",
      "FA3-PROVIDER-KRITA-VISION-TOOLS-001",
      "FA3-PROVIDER-KRITA-MCP-001"
    ]
  },
  "authority_constraints": {
    "frontends_must_not_be_authority_for": [
      "model_registry", "inference_runtime", "mcp_gateway", "hardware_resources",
      "workflow_orchestration", "secrets", "policy", "provenance"
    ],
    "gimp_must_not_be_authority_for": [
      "model_registry", "inference_runtime", "mcp_gateway", "hardware_resources",
      "workflow_orchestration", "secrets", "policy", "provenance"
    ],
    "krita_must_not_be_authority_for": [
      "model_registry", "inference_runtime", "mcp_gateway", "hardware_resources",
      "workflow_orchestration", "secrets", "policy", "provenance"
    ],
    "global_authorities_unchanged": true
  },
  "portability": {
    "concrete_gpu_sku_dependency_forbidden": true,
    "reference_accelerator_floor": "NVIDIA RTX 30xx/Ampere-or-newer when NVIDIA/CUDA path is selected",
    "reference_floor_is_not_provider_pin": true,
    "gpu_replacement_requires_manual_frontend_reconfiguration": false,
    "gpu_replacement_requires_manual_gimp_reconfiguration": false,
    "gpu_replacement_requires_manual_krita_reconfiguration": false
  }
