{
  "schema": "fa3.profile.v1",
  "id": "FA3-SECRET-BROKER-001",
  "name": "FA3 Encrypted Credential Vault and Delivery Broker",
  "version": "1.0.0",
  "status": "CANONICAL",
  "priority": "P0",
  "requirement": "MUST",
  "parent_profile": "FA3-SCS-001",
  "provider_neutral": true,
  "canonical_root": false,
  "architectural_authority": false,
  "new_capability": false,
  "new_architectural_authority": false,
  "capability_count": 143,
  "purpose": "Store only FA3 authentication and credential secrets encrypted at rest—tokens, API keys, OAuth secrets, external-provider credentials, service/database/SMTP passwords and equivalent credential material—and deliver only explicitly authorized SecretRef projections while preserving existing FA3 authorities.",
  "authority_boundaries": {
    "security_governance": "FA3-AUTH-SECURITY-GOV-001",
    "secrets_authority": "EXISTING_FA3_SECRETS_AUTHORITY_ONLY",
    "identity": "EXISTING_FA3_IDENTITY_AUTHORITY_ONLY",
    "authorization": "EXISTING_FA3_AUTHORIZATION_AUTHORITY_ONLY",
    "host_resource": "FA3-AUTH-HOST-RESOURCE-BROKER-001",
    "evidence": "FA3-AUTH-OBS-EVIDENCE-001",
    "broker_role": "STORAGE_DELIVERY_ENFORCEMENT_NOT_AUTHORITY"
  },
  "storage_classes": {
    "machine_service": {
      "default_type": "LUKS2_FILE_IMAGE",
      "filesystem": "ext4",
      "default_image": "/var/lib/fa3/state/fa3-machine-state.img",
      "filesystem_label": "FA3_MSTATE",
      "runtime_mount": "/run/fa3/machine-state",
      "mount_options": [
        "nodev",
        "nosuid",
        "noexec"
      ],
      "image_mode": "0600",
      "external_naming_policy": "GENERIC_NON_DISCLOSING",
      "raw_mount_visible_to_consumers": false,
      "content_scope": "FA3_CREDENTIAL_SECRETS_ONLY"
    },
    "user_session": {
      "profile": "FA3-SESSION-VAULT-001",
      "purpose": "USER_SESSION_CUSTODY_AND_ROOT_CA_STORAGE",
      "raw_machine_application_secret_storage": "FORBIDDEN",
      "raw_fa3_credential_secret_storage": "FORBIDDEN"
    },
    "human_managed_credentials": {
      "contracts": "FA3-HUMAN-CREDENTIAL-VAULT-CONTRACTS-001",
      "provider_example": "FA3-PROVIDER-VAULTWARDEN-001",
      "machine_secret_broker_replacement": false
    }
  },
  "unlock": {
    "default": "SYSTEMD_ENCRYPTED_CREDENTIAL",
    "credential_id": "fa3-machine-state-key",
    "plaintext_keyfile_persistence": "FORBIDDEN",
    "unlock_secret_inside_same_image": "FORBIDDEN",
    "interactive_recovery": "ALLOWED_ADMIN_ONLY",
    "tpm2": "OPTIONAL",
    "fido2": "OPTIONAL",
    "pkcs11_hsm": "OPTIONAL",
    "systemd_credential_key_mode": "host",
    "implicit_tpm_binding": "FORBIDDEN_BY_DEFAULT",
    "hardware_bound_unlock": "OPTIONAL_EXPLICIT_ADAPTER_ONLY"
  },
  "delivery": {
    "default_contract": "SecretReference",
    "broker_transport": "LOCAL_UNIX_DOMAIN_SOCKET_WITH_SO_PEERCRED",
    "default_projection": "FILE_OR_FD_BASED",
    "systemd_credentials": "MATERIALIZED_RUNTIME_FILE_PLUS_LOADCREDENTIAL",
    "podman_secret": "OPTIONAL_NATIVE_ADAPTER_REQUIRES_CURRENT_HOST_STORAGE_EVIDENCE",
    "podman_env_secret": "FORBIDDEN_BY_DEFAULT",
    "bulk_export": "FORBIDDEN",
    "full_vault_bind_mount": "FORBIDDEN",
    "secret_dependent_provider_unit": "MUST_BE_PART_OF_FA3_SECRETS_TARGET"
  },
  "identity_semantics": {
    "machine_service_secret": "DEDICATED_SERVICE_IDENTITY_REQUIRED",
    "desktop_same_uid_secret": "OS_USER_TRUST_BOUNDARY_ONLY_NO_FALSE_PROCESS_ISOLATION_CLAIM",
    "consumer_claim_must_match_peer_credentials": true,
    "machine_service_transport_group": "fa3-secret-clients"
  },
  "lifecycle": {
    "target": "fa3-secrets.target",
    "startup_order": [
      "OPEN_LUKS2_MAPPER",
      "MOUNT_VIA_SYSTEMD_MOUNT_UNIT",
      "VALIDATE_MAPPER_BACKED_HARDENED_MOUNT",
      "START_BROKER",
      "START_SECRET_DEPENDENT_PROVIDERS"
    ],
    "shutdown_order": [
      "STOP_SECRET_DEPENDENT_PROVIDERS",
      "STOP_BROKER",
      "STOP_SYSTEMD_MOUNT_UNIT",
      "CLOSE_LUKS2_MAPPER"
    ],
    "missing_vault": "FAIL_CLOSED_FOR_SECRET_DEPENDENT_PROVIDERS",
    "plaintext_fallback": "FORBIDDEN",
    "start_completion_requires": [
      "SECRETS_TARGET_ACTIVE",
      "MAPPER_SERVICE_ACTIVE",
      "SYSTEMD_MOUNT_UNIT_ACTIVE",
      "VAULT_MOUNT_VALIDATED",
      "LUKS_MAPPING_OPEN",
      "BROKER_SERVICE_ACTIVE",
      "BROKER_SOCKET_PRESENT",
      "BROKER_HEALTH_PASS"
    ],
    "start_readiness_timeout": "FAIL_CLOSED_ROLLBACK_TO_CLOSED",
    "vault_service_capabilities": {
      "bounding_set": [
        "CAP_SYS_ADMIN"
      ],
      "ambient": [
        "CAP_SYS_ADMIN"
      ],
      "broader_capabilities": "FORBIDDEN"
    },
    "fa3_exit_contract": {
      "command": "/usr/local/sbin/fa3-secrets-lifecycle exit",
      "completion_requires": [
        "SECRETS_TARGET_INACTIVE",
        "SECRET_DEPENDENT_PROVIDERS_STOPPED",
        "SECRET_BROKER_INACTIVE",
        "SYSTEMD_MOUNT_UNIT_INACTIVE",
        "MAPPER_SERVICE_INACTIVE",
        "VAULT_UNMOUNTED",
        "LUKS_MAPPING_CLOSED"
      ],
      "incomplete_shutdown": "FAIL_CLOSED_NOT_EXITED"
    },
    "mount_namespace_contract": {
      "mount_unit": "run-fa3-machine\\x2dstate.mount",
      "mount_unit_where": "/run/fa3/machine-state",
      "mount_unit_type": "ext4",
      "mount_unit_options": [
        "nodev",
        "nosuid",
        "noexec"
      ],
      "mount_visibility": "SYSTEM_MANAGER_MAIN_MOUNT_NAMESPACE",
      "credential_service_role": "LUKS_MAPPER_ONLY",
      "credential_service_mount_ownership": "FORBIDDEN",
      "credential_service_filesystem_namespace": "MAY_BE_PRIVATE",
      "pid1_namespace_introspection": "NOT_REQUIRED",
      "broker_mount_validation": "HELPER_ASSERT_OPEN",
      "failed_start_cleanup": "STOP_BROKER_STOP_MOUNT_UNIT_CLOSE_LUKS_MAPPER"
    }
  },
  "portability": {
    "hardware_vendor_neutral": true,
    "accelerator_requirement": "NONE",
    "cpu_gpu_npu_topology_dependency": "NONE",
    "desktop_core": "HEADLESS_CAPABLE",
    "desktop_environment_required": false,
    "display_server_required": false,
    "gui_required": false,
    "desktop_adapters": "OPTIONAL"
  },
  "backend_adapters": {
    "local_luks2": {
      "role": "CANONICAL_LOCAL_DEFAULT",
      "authority": false
    },
    "infisical": {
      "role": "OPTIONAL_SECRET_BACKEND_PROVIDER",
      "authority": false,
      "targeted_get_only": true,
      "bulk_export_forbidden": true
    },
    "podman_secret": {
      "role": "RUNTIME_DELIVERY_ADAPTER",
      "authority": false,
      "default_projection": "type=mount",
      "environment_projection": "FORBIDDEN_BY_DEFAULT",
      "default_store_ram_only_claim": "FORBIDDEN_WITHOUT_EVIDENCE",
      "admission": "SEPARATE_CURRENT_HOST_STORAGE_AND_ISOLATION_EVIDENCE_REQUIRED"
    }
  },
  "secret_scope": {
    "mode": "CREDENTIAL_SECRETS_ONLY",
    "allowed_secret_kinds": [
      "API_KEY",
      "API_TOKEN",
      "SERVICE_TOKEN",
      "OAUTH_CLIENT_SECRET",
      "OAUTH_REFRESH_TOKEN",
      "PROVIDER_CREDENTIAL",
      "PROVIDER_LOGIN_PASSWORD",
      "SERVICE_PASSWORD",
      "DATABASE_PASSWORD",
      "SMTP_PASSWORD",
      "MCP_PROVIDER_CREDENTIAL",
      "PRIVATE_CREDENTIAL_MATERIAL",
      "GENERIC_FA3_CREDENTIAL"
    ],
    "forbidden_content_classes": [
      "CACHE",
      "MODEL_DATA",
      "PROJECT_DATA",
      "USER_DOCUMENTS",
      "APPLICATION_STATE",
      "TELEMETRY",
      "GENERAL_CONFIGURATION"
    ],
    "opaque_value_payload": true,
    "non_secret_identity_metadata_location": "PROVIDER_OR_APPLICATION_CONFIGURATION"
  },
  "operator_operations": {
    "entrypoint": "/usr/local/bin/fa3-secrets-admin",
    "lifecycle": [
      "init",
      "start",
      "status",
      "exit",
      "assert-closed",
      "health"
    ],
    "credential_store": [
      "put",
      "rotate",
      "revoke",
      "metadata",
      "list"
    ],
    "policy": [
      "policy-check",
      "policy-install",
      "policy-remove",
      "policy-show",
      "policy-list"
    ],
    "recovery": [
      "backup",
      "restore",
      "rekey"
    ],
    "bulk_secret_export": "FORBIDDEN",
    "metadata_listing": "ADMIN_ONLY_NO_SECRET_VALUES"
  },
  "recovery": {
    "backup_source_state": "VAULT_CLOSED_REQUIRED",
    "backup_format": "OPAQUE_LUKS2_IMAGE_COPY",
    "backup_external_naming": "GENERIC_NON_DISCLOSING",
    "restore_validation": [
      "LUKS2_REQUIRED",
      "BROKER_HEALTH_PASS_REQUIRED"
    ],
    "restore_final_state": "CLOSED",
    "failed_restore": "ROLLBACK_PREVIOUS_ENCRYPTED_IMAGE_AND_REMAIN_CLOSED",
    "default_restore_scope": "SAME_HOST_OR_SAME_SYSTEMD_HOST_CREDENTIAL_DOMAIN",
    "cross_host_disaster_recovery": "REQUIRES_EXPLICIT_SEPARATE_RECOVERY_CREDENTIAL_ADAPTER",
    "image_backup_alone_is_cross_host_dr": false
  },
  "rekey": {
    "requires_vault_state": "CLOSED",
    "strategy": "ADD_NEW_LUKS2_KEYSLOT_VERIFY_NEW_ENCRYPTED_CREDENTIAL_TEST_LIFECYCLE_REMOVE_OLD_KEYSLOT",
    "temporary_plaintext_key_material": "RUN_TMPFS_ROOT_0700_ONLY",
    "systemd_credential_key_mode": "host",
    "tpm2_binding": "OPTIONAL_EXPLICIT_NOT_DEFAULT",
    "success_final_state": "CLOSED",
    "bulk_secret_access": "NONE"
  },
  "current_host_privilege_boundary": {
    "runner_identity": "NON_ROOT",
    "root_execution": "EXACT_ROOT_OWNED_HELPER_ONLY",
    "sudo_policy": "NOPASSWD_SINGLE_HELPER_NO_ARGUMENTS",
    "general_passwordless_sudo": "FORBIDDEN",
    "installed_package": "ROOT_OWNED_COMMIT_BOUND",
    "source_binding": "GIT_COMMIT_REQUIRED",
    "root_helper": "/usr/local/libexec/fa3-secret-broker-current-host-root",
    "runner_client": "/usr/local/bin/fa3-secret-broker-current-host-bridge",
    "evidence_handoff": "FIXED_RUN_PATH_SANITIZED_RECEIPT_ONLY",
    "broker_admin_e2e_identity": "DEDICATED_EPHEMERAL_NON_ROOT",
    "broker_admin_required_groups": [
      "fa3-secret-admin",
      "fa3-secret-clients"
    ],
    "root_peer_admin_assumption_for_e2e": "FORBIDDEN",
    "broker_admin_e2e_cleanup": "REMOVE_BEFORE_RECEIPT"
  }
}
