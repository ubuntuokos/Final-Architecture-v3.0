{
  "schema": "fa3.local-ai-model-development-policy.v1",
  "id": "FA3-LOCAL-AI-MODEL-DEVELOPMENT-POLICY-001",
  "status": "CANONICAL_POLICY_MATERIALIZED",
  "priority": "P0",
  "date": "2026-10-04",
  "authority": false,
  "capability_count": 175,
  "capability_delta": 0,
  "architectural_authority_delta": 0,
  "scope": "ALL_CURRENT_AND_FUTURE_FA3_APPLICATIONS_MODULES_AND_FEATURES_REQUIRING_OR_BENEFITING_FROM_LOCAL_AI",
  "mandatory": true,
  "retroactive": true,
  "purpose": "Require task-specific local-model research, a hardware-aware recommendation, user-visible compatible alternatives and governed optional acquisition without creating a second model, provider or resource authority.",
  "existing_authorities": {
    "model_provider_routing": "FA3-AUTH-MODEL-ROUTER-001",
    "model_artifact_lifecycle": "FA3-MODEL-MANAGER-001",
    "engine_provider_user_intent": "FA3-ENGINE-SELECTION-FABRIC-001",
    "resource_admission_placement_reservation_lease": "FA3-AUTH-HOST-RESOURCE-BROKER-001",
    "hardware_discovery": "FA3-HARDWARE-DISCOVERY-001",
    "license_rights": "FA3-LICENSE-RIGHTS-001",
    "model_artifact_security": "FA3-MODEL-ARTIFACT-SECURITY-001"
  },
  "development_requirements": {
    "current_model_research_required": true,
    "reuse_discovery_required": true,
    "published_main_donor_registry_only": true,
    "pending_or_unmerged_donors_must_be_ignored": true,
    "multiple_candidates_required_when_multiple_suitable_models_exist": true,
    "single_candidate_allowed_only_with_recorded_reason": true,
    "model_matrix_required": true,
    "model_matrix_minimum_fields": [
      "application_or_feature_id",
      "task_class",
      "candidate_model_id",
      "candidate_version_or_revision",
      "quality_profile",
      "latency_profile",
      "ram_requirement",
      "vram_requirement",
      "cpu_support",
      "gpu_backend_support",
      "npu_backend_support",
      "precision_quantization_options",
      "offline_operation",
      "license_rights_state",
      "security_admission_state",
      "artifact_size",
      "recommended_hardware_classes",
      "selection_reason"
    ],
    "re_evaluate_on_material_application_change": true,
    "re_evaluate_on_material_hardware_backend_change": true,
    "re_evaluate_on_model_catalog_refresh": true
  },
  "hardware_aware_selection": {
    "required": true,
    "runtime_context_inputs": [
      "cpu_identity_and_supported_instruction_sets",
      "logical_and_physical_cpu_capacity",
      "installed_ram_and_current_safe_available_ram",
      "gpu_inventory",
      "gpu_backend_compatibility",
      "gpu_vram_and_current_safe_available_vram",
      "npu_inventory",
      "npu_backend_compatibility",
      "supported_precision_and_quantization",
      "current_resource_pressure",
      "hardware_safety_envelope",
      "software_coexistence_constraints"
    ],
    "recommendation_semantics": "RANK_ALREADY_ADMITTED_COMPATIBLE_CANDIDATES_FOR_THE_CURRENT_HOST_AND_TASK",
    "recommendation_is_execution_authority": false,
    "recommendation_is_install_authority": false,
    "cpu_only_path_mandatory": true,
    "accelerator_cardinality": "0..N",
    "vendor_neutral": true,
    "no_silent_fallback": true,
    "no_silent_local_to_cloud_fallback": true,
    "display_gpu_policy": {
      "default_ai_compute": false,
      "automatic_use_allowed_when": "NO_OTHER_GPU_AND_NO_NPU_PRESENT_AND_EXISTING_FA3_SAFETY_AND_HRB_ADMISSION_PASS",
      "when_other_gpu_or_npu_exists": "DISPLAY_GPU_AI_USE_REQUIRES_EXPLICIT_IN_APPLICATION_TASK_AND_MODEL_SPECIFIC_USER_SELECTION",
      "hardware_detection_may_override_rule": false
    }
  },
  "application_ui_contract": {
    "required_inside_each_consuming_application": true,
    "shared_component_preferred": "FA3-ENGINE-SELECTION-FABRIC-001",
    "recommended_candidate_badge": "RECOMMENDED_ON_THIS_HARDWARE",
    "all_admitted_compatible_candidates_visible": true,
    "compatible_not_installed_candidates_visible": true,
    "incompatible_candidates_may_be_visible_with_reason": true,
    "candidate_states": [
      "RECOMMENDED_ON_THIS_HARDWARE",
      "INSTALLED_COMPATIBLE",
      "AVAILABLE_TO_DOWNLOAD",
      "HIGHER_QUALITY_HIGHER_RESOURCE",
      "FASTER_LOWER_RESOURCE",
      "CPU_OPTIMIZED",
      "GPU_OR_NPU_OPTIMIZED",
      "INCOMPATIBLE_ON_CURRENT_HARDWARE",
      "BLOCKED_BY_POLICY_OR_ADMISSION"
    ],
    "manual_compatible_alternative_selection": true,
    "user_choice_preserved": true,
    "application_may_hide_non_primary_eligible_candidates": false
  },
  "optional_download_install": {
    "user_initiated_only": true,
    "automatic_download": false,
    "automatic_install": false,
    "direct_ungoverned_download": false,
    "model_manager_mediated": true,
    "license_rights_pass_required": true,
    "model_artifact_security_pass_required": true,
    "provenance_required": true,
    "digest_or_equivalent_integrity_binding_required": true,
    "storage_and_disk_preflight_required": true,
    "downloadable_only_when_legally_and_technically_eligible": true
  },
  "selection_profiles": [
    "QUALITY",
    "BALANCED",
    "FAST",
    "LOW_MEMORY_CPU",
    "HARDWARE_SPECIALIZED"
  ],
  "closure_rule": "A local-AI application, module or feature is not development-complete unless its model matrix, current-hardware recommendation path, visible compatible alternatives, optional governed acquisition path, Model Router binding, HRB binding and CPU-only path are explicitly covered or an auditable NOT_APPLICABLE reason is recorded.",
  "application_catalog_binding": "FA3-AI-STUDIO-APP-CATALOG-001",
  "new_provider_admission": false,
  "new_model_admission": false,
  "runtime_activation": false,
  "physical_current_host_pass_claimed": false
}
