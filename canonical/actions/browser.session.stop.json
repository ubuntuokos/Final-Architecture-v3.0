{
  "schema": "fa3.uaf.action-contract.v1",
  "version": "1.0.0",
  "exposure": {
    "cli": false,
    "mcp": true
  },
  "resources": {
    "hrb_required": true,
    "accelerator_required": false
  },
  "provider": {
    "selection": "capability-match",
    "architectural_authority": false,
    "browser_session_runtime_is_execution_domain_not_authority": true
  },
  "evidence": {
    "required": true,
    "global_promotion_claim": false
  },
  "id": "browser.session.stop",
  "description": "Stop one bounded FA3 browser session after revoking all logical tab leases and assistance requests.",
  "input_schema": {
    "type": "object",
    "required": [
      "session_id"
    ],
    "properties": {
      "session_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "returned_leases",
      "cancelled_assistance",
      "execution_receipt_ref"
    ],
    "properties": {
      "status": {
        "type": "string",
        "minLength": 1
      },
      "returned_leases": {
        "type": "integer"
      },
      "cancelled_assistance": {
        "type": "integer"
      },
      "execution_receipt_ref": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "semantics": {
    "mutating": true,
    "idempotent": false,
    "blind_retry": "DENY"
  },
  "security": {
    "authentication": "required",
    "authorization": "required",
    "approval": "policy",
    "page_content_trust": "UNTRUSTED_EXTERNAL_CONTENT"
  }
}
