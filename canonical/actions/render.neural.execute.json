{
  "schema": "fa3.uaf.action-contract.v1",
  "id": "render.neural.execute",
  "version": "2.0.0",
  "description": "Execute an already selected CPU-software or host-accelerated neural-rendering plan. HRB, provider/model admission and exact-provider semantics are mandatory; no silent fallback is allowed.",
  "input_schema": {
    "type": "object",
    "required": [
      "operation_id",
      "plan_ref",
      "selected_provider_id",
      "model_artifact_ref",
      "execution_class",
      "feature_class",
      "output_class",
      "frame_surface"
    ],
    "properties": {
      "operation_id": {
        "type": "string"
      },
      "candidate_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "context_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "plan_ref": {
        "type": "string"
      },
      "selected_provider_id": {
        "type": "string"
      },
      "model_artifact_ref": {
        "type": "string"
      },
      "execution_class": {
        "type": "string",
        "enum": [
          "CPU_SOFTWARE",
          "HOST_NATIVE_ACCELERATED"
        ]
      },
      "feature_class": {
        "type": "string",
        "enum": [
          "NEURAL_RENDER",
          "SUPER_RESOLUTION",
          "NATIVE_RESOLUTION_AA",
          "RAY_RECONSTRUCTION",
          "DENOISE",
          "TEMPORAL_RECONSTRUCTION",
          "FRAME_GENERATION",
          "LOW_LATENCY_PRESENTATION"
        ]
      },
      "output_class": {
        "type": "string",
        "enum": [
          "INTERACTIVE_PREVIEW",
          "VIEWPORT",
          "PREVIZ",
          "VP_MONITOR",
          "PLAYBACK",
          "FINAL_MASTER",
          "ARCHIVAL_MASTER",
          "EXR_SEQUENCE",
          "VFX_HANDOFF"
        ]
      },
      "frame_surface": {
        "type": "object"
      },
      "hrb_lease_ref": {
        "type": "string"
      },
      "model_router_receipt_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "application_id": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "provider_id",
      "decision_receipt",
      "evidence_refs"
    ],
    "properties": {
      "status": {
        "type": "string"
      },
      "provider_id": {
        "type": "string"
      },
      "decision_receipt": {
        "type": "object"
      },
      "artifact_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidence_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "semantics": {
    "mutating": true,
    "idempotent": true,
    "retry_safe": false,
    "long_running": true
  },
  "exposure": {
    "gui": true,
    "agent": true,
    "cli": true,
    "mcp": true,
    "a2a": true,
    "automation": true,
    "http": false
  },
  "security": {
    "authentication": "required",
    "authorization": "required",
    "approval": "policy",
    "audit": "required"
  },
  "resources": {
    "hrb_required": true,
    "cpu": {
      "physical_cores": {
        "minimum": 0
      },
      "logical_processors": null
    },
    "accelerator": {
      "required": false,
      "cardinality": "0..N"
    },
    "memory": {
      "admission": "provider-declared"
    }
  },
  "provider": {
    "selection": "policy-bounded-capability-match",
    "preferred_role": "CPU_OR_HOST_NATIVE_NEURAL_RENDERING_PROVIDER"
  },
  "evidence": {
    "required": true,
    "decision_receipt_required": true,
    "current_host_claim": false
  }
}
