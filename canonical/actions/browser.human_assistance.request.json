{
  "schema": "fa3.uaf.action-contract.v1",
  "version": "1.0.0",
  "exposure": {
    "cli": false,
    "mcp": true
  },
  "resources": {
    "hrb_required": true,
    "accelerator_required": false
  },
  "provider": {
    "selection": "capability-match",
    "architectural_authority": false,
    "browser_session_runtime_is_execution_domain_not_authority": true
  },
  "evidence": {
    "required": true,
    "global_promotion_claim": false
  },
  "id": "browser.human_assistance.request",
  "description": "Present a visible browser overlay requesting a human-only step. The request does not claim completion or expand agent authority.",
  "input_schema": {
    "type": "object",
    "required": [
      "session_id",
      "tab_ref",
      "prompt"
    ],
    "properties": {
      "session_id": {
        "type": "string",
        "minLength": 1
      },
      "tab_ref": {
        "type": "string",
        "minLength": 1
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "assistance_request_id",
      "tab_ref",
      "human_completion_claim",
      "execution_receipt_ref"
    ],
    "properties": {
      "status": {
        "type": "string",
        "minLength": 1
      },
      "assistance_request_id": {
        "type": "string",
        "minLength": 1
      },
      "tab_ref": {
        "type": "string",
        "minLength": 1
      },
      "human_completion_claim": {
        "type": "boolean"
      },
      "execution_receipt_ref": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "semantics": {
    "mutating": true,
    "idempotent": false,
    "blind_retry": "DENY"
  },
  "security": {
    "authentication": "required",
    "authorization": "required",
    "approval": "explicit",
    "page_content_trust": "UNTRUSTED_EXTERNAL_CONTENT"
  }
}
