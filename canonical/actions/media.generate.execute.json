{
  "schema": "fa3.uaf.action-contract.v1",
  "id": "media.generate.execute",
  "version": "1.0.0",
  "description": "Execute an admitted provider-neutral FA3 Generative Media Studio request. Provider/model resolution remains with the Central Model Router and resource admission remains with HRB.",
  "input_schema": {
    "type": "object",
    "required": ["generation_request"],
    "properties": {
      "generation_request": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["status", "artifact_ref", "evidence_refs"],
    "properties": {
      "status": {"type": "string"},
      "artifact_ref": {"type": "string"},
      "evidence_refs": {
        "type": "array",
        "items": {"type": "string"}
      },
      "projection_loss_report": {
        "type": ["object", "null"]
      }
    },
    "additionalProperties": false
  },
  "semantics": {
    "mutating": true,
    "idempotent": false,
    "retry_safe": false,
    "long_running": true,
    "model_router_resolution_required": true,
    "silent_fallback": false
  },
  "exposure": {
    "gui": true,
    "agent": true,
    "cli": true,
    "mcp": true,
    "a2a": true,
    "automation": true,
    "http": false
  },
  "security": {
    "authentication": "required",
    "authorization": "required",
    "approval": "policy",
    "audit": "required"
  },
  "resources": {
    "hrb_required": true,
    "cpu": {
      "physical_cores": {"minimum": 0},
      "logical_processors": null
    },
    "accelerator": {
      "required": false,
      "cardinality": "0..N"
    },
    "memory": {
      "admission": "provider-declared"
    }
  },
  "provider": {
    "selection": "MODEL_ROUTER_RESOLVED_THEN_POLICY_BOUNDED_CAPABILITY_MATCH",
    "preferred_role": "FA3_GENERATIVE_MEDIA_EXECUTION_PROVIDER"
  },
  "evidence": {
    "required": true,
    "decision_receipt_required": true,
    "current_host_claim": false
  }
}
