{
  "schema": "fa3.uaf.action-contract.v1",
  "id": "render.neural.evaluate",
  "version": "1.0.0",
  "description": "Evaluate a bounded set of neural-rendering provider/execution candidates through deterministic policy and optional Jev advisory ranking.",
  "input_schema": {
    "type": "object",
    "required": [
      "operation_id"
    ],
    "properties": {
      "operation_id": {
        "type": "string"
      },
      "candidate_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "context_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "requested_provider_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "requested_execution_class": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "provider_id",
      "decision_receipt",
      "evidence_refs"
    ],
    "properties": {
      "status": {
        "type": "string"
      },
      "provider_id": {
        "type": "string"
      },
      "decision_receipt": {
        "type": "object"
      },
      "artifact_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidence_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "semantics": {
    "mutating": false,
    "idempotent": true,
    "retry_safe": true,
    "long_running": false
  },
  "exposure": {
    "gui": true,
    "agent": true,
    "cli": true,
    "mcp": true,
    "a2a": true,
    "automation": true,
    "http": false
  },
  "security": {
    "authentication": "required",
    "authorization": "required",
    "approval": "policy",
    "audit": "required"
  },
  "resources": {
    "hrb_required": false,
    "cpu": {
      "physical_cores": {
        "minimum": 0
      },
      "logical_processors": null
    },
    "accelerator": {
      "required": false,
      "cardinality": "0..N"
    },
    "memory": {
      "admission": "provider-declared"
    }
  },
  "provider": {
    "selection": "policy-bounded-capability-match",
    "preferred_role": "NEURAL_RENDERING_PROVIDER"
  },
  "evidence": {
    "required": true,
    "decision_receipt_required": true,
    "current_host_claim": false
  }
}
