{
  "schema": "fa3.uaf.action-contract.v1",
  "id": "system.capabilities.list",
  "version": "1.0.0",
  "description": "List UAF action contracts visible to the admitted caller.",
  "input_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "actions"
    ],
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "semantics": {
    "mutating": false,
    "idempotent": true,
    "retry_safe": true,
    "long_running": false
  },
  "exposure": {
    "gui": true,
    "agent": true,
    "cli": true,
    "mcp": true,
    "a2a": false,
    "automation": true,
    "http": false
  },
  "security": {
    "authentication": "required",
    "authorization": "required",
    "approval": "policy",
    "audit": "required"
  },
  "resources": {
    "hrb_required": false,
    "cpu": {
      "physical_cores": {
        "minimum": 0
      },
      "logical_processors": null
    },
    "accelerator": {
      "required": false,
      "cardinality": "0..N"
    },
    "memory": {
      "admission": "none"
    }
  },
  "provider": {
    "selection": "capability-match"
  },
  "evidence": {
    "required": true
  }
}
