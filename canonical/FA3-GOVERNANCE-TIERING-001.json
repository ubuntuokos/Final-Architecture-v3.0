  "purpose": "Expose a single read-only lifecycle view over existing FA3 canonical, evidence, acceptance and promotion authorities while formalizing only the non-authoritative assurance rings LAB, CANDIDATE and STAGING.",
  "non_authority": {
    "may_promote_runtime": false,
    "may_canonicalize": false,
    "may_mutate_evidence": false,
    "may_enable_provider": false,
    "may_grant_authority": false,
    "may_override_acceptance": false,
    "may_override_current_host_evidence": false,
    "may_infer_pass_from_documentation": false
  },
  "authoritative_sources": {
