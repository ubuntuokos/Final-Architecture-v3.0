        "linux",
        "x64",
        "fa3-current-host"
      ],
      "projection_does_not_create_receipts": true
    }
  },
  "orthogonal_axes": {
    "assurance": {
      "owned_by_projection": true,
      "authoritative_for_production": false,
      "rings": [
        {
          "id": "LAB",
          "ordinal": 10,
          "meaning": "Experimental or exploratory implementation state. Mutable inputs may exist and conformance may be incomplete.",
          "minimum_semantics": [
            "NO_PRODUCTION_CLAIM",
            "NO_CANONICAL_CLAIM_FROM_RING",
            "NO_CURRENT_HOST_PASS_FROM_RING"
          ]
        },
        {
          "id": "CANDIDATE",
          "ordinal": 20,
          "meaning": "Candidate implementation with resolved identity/provenance suitable for controlled conformance work, but not production promotion.",
          "minimum_semantics": [
            "IMMUTABLE_IDENTITY_OR_EQUIVALENT_RESOLUTION_REQUIRED",
            "PROVENANCE_OR_SOURCE_BINDING_REQUIRED",
            "NO_PRODUCTION_CLAIM",
            "NO_CANONICAL_CLAIM_FROM_RING"
          ]
        },
        {
          "id": "STAGING",
          "ordinal": 30,
          "meaning": "Implementation has passed its applicable static/reference/provider conformance prerequisites and is ready for authoritative runtime admission or promotion evaluation.",
          "minimum_semantics": [
            "APPLICABLE_STATIC_OR_REFERENCE_GATES_PASS",
            "REFERENCE_OR_CI_EVIDENCE_MAY_NOT_SUBSTITUTE_CURRENT_HOST_EVIDENCE",
            "PRODUCTION_REQUIRES_EXISTING_PROMOTION_AUTHORITY",
            "NO_CANONICAL_CLAIM_FROM_RING"
          ]
        }
      ],
      "demotion_on_invalidation": true,
      "unknown_when_derivation_inputs_are_insufficient": true
    },
    "canonical": {
      "owned_by_projection": false,
      "source": "authoritative_sources.canonical",
      "state_model": "SOURCE_DEFINED_PASSTHROUGH",
      "unknown_when_source_unavailable": true
    },
    "runtime": {
      "owned_by_projection": false,
      "sources": [
        "authoritative_sources.evidence",
        "authoritative_sources.acceptance",
        "authoritative_sources.promotion",
        "authoritative_sources.current_host"
      ],
      "state_model": "SOURCE_DEFINED_PASSTHROUGH",
      "unknown_or_pending_when_source_unavailable": true
    }
  },
  "derivation_rules": {
    "assurance_ring_order": [
      "LAB",
      "CANDIDATE",
      "STAGING"
    ],
    "ring_is_not_promotion_state": true,
    "ring_is_not_canonical_state": true,
    "canonical_and_runtime_are_independent": true,
    "canonical_closed_with_pending_current_host_is_valid": true,
    "staging_with_not_promoted_is_valid": true,
    "promotion_must_be_read_from_existing_promotion_authority": true,
