{
  "schema": "fa3.contract-set.v1",
  "id": "FA3-AUDIO-SEPARATION-CONTRACTS-001",
  "profile": "FA3-AUDIO-SEPARATION-001",
  "contracts": [
    "AudioSeparationIntent",
    "AudioSeparationProviderCapabilityDescriptor",
    "StemOntologyDescriptor",
    "StemSeparationRequest",
    "StemSeparationResult",
    "AudioMixtureDescriptor",
    "AudioStemArtifact",
    "StemArtifactSet",
    "SeparationModelDescriptor",
    "SeparationModelVariantDescriptor",
    "SeparationModelBagDescriptor",
    "SeparationExecutionPlan",
    "SeparationResourceRequirement",
    "ChunkingPolicy",
    "OverlapReconstructionPolicy",
    "AudioNormalizationPolicy",
    "AudioOutputEncodingPolicy",
    "ClippingPolicy",
    "SeparationQualityEvidence",
    "StemContaminationEvidence",
    "ReconstructionEvidence",
    "SeparationArtifactLineage",
    "SeparationExecutionEvidence"
  ],
  "provider_neutral": true,
  "required_lineage_fields": [
    "input_hash",
    "model_id",
    "model_hash",
    "provider_id",
    "provider_version",
    "stem_schema",
    "segment",
    "overlap",
    "shifts",
    "samplerate",
    "channels",
    "device_lease",
    "execution_timestamp",
    "output_hashes",
    "quality_evidence"
  ],
  "rules": {
    "provider_names_forbidden_in_contract_identity": true,
    "unsupported_stem_fail_closed": true,
    "experimental_stem_requires_explicit_nonproduction_status": true,
    "accelerator_execution_requires_host_resource_broker_lease": true,
    "legacy_pickle_checkpoint_requires_explicit_trust_admission": true,
    "external_model_metadata_arbitrary_class_import_forbidden": true
  }
}
