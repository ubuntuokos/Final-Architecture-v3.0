{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fa3:coexistence-inventory:v1",
  "title": "FA3 Coexistence Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_count",
    "provider_count",
    "entries",
    "closure"
  ],
  "properties": {
    "schema": {
      "const": "fa3.coexistence-inventory.v1"
    },
    "capability_count": {
      "const": 175
    },
    "provider_count": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "record_path",
          "record_status",
          "footprint_status",
          "coexistence_status"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "record_path": {
            "type": "string"
          },
          "record_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "footprint_status": {
            "enum": [
              "MATERIALIZED",
              "PENDING_FOOTPRINT"
            ]
          },
          "coexistence_status": {
            "enum": [
              "STATIC_AUDIT_PENDING",
              "STATIC_AUDIT_PASS_CURRENT_HOST_PENDING",
              "CURRENT_HOST_PASS",
              "STATIC_AUDIT_FAIL"
            ]
          }
        }
      }
    },
    "closure": {
      "type": "object",
      "required": [
        "all_providers_inventoried",
        "all_footprints_materialized",
        "all_current_host_proven"
      ],
      "properties": {
        "all_providers_inventoried": {
          "type": "boolean"
        },
        "all_footprints_materialized": {
          "type": "boolean"
        },
        "all_current_host_proven": {
          "type": "boolean"
        }
      }
    }
  }
}
