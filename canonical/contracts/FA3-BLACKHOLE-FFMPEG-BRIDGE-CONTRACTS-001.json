{
  "schema": "fa3.contract-set.v1",
  "id": "FA3-BLACKHOLE-FFMPEG-BRIDGE-CONTRACTS-001",
  "version": "1.0.0",
  "status": "CANONICAL_INTEGRATION_PROJECTION",
  "provider_neutral": true,
  "profile_type": "INTEGRATION_CONTRACT",
  "delegates_to": [
    "FA3-STT-MEDIA-001",
    "FA3-NEURAL-MEDIA-EXECUTION-001",
    "FA3-HOST-RESOURCE-BROKER-001"
  ],
  "capability_count_source": "canonical/FA3-RELEASE-CAPABILITY-BASELINE-001.json",
  "capability_delta": 0,
  "authority_delta": 0,
  "runtime_lease": {
