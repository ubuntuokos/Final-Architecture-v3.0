      "ZERO_COPY_NEURAL_PROCESSING",
      "BLACKHOLE_TRANSCRIPTION",
      "CANONICAL_EVIDENCE_GENERATION"
    ],
    "transcription_delegates_to": "FA3-STT-MEDIA-001",
    "neural_media_delegates_to": "FA3-NEURAL-MEDIA-EXECUTION-001",
    "caption_qc_required": true
  },
  "zero_copy_policy": {
