    "dynamic_runtime_acquisition_required": true,
    "static_lease_id_in_payload_forbidden": true,
    "lease_status_required": "VALID",
    "broker_validation_required": "VALID",
    "expiry_and_purpose_scope_required": true,
    "accelerator_identity_required": [
      "GPU_UUID",
      "PCI_BDF"
    ],
    "same_gpu_required_across_pipeline": true
  },
  "hardware_portability": {
    "live_capability_discovery_required": true,
    "static_sm_whitelist_as_canonical_admission_forbidden": true,
    "required_capabilities": [
      "cuda",
      "onnxruntime_cuda",
      "ffmpeg_cuda_hwframes",
      "nvenc"
    ]
  },
  "pipeline": {
