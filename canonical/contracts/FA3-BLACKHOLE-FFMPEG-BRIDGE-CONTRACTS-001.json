  },
  "runtime_profiles": {
    "PRODUCTION": {
      "CUDA_LAUNCH_BLOCKING_1_allowed": false
    },
    "DIAGNOSTIC": {
      "CUDA_LAUNCH_BLOCKING_1_allowed": true,
      "production_evidence_eligible": false
    }
  },
  "production_evidence": {
    "ffmpeg_build_trust_verified": true,
    "real_non_synthetic_source_provenance": true,
    "output_sha256": true,
    "stt_result_hash_binding": true,
    "caption_qc": true,
    "rollback_or_cleanup": true,
    "current_host_required": true
  },
  "mandatory_rules": [
    "BLACKHOLE_BRIDGE_REUSES_EXISTING_STT_NEURAL_MEDIA_HRB_AUTHORITIES",
    "TRANSCRIPTION_STAGE_MANDATORY",
    "HRB_RUNTIME_LEASE_REQUIRED",
    "STATIC_HRB_LEASE_ID_FORBIDDEN",
    "STATIC_SM_WHITELIST_FORBIDDEN_AS_CANONICAL_ADMISSION",
    "SAME_GPU_UUID_REQUIRED_ACROSS_HRB_FFMPEG_ONNX_NVENC",
    "PRODUCTION_CUDA_LAUNCH_BLOCKING_FORBIDDEN",
    "FFMPEG_BINARY_INTEGRITY_REQUIRED",
    "ZERO_COPY_INTENT_BOOLEAN_NOT_EVIDENCE",
    "MEASURED_FRAME_TO_TENSOR_ZERO_COPY_REQUIRED_FOR_ZERO_COPY_PROMOTION",
    "END_TO_END_GPU_RESIDENT_BASELINE_CLAIM_FORBIDDEN",
    "REAL_NON_SYNTHETIC_MEDIA_PROVENANCE_REQUIRED_FOR_PRODUCTION",
    "OUTPUT_HASH_STT_HASH_AND_CAPTION_QC_BINDING_REQUIRED",
    "ROLLBACK_OR_CLEANUP_EVIDENCE_REQUIRED",
    "REFERENCE_CI_CANNOT_PROMOTE_CURRENT_HOST_RUNTIME",
    "CURRENT_HOST_PRODUCTION_E2E_REQUIRED"
