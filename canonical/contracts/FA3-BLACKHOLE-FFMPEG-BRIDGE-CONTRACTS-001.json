    "claim_scope": "FRAME_TO_TENSOR_ONLY",
    "measured_frame_to_tensor_evidence_required": true,
    "same_gpu_identity_evidence_required": true,
    "unexpected_host_transfer_count_required": 0,
    "intermediate_reupload_count_required": 0,
    "end_to_end_gpu_resident_baseline_claim": false,
