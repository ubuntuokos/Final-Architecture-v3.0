{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-ORCHESTRATION-PROVIDER-CURRENT-HOST-ADMISSION-001.schema.json",
  "x-fa3-contract-id": "FA3-ORCHESTRATION-PROVIDER-CURRENT-HOST-ADMISSION-001",
  "title": "FA3 Orchestration Provider Current-Host Admission Receipt",
  "type": "object",
  "required": [
    "schema",
    "provider_id",
    "scope_id",
    "status",
    "evidence_level",
    "runtime_identity",
    "production_e2e",
    "global_promotion_claim"
  ],
  "properties": {
    "schema": {
      "const": "fa3.orchestration-provider-current-host-admission.v1"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "ADMITTED"
    },
    "evidence_level": {
      "const": "CURRENT_HOST_PRODUCTION_E2E_PASS"
    },
    "runtime_identity": {
      "type": "object",
      "minProperties": 1
    },
    "production_e2e": {
      "type": "object",
      "required": [
        "result",
        "evidence_refs"
      ],
      "properties": {
        "result": {
          "const": "PASS"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "global_promotion_claim": {
      "const": false
    }
  },
  "additionalProperties": true
}
