{
  "schema": "fa3.contract-set.v1",
  "id": "FA3-STT-MEDIA-CONTRACTS-001",
  "profile": "FA3-STT-MEDIA-001",
  "provider_neutral": true,
  "contracts": [
    "MediaTranscriptionIntent",
    "TimelineRange",
    "DecodedAudioArtifact",
    "MediaAudioPreprocessingPlan",
    "MediaTranscriptionHandoff",
    "MediaTranscriptionResult",
    "DiarizationArtifact",
    "AlignmentArtifact",
    "ForcedAlignmentArtifact",
    "WordTimingArtifact",
    "SubtitleSegmentationPolicy",
    "TranslationArtifact",
    "CaptionTrackArtifact",
    "CaptionQualityEvidence",
    "KdenliveSubtitleImportDescriptor",
    "OTIOCaptionProjectionDescriptor",
    "MediaTranscriptionExecutionEvidence"
  ],
  "time_semantics": {
    "source_range": "absolute source/timeline seconds",
    "stt_result": "relative to prepared audio",
    "caption_projection": "absolute timeline seconds after offset application"
  },
  "optional_preprocessing": {
    "source_separation_profile": "FA3-AUDIO-SEPARATION-001",
    "demucs_provider": "FA3-PROVIDER-DEMUCS-001",
    "silent_fallback_forbidden": true,
    "stt_without_preprocessor_required": true
  },
  "diarization_policy": {
    "optional": true,
    "speaker_turn_lineage_required_when_used": true
  },
  "alignment_policy": {
    "provider_native_timing_may_be_used": true,
    "forced_alignment_required_when_native_timing_insufficient": true,
    "forced_alignment_is_distinct_artifact": true,
    "silent_timing_replacement_forbidden": true
  },
  "translation_policy": {
    "optional": true,
    "source_text_preserved": true,
    "source_and_target_language_required": true,
    "provider_and_lineage_required": true
  },
  "caption_qc_policy": {
    "required_before_production_projection": true,
    "timing_nonoverlap_and_range_validation": true,
    "source_text_traceability": true
  }
}
