{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-TOOL-CONFIRMATION-001.schema.json",
  "x-fa3-contract-id": "FA3-TOOL-CONFIRMATION-001",
  "title": "FA3 Tool Confirmation Receipt",
  "type": "object",
  "required": [
    "schema",
    "tool_id",
    "tool_args_digest",
    "required",
    "approved",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "fa3.tool-confirmation.v1"
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_args_digest": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "approved": {
      "type": "boolean"
    },
    "approval_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "const": "FA3-AUTH-SECURITY-GOV-001_OR_AUTH-HUMAN"
    }
  },
  "additionalProperties": false
}
