{
  "schema": "fa3.contract-set.v1",
  "id": "FA3-MUSIC-GENERATION-CONTRACTS-001",
  "profile_id": "FA3-MUSIC-001",
  "provider_neutral": true,
  "contracts": [
    "MusicGenerationRequest",
    "MusicEditRequest",
    "MusicGenerationResult",
    "MusicModelSelection",
    "MusicRuntimePlan",
    "AudioConditioningReference",
    "AudioMasterArtifact",
    "GenerationProvenance"
  ],
  "runtime_identity_contract": {
    "applies_to": [
      "MusicRuntimePlan",
      "GenerationProvenance"
    ],
    "required_fields": [
      "backend",
      "model_revision",
      "model_variant",
      "decoder_variant",
      "precision",
      "engine_compute_capability",
      "chunking_mode",
      "limiter_identity",
      "codec_revision",
      "seed",
      "runtime_revision",
      "quantization",
      "pcm_conversion_semantics"
    ],
    "audio_affecting_identity_fields": [
      "decoder_variant",
      "precision",
      "chunking_mode",
      "limiter_identity",
      "codec_revision",
      "quantization",
      "pcm_conversion_semantics"
    ],
    "unknown_or_implicit_runtime_identity": "FAIL_CLOSED",
    "identity_change_requires_new_provenance": true,
    "silent_runtime_identity_mutation_forbidden": true
  },
  "rules": {
    "provider_names_forbidden_in_contract_identity": true,
    "requested_model_must_equal_executed_model_or_fail_closed": true,
    "accelerator_execution_requires_host_resource_broker_lease": true,
    "automation_must_use_typed_authenticated_adapter": true,
    "provider_ui_is_not_orchestration_authority": true,
    "generation_mode_state_must_be_scoped_and_reset": true,
    "model_variant_and_runtime_identity_must_be_immutable": true,
    "audio_affecting_runtime_semantics_must_be_provenance_bearing": true,
    "silent_backend_device_precision_or_cloud_fallback_forbidden": true,
    "production_auto_update_forbidden": true,
    "production_model_auto_download_forbidden": true,
    "lossless_master_required": true,
    "sft_family_requires_explicit_quality_promotion": true,
    "current_host_evidence_required_for_runtime_promotion": true
  }
}
