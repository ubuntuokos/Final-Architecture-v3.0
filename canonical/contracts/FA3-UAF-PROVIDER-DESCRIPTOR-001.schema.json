{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-UAF-PROVIDER-DESCRIPTOR-001.schema.json",
  "x-fa3-contract-id": "FA3-UAF-PROVIDER-DESCRIPTOR-001",
  "title": "FA3 UAF Provider Descriptor",
  "type": "object",
  "required": [
    "schema",
    "provider_id",
    "action_ids",
    "capabilities",
    "priority",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "fa3.uaf.provider-descriptor.v1"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "integer"
    },
    "state": {
      "enum": [
        "CONNECTED",
        "PENDING",
        "DISABLED",
        "REVOKED"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
