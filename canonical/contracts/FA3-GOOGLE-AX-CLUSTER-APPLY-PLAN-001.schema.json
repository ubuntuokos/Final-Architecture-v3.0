{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-GOOGLE-AX-CLUSTER-APPLY-PLAN-001.schema.json",
  "x-fa3-contract-id": "FA3-GOOGLE-AX-CLUSTER-APPLY-PLAN-001",
  "title": "FA3 Google AX Cluster Apply Plan",
  "type": "object",
  "required": [
    "schema","provider_id","upstream_commit","canonical_ir","architectural_authority",
    "cluster_scope_ref","kubernetes_context_ref","agent_substrate_ref","security_approval_ref",
    "namespace","runner_image","runner_image_evidence_ref","apply_order","manifests",
    "server_side_apply","force_conflicts","dry_run_required_before_apply",
    "scope_bound_cluster_e2e_required","cluster_apply_adapter_materialized",
    "runtime_promotion_eligible","google_ax_runtime_promotion_claim","global_promotion_claim"
  ],
  "properties": {
    "schema": {"const": "fa3.google-ax-cluster-apply-plan.v1"},
    "provider_id": {"const": "FA3-PROVIDER-GOOGLE-AX-001"},
    "upstream_commit": {"const": "e6211f84a9e30dd309304167b8f1d51cbdaf8dab"},
    "canonical_ir": {"const": false},
    "architectural_authority": {"const": false},
    "cluster_scope_ref": {"type": "string", "minLength": 3},
    "kubernetes_context_ref": {"type": "string", "minLength": 3},
    "agent_substrate_ref": {"type": "string", "minLength": 3},
    "security_approval_ref": {"type": "string", "minLength": 3},
    "namespace": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"},
    "runner_image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "runner_image_evidence_ref": {"type": "string", "minLength": 3},
    "apply_order": {"const": ["Workspace","Gateway","Task"]},
    "manifests": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "server_side_apply": {"const": true},
    "force_conflicts": {"const": false},
    "dry_run_required_before_apply": {"const": true},
    "scope_bound_cluster_e2e_required": {"const": true},
    "cluster_apply_adapter_materialized": {"const": true},
    "runtime_promotion_eligible": {"const": false},
    "google_ax_runtime_promotion_claim": {"const": false},
    "global_promotion_claim": {"const": false}
  },
  "additionalProperties": false
}
