{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-MODEL-CAPABILITY-DESCRIPTOR-001.schema.json",
  "x-fa3-contract-id": "FA3-MODEL-CAPABILITY-DESCRIPTOR-001",
  "title": "FA3 Model Capability Descriptor",
  "type": "object",
  "required": [
    "schema",
    "logical_model_id",
    "source",
    "router_authority",
    "model_id_heuristic",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "fa3.model-capability-descriptor.v1"
    },
    "logical_model_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "PROVIDER_DECLARED",
        "ADMITTED_PROBE",
        "PROVIDER_DECLARED_AND_PROBED"
      ]
    },
    "router_authority": {
      "const": "FA3-AUTH-MODEL-ROUTER-001"
    },
    "model_id_heuristic": {
      "const": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "tools",
        "structured_output",
        "media_input",
        "media_output",
        "streaming"
      ],
      "properties": {
        "tools": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "media_input": {
          "type": "boolean"
        },
        "media_output": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": false
}
