{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-MARKETING-DECISION-RECEIPT-001.schema.json",
  "x-fa3-contract-id": "FA3-MARKETING-DECISION-RECEIPT-001",
  "title": "FA3 Marketing Decision Receipt",
  "type": "object",
  "required": [
    "schema", "decision_id", "kind", "scope", "input_digest",
    "candidate_ids", "eligible_ranked_ids", "selected_ids", "rejected",
    "outcome", "reason", "implementation", "advisory_provider_is_authority",
    "candidate_expansion", "context_envelope", "project_radar", "receipt_digest"
  ],
  "properties": {
    "schema": {"const": "fa3.marketing-decision-receipt.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["CONTEXT_SELECTION", "CANDIDATE_RANKING", "CLASSIFICATION", "RETRY_STOP_CONTINUE", "SEMANTIC_VALIDATION"]},
    "scope": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "eligible_ranked_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_ids": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "rejected": {"type": "array", "items": {"type": "object", "required": ["id", "reason"], "properties": {"id": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "outcome": {"enum": ["CONTINUE", "RETRY", "REASSIGN", "ESCALATE", "STOP_SUCCESS", "STOP_BLOCKED", "STOP_FAILED"]},
    "reason": {"type": "string", "minLength": 1},
    "implementation": {"type": "string", "minLength": 1},
    "advisory_provider_is_authority": {"const": false},
    "candidate_expansion": {"const": false},
    "context_envelope": {"type": "object"},
    "project_radar": {"type": "object"},
    "advisory_error_class": {"type": "string"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
