{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-GOOGLE-AX-CUSTOM-RUNNER-PLAN-001.schema.json",
  "x-fa3-contract-id": "FA3-GOOGLE-AX-CUSTOM-RUNNER-PLAN-001",
  "title": "FA3 Google AX Custom Runner Plan",
  "type": "object",
  "required": [
    "schema",
    "provider_id",
    "upstream_commit",
    "canonical_ir",
    "architectural_authority",
    "task_id",
    "runner_image",
    "runner_command",
    "workspace_materializations",
    "authority_bindings",
    "network",
    "secret_material_embedded",
    "cluster_apply_ready",
    "runner_image_build_evidence_required",
    "scope_bound_cluster_e2e_required",
    "google_ax_runtime_promotion_claim",
    "global_promotion_claim"
  ],
  "properties": {
    "schema": {"const": "fa3.google-ax-custom-runner-plan.v1"},
    "provider_id": {"const": "FA3-PROVIDER-GOOGLE-AX-001"},
    "upstream_commit": {"const": "e6211f84a9e30dd309304167b8f1d51cbdaf8dab"},
    "canonical_ir": {"const": false},
    "architectural_authority": {"const": false},
    "task_id": {"type": "string", "minLength": 1},
    "runner_image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "runner_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "workspace_materializations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workspace_id", "target_path", "mode", "steps"],
        "properties": {
          "workspace_id": {"type": "string", "minLength": 1},
          "target_path": {"type": "string", "pattern": "^/workspace(?:/[A-Za-z0-9._-]+)*$"},
          "mode": {"enum": ["EMPTY", "IMMUTABLE_GIT_COMMIT"]},
          "repository": {"type": "string"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
          "detached_checkout": {"type": "boolean"},
          "steps": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    },
    "authority_bindings": {
      "type": "object",
      "required": ["resources", "hrb_admission_ref", "model_routing", "model_router_binding_ref", "tool_mediation", "mcp_gateway_binding_ref"],
      "properties": {
        "resources": {"const": "FA3-AUTH-HOST-RESOURCE-BROKER-001"},
        "hrb_admission_ref": {"type": "string", "minLength": 1},
        "model_routing": {"const": "FA3-AUTH-MODEL-ROUTER-001"},
        "model_router_binding_ref": {"type": "string", "minLength": 1},
        "tool_mediation": {"const": "FA3-AUTH-MCP-GATEWAY-001"},
        "mcp_gateway_binding_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": ["envelope_ref", "default", "direct_model_provider_access", "direct_external_tool_access"],
      "properties": {
        "envelope_ref": {"type": "string", "minLength": 1},
        "default": {"const": "DENY"},
        "direct_model_provider_access": {"const": false},
        "direct_external_tool_access": {"const": false}
      },
      "additionalProperties": false
    },
    "secret_material_embedded": {"const": false},
    "cluster_apply_ready": {"const": false},
    "runner_image_build_evidence_required": {"const": true},
    "scope_bound_cluster_e2e_required": {"const": true},
    "google_ax_runtime_promotion_claim": {"const": false},
    "global_promotion_claim": {"const": false}
  },
  "additionalProperties": false
}
