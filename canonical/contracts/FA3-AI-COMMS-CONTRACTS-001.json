  "version": "1.0.0",
  "status": "CANONICAL",
  "parent_profile": "FA3-AI-COMMS-001",
  "provider_neutral": true,
  "new_capability": false,
  "new_architectural_authority": false,
  "capability_count": 143,
  "contracts": [
    "HumanAuditableMessageEnvelope",
    "CommunicationProvenance",
    "DefinedTerm",
    "CanonicalStructuredPayload"
  ],
  "human_auditable_message_envelope": {
    "required_fields": [
      "communication_mode",
      "language_tag",
      "human_readable_text",
      "human_readable_authoritative"
    ],
    "human_readable_authoritative_must_equal": true,
    "allowed_communication_modes": [
      "HUMAN_LANGUAGE",
      "CANONICAL_STRUCTURED"
    ],
    "canonical_structured_required_fields": [
