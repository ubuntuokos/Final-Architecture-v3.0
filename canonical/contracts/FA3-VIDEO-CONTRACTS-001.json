{
  "schema": "fa3.contract-set.v1",
  "id": "FA3-VIDEO-CONTRACTS-001",
  "profile": "FA3-VIDEO-001",
  "provider_neutral": true,
  "contracts": [
    "VideoGenerationIntent",
    "VideoEditIntent",
    "VideoExtensionIntent",
    "VideoRegenerationIntent",
    "VideoContextCompilationRequest",
    "VideoContextCompilationResult",
    "VideoGenerationIR",
    "MultimodalGenerationContextIR",
    "SemanticContextGraph",
    "SemanticEntity",
    "SemanticRelation",
    "ReferenceFidelityPolicy",
    "TemporalContextGraph",
    "ContextConstraint",
    "ContextInferenceRecord",
    "ContextAmbiguityRecord",
    "ContextConflictRecord",
    "ContextCompilerReceipt",
    "ProviderProjectionLossReport",
    "ContextRevisionPatch",
    "ContextAwareRegenerationContext",
    "MultimodalReferenceBundle",
    "ReferenceArtifact",
    "ReferenceBinding",
    "CharacterReferenceBinding",
    "ObjectReferenceBinding",
    "EnvironmentReferenceBinding",
    "MotionReferenceBinding",
    "VoiceReferenceBinding",
    "DCCReferenceBinding",
    "ShotPlan",
    "ShotSequencePlan",
    "ShotTimingConstraint",
    "CameraControlDescriptor",
    "PerformanceBlockingDescriptor",
    "BoundaryFrameConstraint",
    "TemporalEditDescriptor",
    "AudioDialoguePlan",
    "AudioSceneDescriptor",
    "AVSyncConstraint",
    "VideoProviderCapabilityDescriptor",
    "VideoProviderProjectionDescriptor",
    "VideoExecutionRequest",
    "VideoExecutionResult",
    "VideoRegenerationRequest",
    "ContextAwareRegenerationRequest",
    "VideoExtensionRequest",
    "VideoQualityReport",
    "PromptAdherenceReport",
    "VisualContinuityReport",
    "CharacterConsistencyReport",
    "AudioVisualSyncReport",
    "VideoLicenseDecision",
    "VideoGenerationProvenance"
  ],
  "semantic_distinctions": [
    "prompt_recipe_knowledge != VideoGenerationIR",
    "MultimodalGenerationContextIR is_typed_child_of VideoGenerationIR",
    "ReferenceArtifact != SemanticEntity",
    "SemanticEntity != ReferenceBinding",
    "compiler_inference != authority_truth",
    "provider_projection != canonical_ir",
    "audio_signal_copy != audio_reference",
    "voice_identity != voice_performance",
    "dialogue_content != voice_timbre",
    "music_style != audio_signal",
    "upscale != super_resolution",
    "super_resolution != context_aware_regeneration",
    "context_aware_regeneration != full_regeneration",
    "generative_asset_editing != editorial_timeline_authority"
  ],
  "required_lineage_fields": [
    "request_id",
    "canonical_ir_version",
    "provider_id",
    "model_identity",
    "model_version_or_digest_when_available",
    "provider_adapter_version",
    "reference_artifact_ids",
    "generation_parameters",
    "execution_topology",
    "policy_decision",
    "license_decision",
    "execution_timestamp",
    "result_artifact_identity",
    "qc_evidence"
  ],
  "rules": {
    "provider_names_forbidden_in_contract_identity": true,
    "fixed_provider_reference_limits_forbidden": true,
    "fixed_provider_resolution_limits_forbidden": true,
    "provider_native_prompt_syntax_forbidden_upstream": true,
    "reference_content_non_instructional_by_default": true,
    "compiler_inference_origin_required": true,
    "compiler_inference_provenance_required": true,
    "compiler_inference_cannot_override_hard_constraint": true,
    "exact_dialogue_silent_rewrite_forbidden": true,
    "visible_text_silent_rewrite_forbidden": true,
    "provider_projection_loss_report_required": true,
    "hard_projection_loss_fail_closed": true,
    "context_aware_regeneration_parent_lineage_required": true,
    "context_aware_regeneration_frozen_mutable_state_required": true,
    "license_policy_admission_fail_closed": true,
    "local_accelerator_execution_requires_host_resource_broker_admission": true,
    "production_asset_requires_provenance": true
  },
  "context_ir_contract": "FA3-MMG-CONTEXT-IR-CONTRACTS-001"
}
