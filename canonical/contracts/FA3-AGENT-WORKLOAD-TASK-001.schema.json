{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-AGENT-WORKLOAD-TASK-001.schema.json",
  "x-fa3-contract-id": "FA3-AGENT-WORKLOAD-TASK-001",
  "title": "FA3 Agent Workload Task",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "root_task_id",
    "scope_refs",
    "scope_origin",
    "action_ref",
    "agent_definition_ref",
    "resource_requirements",
    "network_envelope_ref",
    "model_intent",
    "authorized_ai_participants",
    "fanout_limits"
  ],
  "properties": {
    "schema": {
      "const": "fa3.agent-workload-task.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "root_task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_item_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_ref": {
      "type": "string",
      "minLength": 1
    },
    "agent_definition_ref": {
      "type": "string",
      "minLength": 1
    },
    "workspace_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_requirements": {
      "type": "object"
    },
    "network_envelope_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_intent": {
      "type": "object",
      "properties": {
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reasoning_intent": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "AUTO",
                "OFF",
                "LOW",
                "MEDIUM",
                "HIGH",
                "MAX"
              ]
            },
            "budget_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "authorized_ai_participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fanout_limits": {
      "type": "object",
      "required": [
        "max_children",
        "max_depth",
        "max_concurrent_children",
        "max_runtime_seconds",
        "max_retries",
        "max_tool_calls",
        "max_model_requests"
      ]
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_origin": {
      "type": "string",
      "enum": [
        "EXPLICIT_USER_SCOPE",
        "REQUIRED_FOR_APPROVED_GOAL",
        "EXPLICIT_USER_SCOPE_EXTENSION"
      ]
    },
    "scope_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "goal_scope_binding": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "schema",
        "policy_id",
        "goal_contract_id",
        "goal_id",
        "goal_revision",
        "goal_digest",
        "scope_digest",
        "max_same_blocker_attempts",
        "automatic_scope_expansion",
        "out_of_scope_followup",
        "automatic_followup_execution",
        "human_intervention_freezes_execution",
        "closed_task_execution",
        "durable_state_authority",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "fa3.goal-scope-binding.v1"
        },
        "policy_id": {
          "const": "FA3-TASK-SCOPE-CLOSURE-POLICY-2026-10-03"
        },
        "goal_contract_id": {
          "const": "FA3-GOAL-EXECUTION-CONTRACTS-001"
        },
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "goal_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_same_blocker_attempts": {
          "const": 3
        },
        "automatic_scope_expansion": {
          "const": false
        },
        "out_of_scope_followup": {
          "const": "NEW_TASK_REQUIRED"
        },
        "automatic_followup_execution": {
          "const": false
        },
        "human_intervention_freezes_execution": {
          "const": true
        },
        "closed_task_execution": {
          "const": "FORBIDDEN"
        },
        "durable_state_authority": {
          "const": "TEMPORAL_EXISTING_GLOBAL_DURABLE_ORCHESTRATION_AUTHORITY"
        },
        "authority": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope_origin": {
            "enum": [
              "EXPLICIT_USER_SCOPE",
              "REQUIRED_FOR_APPROVED_GOAL",
              "EXPLICIT_USER_SCOPE_EXTENSION"
            ]
          }
        },
        "required": [
          "scope_origin"
        ]
      },
      "then": {
        "required": [
          "goal_scope_binding"
        ],
        "properties": {
          "goal_scope_binding": {
            "type": "object"
          }
        }
      }
    }
  ]
}
