{
  "schema": "fa3.contract-set.v1",
  "id": "FA3-WEB-CREATIVE-ASSET-PACKAGING-DELIVERY-CONTRACTS-001",
  "name": "Provider-Neutral Web Creative Asset Packaging, Preview and Delivery Contracts",
  "version": "1.0.0",
  "status": "CANONICAL",
  "provider_neutral": true,
  "new_capability": false,
  "new_architectural_authority": false,
  "capability_count": 143,
  "first_reference_provider": "FA3-PROVIDER-OPENHERO-001",
  "contracts": [
    "WebCreativeAssetDescriptor",
    "WebHeroAsset",
    "WebHeroPackage",
    "WebHeroVariant",
    "WebHeroDependencyManifest",
    "WebHeroPreviewDescriptor",
    "CreativeAssetRightsDescriptor",
    "CreativeAssetProvenance",
    "WebPublishingProjection",
    "WebHeroSubmission",
    "WebHeroAdmissionResult"
  ],
  "mandatory_flow": [
    "creative_intent",
    "asset_discovery",
    "resolve_immutable_source",
    "registry_lookup",
    "rights_and_provenance_admission",
    "archive_and_file_admission",
    "active_content_and_dependency_scan",
    "isolated_preview",
    "accessibility_responsive_visual_qa",
    "human_approval",
    "content_addressed_publication",
    "delivery_projection",
    "evidence_and_rollback_linkage"
  ],
  "registry_resolution": {
    "registry_only": true,
    "direct_user_input_to_filesystem_path_forbidden": true,
    "absolute_path_forbidden": true,
    "parent_traversal_forbidden": true,
    "normalized_safe_relative_paths_required": true
  },
  "archive_admission": {
    "entry_count_bounded": true,
    "total_uncompressed_size_bounded": true,
    "compression_ratio_bounded": true,
    "mime_verification_required": true,
    "magic_byte_verification_required": true,
    "unexpected_executable_types_forbidden": true,
    "html_entrypoint_required": true
  },
  "rights_governance": {
    "repository_code_license_cannot_imply_asset_rights": true,
    "per_asset_license_or_rights_declaration_required": true,
    "source_provenance_required": true,
    "redistribution_constraints_preserved": true,
    "rights_gate_precedes_publication": true
  },
  "active_content_security": {
    "structured_url_parsing_required": true,
    "exact_origin_allowlist_required": true,
    "substring_domain_matching_forbidden": true,
    "inline_script_policy_required": true,
    "dependency_version_and_integrity_pin_required": true,
    "sbom_required": true,
    "supply_chain_scan_pass_required": true
  },
  "preview_security": {
    "isolated_origin_required": true,
    "application_origin_reuse_for_untrusted_preview_forbidden": true,
    "allow_scripts_plus_allow_same_origin_combination_forbidden": true,
    "csp_required": true,
    "outbound_network_default_deny": true,
    "credentials_and_parent_storage_forbidden": true,
    "resource_budget_required": true
  },
  "quality": {
    "accessibility_pass_required": true,
    "responsive_layout_pass_required": true,
    "visual_regression_pass_required": true,
    "human_review_required": true
  },
  "publication": {
    "content_addressed": true,
    "immutable": true,
    "rollback_target_required": true,
    "evidence_link_required": true,
    "delegates_to_existing_delivery_control_plane": true,
    "provider_may_become_deployment_authority": false
  },
  "hardware_portability": {
    "exact_host_sku_requirement_forbidden": true,
    "portable_web_asset_admission": true,
    "runtime_resource_budget_delegates_to_existing_governance": true
  },
  "mandatory_rules": [
    "OPENHERO_PROVIDER_NOT_AUTHORITY",
    "OPENHERO_CAPABILITY_AUTHORITY_COUNT_INVARIANT",
    "OPENHERO_IMMUTABLE_UPSTREAM_PIN_REQUIRED",
    "CODE_LICENSE_AND_MEDIA_RIGHTS_MUST_BE_SEPARATE",
    "PER_ASSET_MEDIA_RIGHTS_DECLARATION_REQUIRED",
    "REGISTRY_ONLY_ASSET_RESOLUTION_REQUIRED",
    "DIRECT_USER_PATH_TO_FILESYSTEM_FORBIDDEN",
    "PATH_TRAVERSAL_AND_ABSOLUTE_PATH_FORBIDDEN",
    "ARCHIVE_ENTRY_COUNT_AND_UNCOMPRESSED_SIZE_BOUNDED",
    "ARCHIVE_COMPRESSION_RATIO_BOUNDED",
    "MIME_AND_MAGIC_BYTE_VERIFICATION_REQUIRED",
    "HTML_ENTRYPOINT_REQUIRED",
    "UNEXPECTED_EXECUTABLE_FILE_TYPES_FORBIDDEN",
    "SCRIPT_ORIGIN_MUST_USE_STRUCTURED_URL_PARSING",
    "SCRIPT_ORIGIN_EXACT_ALLOWLIST_REQUIRED",
    "SUBSTRING_DOMAIN_MATCHING_FORBIDDEN",
    "INLINE_SCRIPT_POLICY_MUST_BE_EXPLICIT",
    "PREVIEW_MUST_USE_ISOLATED_ORIGIN",
    "PREVIEW_ALLOW_SCRIPTS_AND_SAME_ORIGIN_COMBINATION_FORBIDDEN",
    "CONTENT_SECURITY_POLICY_REQUIRED",
    "OUTBOUND_NETWORK_DEFAULT_DENY_REQUIRED",
    "DEPENDENCY_VERSION_AND_INTEGRITY_PIN_REQUIRED",
    "SBOM_REQUIRED",
    "SUPPLY_CHAIN_SCAN_PASS_REQUIRED",
    "RESOURCE_BUDGET_AND_PORTABLE_HARDWARE_REQUIRED",
    "ACCESSIBILITY_GATE_PASS_REQUIRED",
    "RESPONSIVE_LAYOUT_GATE_PASS_REQUIRED",
    "VISUAL_REGRESSION_GATE_PASS_REQUIRED",
    "PUBLICATION_MUST_BE_CONTENT_ADDRESSED_AND_IMMUTABLE",
    "ROLLBACK_TARGET_REQUIRED",
    "HUMAN_REVIEW_AND_EVIDENCE_REQUIRED",
    "REFERENCE_PASS_CANNOT_PROMOTE_CURRENT_HOST_RUNTIME"
  ]
}
