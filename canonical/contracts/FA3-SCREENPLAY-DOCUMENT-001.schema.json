{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-SCREENPLAY-DOCUMENT-001.schema.json",
  "title": "FA3 Story/Screenplay canonical document - deterministic foundation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "story_id", "branch_id", "revision", "profile", "title_lines", "scenes", "provenance"],
  "properties": {
    "schema": {"const": "fa3.screenplay-document.v1"},
    "story_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "profile": {"enum": ["FEATURE", "TV_MOVIE", "EPISODIC", "COMMERCIAL", "LIVE_BROADCAST", "OTHER"]},
    "title_lines": {"type": "array", "items": {"type": "string"}},
    "scenes": {"type": "array", "minItems": 1, "maxItems": 3000, "items": {"$ref": "#/$defs/scene"}},
    "provenance": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "styles"],
      "properties": {"text": {"type": "string"}, "styles": {"type": "array", "uniqueItems": true, "items": {"enum": ["Bold", "Italic", "Underline"]}}}
    },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {"enum": ["ACTION", "CHARACTER", "PARENTHETICAL", "DIALOGUE", "TRANSITION", "SHOT"]},
        "text": {"type": "string"},
        "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_id", "heading", "number", "elements"],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1},
        "number": {"type": ["string", "null"]},
        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}
      }
    }
  }
}
