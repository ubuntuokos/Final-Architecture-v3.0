{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fa3.local/contracts/FA3-VISUAL-STYLE-COMPILE-RECEIPT-001.schema.json",
  "x-fa3-contract-id": "FA3-VISUAL-STYLE-COMPILE-RECEIPT-001",
  "title": "FA3 Visual Style Compile Receipt",
  "type": "object",
  "required": [
    "schema",
    "style_recipe_id",
    "resolved_variables",
    "derived_prompt",
    "prompt_sha256",
    "canonical",
    "route_request",
    "current_host_runtime_promotion_claim"
  ],
  "properties": {
    "schema": {
      "const": "fa3.visual-style-compile-receipt.v1"
    },
    "style_recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "style_recipe_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "resolved_variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "derived_prompt": {
      "type": "string",
      "minLength": 1
    },
    "negative_prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical": {
      "const": false
    },
    "route_request": {
      "type": "object",
      "required": [
        "route_class",
        "authority",
        "resource_authority",
        "provider",
        "model",
        "runtime",
        "silent_fallback_allowed"
      ],
      "properties": {
        "route_class": {
          "const": "visual.generation"
        },
        "authority": {
          "const": "FA3-AUTH-MODEL-ROUTER-001"
        },
        "resource_authority": {
          "const": "FA3-AUTH-HOST-RESOURCE-BROKER-001"
        },
        "provider": {
          "type": "null"
        },
        "model": {
          "type": "null"
        },
        "runtime": {
          "type": "null"
        },
        "silent_fallback_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "current_host_runtime_promotion_claim": {
      "const": false
    }
  },
  "additionalProperties": false
}
