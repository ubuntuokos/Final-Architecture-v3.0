{
  "schema": "fa3.contract-set.v1",
  "id": "FA3-ANIMATION-PRODUCTION-CONTRACTS-001",
  "profile": "FA3-ANIMATION-PRODUCTION-001",
  "provider_neutral": true,
  "contracts": [
    "AnimationProductionIntent",
    "ScreenplayRevision",
    "SceneBeatPlan",
    "StoryboardPanel",
    "Animatic",
    "FilmShotGraphBinding",
    "CharacterAsset",
    "CharacterIdentityBinding",
    "EnvironmentAsset",
    "AnimationAsset",
    "AnimationScene",
    "AnimationTake",
    "FrameRange",
    "ImageSequence",
    "RenderLayer",
    "DialoguePerformance",
    "VoiceSynthesisBinding",
    "LipSyncRequest",
    "LipSyncResult",
    "LipSyncQualityReport",
    "MusicCue",
    "SoundEffectCue",
    "AudioMix",
    "EditorialTimelineBinding",
    "ColorPipelineDescriptor",
    "ReviewDecision",
    "PictureLock",
    "AudioLock",
    "DeliveryQualityReport",
    "AnimationProductionReceipt",
    "AnimationProductionProvenance"
  ],
  "required_stage_transition_fields": [
    "project_id",
    "shot_or_sequence_id",
    "source_artifact_ids",
    "source_content_hashes",
    "provider_id",
    "provider_version_or_digest",
    "operation_or_intent",
    "frame_rate_and_timebase",
    "color_space_and_alpha_mode",
    "audio_sample_rate_and_channel_layout",
    "result_artifact_id",
    "result_content_hash",
    "policy_and_license_decisions",
    "review_or_qc_evidence"
  ],
  "canonical_interchange": {
    "editorial": "OpenTimelineIO",
    "color_management": "OpenColorIO",
    "hdr_intermediate": "OpenEXR",
    "image_sequence_delivery": ["OpenEXR", "PNG"],
    "subtitle_sidecars": ["SRT", "VTT"],
    "lossless_audio_master": ["WAV", "FLAC"]
  },
  "provider_local_formats": {
    "bforartists_blender": [".blend"],
    "opentoonz": [".tnz", ".tlv", ".pli"],
    "krita": [".kra"],
    "kdenlive": [".kdenlive", "MLT XML"],
    "canonical_roots": false
  },
  "delegation": {
    "story_profile": "FA3-STORY-001",
    "generative_video_profile": "FA3-VIDEO-001",
    "voice_profile": "FA3-VOICE-001",
    "stt_profile": "FA3-STT-MEDIA-001",
    "music_profile": "FA3-MUSIC-001",
    "audio_separation_profile": "FA3-AUDIO-SEPARATION-001",
    "dcc_profile": "FA3-DCC-RT3D-001",
    "editorial_profile": "FA3-KDENLIVE-EDITORIAL-001",
    "resource_profile": "FA3-HOST-RESOURCE-BROKER-001"
  },
  "lipsync_contract": {
    "typed_intents": ["lipsync.generate", "lipsync.validate", "lipsync.regenerate"],
    "required_inputs": ["video_or_image_sequence_artifact", "dialogue_audio_artifact", "character_identity_binding", "frame_rate", "timebase", "consent_decision"],
    "required_outputs": ["synchronized_media_artifact", "av_sync_report", "identity_preservation_report", "artifact_hash_lineage"],
    "face_voice_performance_consent_required": true,
    "synthetic_media_disclosure_required": true,
    "direct_provider_call_as_canonical_boundary": false
  },
  "resource_contract": {
    "accelerator_execution_requires_hrb_lease": true,
    "accelerator_identity": ["device_uuid", "pci_bdf"],
    "runtime_gpu_index_is_identity": false,
    "display_gpu_implicit_compute_fallback": false,
    "vram_headroom_required": true,
    "heavy_job_concurrency_bounded": true,
    "oom_fallback_requires_explicit_policy": true,
    "cpu_thread_budget_profile": "FA3-CPU-NUMA-THREADING-001",
    "static_cpu_or_numa_ids_forbidden": true
  },
  "license_contract": {
    "dimensions": ["code", "runtime_dependencies", "model_weights", "training_datasets", "input_assets_and_likeness", "output_usage_rights"],
    "all_dimensions_must_pass_for_production": true,
    "noncommercial_component_cannot_satisfy_commercial_production": true,
    "upstream_readme_claim_is_reference_not_current_host_admission": true
  },
  "quality_gates": [
    "story_and_shot_continuity",
    "character_identity_consistency",
    "frame_integrity_and_missing_frame_policy",
    "lip_speech_sync",
    "face_identity_preservation",
    "dialogue_intelligibility_and_locale_quality",
    "audio_peak_loudness_phase_and_channel_layout",
    "caption_timing_and_readability",
    "color_transform_and_hdr_sdr_intent",
    "picture_lock_audio_lock_and_final_master_provenance"
  ]
}
