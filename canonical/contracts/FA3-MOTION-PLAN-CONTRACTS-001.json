        "project_revision",
        "timeline_revision",
        "timebase",
        "beats",
        "actors",
        "transitions",
        "camera_constraints",
        "motion_constraints",
        "continuity_constraints",
        "audio_cues",
        "quality_profile",
        "render_intent",
        "source_artifact_refs",
        "provenance",
        "digest"
      ]
    },
    "MotionPrimitive": {
      "allowed": [
        "PERSISTENT_ACTOR",
        "OBJECT_HANDOFF",
        "FOREGROUND_TRANSITION",
        "MATCHED_DIRECTION",
        "SELECTION_EXPANSION",
        "MATERIALIZE_RESULT",
