{
  "input_media": "/absolute/path/to/media.mkv",
  "output_dir": "/absolute/path/to/output/blackhole-whisper",
  "zone_start_seconds": 0,
  "zone_end_seconds": null,
  "preprocessing": "none",
  "language": "hu",
  "timeout_seconds": 7200,
  "stt_command": [
    "./bin/fa3-whisper-stt",
    "transcribe",
    "--request",
    "{request}",
    "--result",
    "{result}",
    "--model",
    "turbo",
    "--device",
    "cpu",
    "--model-cache",
    "/absolute/path/to/whisper-cache"
  ]
}
